# RumaLink Router Bootstrap Script - Generated by RumaLink Backend
# Paste this into RouterOS terminal (or import as .rsc file)
# This sets up: WireGuard tunnel, hotspot, RADIUS auth + accounting + CoA
#
# Variables to be replaced by the backend before delivery:
#   {{WG_PRIVATE_KEY}}, {{WG_SERVER_PUBLIC_KEY}}, {{WG_ENDPOINT}}, {{WG_CLIENT_IP}},
#   {{RADIUS_SECRET}}, {{HOTSPOT_NETWORK}}, {{ISP_NAME}}
#
# This script is IDEMPOTENT - safe to re-run

# ============ STEP 1: WireGuard tunnel ============
/interface/wireguard add name=wg-rumalink private-key="{{WG_PRIVATE_KEY}}" listen-port=51820 comment="RumaLink hub tunnel"
/interface/wireguard/peers add interface=wg-rumalink public-key="{{WG_SERVER_PUBLIC_KEY}}" endpoint-address={{WG_ENDPOINT}} endpoint-port=51820 allowed-address=10.8.0.0/24 persistent-keepalive=25s comment="RumaLink VPS hub"
/ip/address add interface=wg-rumalink address={{WG_CLIENT_IP}}/24 comment="RumaLink tunnel IP"

# ============ STEP 2: Hotspot setup ============
/ip/hotspot/profile add name=rl-hsprof hotspot-address={{HOTSPOT_NETWORK}}.1 dns-name=login.rumalink \
    html-directory=hotspot login-by=http-chap,http-pap http-cookie-lifetime=0s \
    use-radius=yes radius-accounting=yes radius-interim-update=2m \
    radius-mac-format=XX:XX:XX:XX:XX:XX nas-port-type=wireless-802.11

# ============ STEP 3: RADIUS server pointing to RumaLink VPS ============
/radius add address=10.8.0.1 secret="{{RADIUS_SECRET}}" service=hotspot,login \
    timeout=3s src-address={{WG_CLIENT_IP}} \
    authentication-port=1812 accounting-port=1813 comment=RumaLink-VPS

# ============ STEP 4: CoA-Disconnect (incoming RADIUS from VPS) ============
/radius/incoming set accept=yes port=3799

# ============ STEP 5: Walled garden for captive payment flow ============
/ip/hotspot/walled-garden add dst-host=*.rumalinkenterprise.online comment=RumaLink-captive
/ip/hotspot/walled-garden add dst-host=*.safaricom.co.ke comment=MPesa
/ip/hotspot/walled-garden add dst-host=*.daraja.io comment=Daraja-API

# ============ STEP 6: Firewall — allow tunnel and reject everything else from hotspot ============
/ip/firewall/filter add chain=forward in-interface=wg-rumalink action=accept comment=RumaLink-tunnel-in
/ip/firewall/filter add chain=forward out-interface=wg-rumalink action=accept comment=RumaLink-tunnel-out

# ============ STEP 7: Heartbeat / register with backend ============
# (optional — the backend's auto-discovery will pick this up via WireGuard handshake)
/system/scheduler add name=rl-heartbeat interval=30s on-event="/tool fetch url=\"https://rumalinkenterprise.online/api/provision/heartbeat/{{NAS_ID}}\" mode=https keep-result=no http-method=post http-data=\"{}\""

# Done. Verify with:
#   /radius print
#   /radius/incoming print
#   /ip/hotspot/profile print
