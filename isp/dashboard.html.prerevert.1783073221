<div class="toast-container" id="toasts"></div>

<script>
const API = 'https://rumalinkenterprise.online/api';
let token = localStorage.getItem('rl_token');
let isp = JSON.parse(localStorage.getItem('rl_isp') || '{}');

(function(){
  function showBanner(){
    try{
      var t=localStorage.getItem('rl_token')||''; var seg=t.split('.')[1]; if(!seg) return;
      var payload=JSON.parse(atob(seg.replace(/-/g,'+').replace(/_/g,'/')));
      if(!payload||!payload.imp) return;
      if(document.getElementById('rl-imp-bar')) return;
      var bar=document.createElement('div'); bar.id='rl-imp-bar';
      bar.style.cssText='position:fixed;top:0;left:0;right:0;z-index:99999;background:#b8860b;color:#fff;padding:8px 14px;font-size:.85rem;text-align:center;font-family:sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.25)';
      bar.innerHTML='\uD83D\uDD13 Admin view \u2014 you are viewing this ISP\u2019s dashboard as an administrator. <a href="#" id="rl-imp-exit" style="color:#fff;text-decoration:underline;margin-left:10px;font-weight:600">Exit</a>';
      document.body.appendChild(bar); document.body.style.paddingTop='40px';
      var ex=document.getElementById('rl-imp-exit');
      if(ex) ex.onclick=function(e){ e.preventDefault(); localStorage.removeItem('rl_token'); localStorage.removeItem('rl_isp'); localStorage.removeItem('rl_impersonating'); try{window.close();}catch(_){} window.location.href='/admin/dashboard.html'; };
    }catch(e){}
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', showBanner); else showBanner();
})();

let planType = 'both'; // 'hotspot' | 'pppoe' | 'both'
let revenueChart = null;
let vPage = 1, subPage = 1;
let selectedTemplate = 'classic';
let pollInterval = null;
let currentDeviceToken = null;

if (!token) window.location.href = '/isp/login.html';

// ── PORTAL TEMPLATES ──────────────────────────────────────────
const PORTAL_TEMPLATES = [
  { id: 'classic',  name: 'Classic',  icon: '🏛️',  bg: 'linear-gradient(135deg,#f0f4ff,#e8f0ff)', desc: 'Clean white card, professional' },
  { id: 'modern',   name: 'Modern',   icon: '🌙',  bg: 'linear-gradient(135deg,#0a0f1e,#132044)', desc: 'Dark theme, sleek & modern' },
  { id: 'minimal',  name: 'Minimal',  icon: '⬜',  bg: 'linear-gradient(135deg,#ffffff,#f3f4f6)', desc: 'Ultra-clean, distraction-free' },
  { id: 'branded',  name: 'Branded',  icon: '🎨',  bg: 'linear-gradient(135deg,#00d4aa,#0d1530)', desc: 'Split layout, brand-forward' },
];

const KENYA_SMS_GATEWAYS = {
  africastalking: { name: "Africa's Talking", needsUsername: true, needsPartnerId: false },
  bongasms:       { name: 'BongaSMS',          needsUsername: false, needsPartnerId: true },
  websms:         { name: 'WebSMS (Elitehost)', needsUsername: false, needsPartnerId: false },
  advanta:        { name: 'Advanta SMS',        needsUsername: false, needsPartnerId: false },
  sendsms:        { name: 'SendSMS Kenya',      needsUsername: false, needsPartnerId: false },
  wigal:          { name: 'Wigal SMS',          needsUsername: false, needsPartnerId: false },
  bulksms:        { name: 'BulkSMS Kenya',      needsUsername: false, needsPartnerId: false },
  mobitech:       { name: 'Mobitech Kenya',     needsUsername: false, needsPartnerId: false },
  cellfonie:      { name: 'Cellfonie',          needsUsername: false, needsPartnerId: false },
  sparrowsms:     { name: 'Sparrow SMS',        needsUsername: false, needsPartnerId: false },
  textmagic:      { name: 'TextMagic',          needsUsername: true,  needsPartnerId: false },
  talksasa:       { name: 'TalkSasa',           needsUsername: false, needsPartnerId: false },
  hubtel:         { name: 'Hubtel',             needsUsername: true,  needsPartnerId: false },
};

// ── INIT ──────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  applyPlanRestrictions();
  setupSidebar();
  setupNav();

async function loadSmsPurchases() {
  const tab = document.getElementById('sms-tab-purchases');
  try {
    // only show the Purchase History tab for RumaLink SMS users
    const bal = await _smsApiCall('/isp/sms/balance');
    if (!bal || !bal.is_rumalink_sms) { if (tab) tab.style.display='none'; return; }
    if (tab) tab.style.display='';
    const d = await _smsApiCall('/isp/sms/purchases');
    const s = (d && d.summary) || {};
    const setT = (id,v) => { const e=document.getElementById(id); if(e) e.textContent=v; };
    setT('smsp-balance', Number(d.balance||0).toLocaleString(undefined,{maximumFractionDigits:2}));
    setT('smsp-purchased', Number(s.total_purchased||0).toLocaleString());
    setT('smsp-spent', 'KES ' + Number(s.total_spent||0).toLocaleString(undefined,{minimumFractionDigits:2}));
    setT('smsp-consumed', Number(s.total_consumed||0).toLocaleString());
    const labelMap = { purchase:'Purchase', signup_bonus:'Welcome Bonus', consumption:'SMS Sent', admin_adjust:'Adjustment' };
    const badgeMap = { completed:'✓ Done', pending:'⏳ Pending', failed:'✗ Failed' };
    window._smsPurchData = d.transactions || [];
    window._smsPurchPage = 1;
    renderSmsPurchPage(1);
    return;
    var _unused = (d.transactions||[]).map(t => {
      const dt = new Date(t.created_at).toLocaleString('en-KE',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
      const cnt = Number(t.sms_count||0);
      const cntStr = (cnt>0?'+':'') + cnt.toFixed(2);
      const paid = (t.amount_paid!=null && Number(t.amount_paid)>0) ? ('KES '+Number(t.amount_paid).toLocaleString(undefined,{minimumFractionDigits:2})) : '—';
      const after = (t.isp_balance_after!=null) ? Number(t.isp_balance_after).toFixed(2) : '—';
      const stColor = t.status==='completed'?'#00d4aa':(t.status==='pending'?'#f39c12':'#e74c3c');
      return `<tr>
        <td>${dt}</td>
        <td>${labelMap[t.txn_type]||t.txn_type}</td>
        <td style="color:${cnt>0?'#00d4aa':'#e74c3c'}">${cntStr}</td>
        <td>${paid}</td>
        <td>${after}</td>
        <td style="color:${stColor}">${badgeMap[t.status]||t.status}</td>
      </tr>`;
    }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:22px">No SMS purchases yet</td></tr>';
  } catch (e) { if (section) section.style.display='none'; }
}
window.loadSmsPurchases = loadSmsPurchases;
function smsPurchGo(p){ renderSmsPurchPage(p); }
window.smsPurchGo = smsPurchGo;
function renderSmsPurchPage(page){
  window._smsPurchPage = page;
  const data = (window._smsPurchData || []).filter(t => t.txn_type === 'purchase');
  const start = (page-1)*SMS_PAGE_SIZE;
  const rows = data.slice(start, start+SMS_PAGE_SIZE);
  const labelMap = { purchase:'Purchase', signup_bonus:'Welcome Bonus', consumption:'SMS Sent', admin_adjust:'Adjustment' };
  const badgeMap = { completed:'✓ Done', pending:'⏳ Pending', failed:'✗ Failed' };
  const tbody = document.getElementById('sms-purchases-tbody');
  if (!tbody) return;
  tbody.innerHTML = rows.map(t => {
    const dt = new Date(t.created_at).toLocaleString('en-KE',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
    const cnt = Number(t.sms_count||0);
    const cntStr = (cnt>0?'+':'') + cnt.toFixed(2);
    const paid = (t.amount_paid!=null && Number(t.amount_paid)>0) ? ('KES '+Number(t.amount_paid).toLocaleString(undefined,{minimumFractionDigits:2})) : '—';
    const after = (t.isp_balance_after!=null) ? Number(t.isp_balance_after).toFixed(2) : '—';
    const stColor = t.status==='completed'?'#00d4aa':(t.status==='pending'?'#f39c12':'#e74c3c');
    return `<tr>
      <td>${dt}</td><td>${labelMap[t.txn_type]||t.txn_type}</td>
      <td style="color:${cnt>0?'#00d4aa':'#e74c3c'}">${cntStr}</td>
      <td>${paid}</td><td>${after}</td>
      <td style="color:${stColor}">${badgeMap[t.status]||t.status}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:22px">No SMS purchases yet</td></tr>';
  renderPager('sms-purch-pager', data.length, page, 'smsPurchGo');
}
window.renderSmsPurchPage = renderSmsPurchPage;
async function _smsApiCall(path, opts) {
  opts = opts || {};
  const tok = (typeof token !== 'undefined' && token) ? token : (localStorage.getItem('token') || localStorage.getItem('isp_token') || '');
  const res = await fetch('/api' + path, {
    method: opts.method || 'GET',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tok },
    body: opts.body || undefined
  });
  if (res.status === 401) { try { logout(); } catch(e){} return null; }
  const j = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(j.error || 'Request failed');
  return j;
}
async function refreshSmsCard() {
  try {
    const d = await _smsApiCall('/isp/sms/balance');
    window._smsPrice = (d && d.price_per_sms != null) ? parseFloat(d.price_per_sms) : 0.50;
    const card = document.getElementById('sms-balance-card');
    if (d && d.is_rumalink_sms) {
      if (card) card.style.display = 'flex';
      const bal = document.getElementById('ds-sms-balance');
      if (bal) bal.textContent = Number(d.balance||0).toLocaleString(undefined,{maximumFractionDigits:2});
    } else { if (card) card.style.display = 'none'; }
    const pe = document.getElementById('sms-topup-price'); if (pe) pe.textContent = (window._smsPrice||0.50);
  } catch (e) {}
}
function openSmsTopup() {
  document.getElementById('sms-topup-form').style.display='';
  document.getElementById('sms-topup-wait').style.display='none';
  document.getElementById('sms-topup-done').style.display='none';
  document.getElementById('sms-topup-amount').value='';
  document.getElementById('sms-topup-count').textContent='0.00 SMS';
  document.getElementById('sms-topup-overlay').classList.add('open');
}
function closeSmsTopup(refresh) {
  document.getElementById('sms-topup-overlay').classList.remove('open');
  if (window._smsTopupPoll) { clearInterval(window._smsTopupPoll); window._smsTopupPoll=null; }
  if (refresh) refreshSmsCard();
}
function calcSmsTopup() {
  const amt = parseFloat(document.getElementById('sms-topup-amount').value) || 0;
  const price = window._smsPrice || 0.50;
  const count = price > 0 ? (amt / price) : 0;
  document.getElementById('sms-topup-count').textContent = count.toFixed(2) + ' SMS';
}
async function paySmsTopup() {
  const phone = document.getElementById('sms-topup-phone').value.trim();
  const amount = document.getElementById('sms-topup-amount').value;
  if (!phone) { toast('Enter your M-Pesa phone number', false); return; }
  if (!amount || parseFloat(amount) < 1) { toast('Enter a valid amount', false); return; }
  const btn = document.getElementById('sms-topup-pay'); btn.disabled=true; btn.textContent='Sending...';
  try {
    const d = await _smsApiCall('/isp/sms/topup', { method:'POST', body: JSON.stringify({ phone: phone, amount: amount }) });
    if (d && d.success) {
      document.getElementById('sms-topup-form').style.display='none';
      document.getElementById('sms-topup-wait').style.display='';
      pollSmsTopup(d.payment_id);
    } else { toast((d && d.error) || 'Could not start payment', false); }
  } catch (e) { toast(e.message || 'Payment error', false); }
  finally { btn.disabled=false; btn.textContent='Pay'; }
}
function pollSmsTopup(paymentId) {
  let tries = 0;
  if (window._smsTopupPoll) clearInterval(window._smsTopupPoll);
  window._smsTopupPoll = setInterval(async () => {
    tries++;
    try {
      const s = await _smsApiCall('/isp/sms/topup/status/' + paymentId);
      if (s && s.status === 'paid') {
        clearInterval(window._smsTopupPoll); window._smsTopupPoll=null;
        document.getElementById('sms-topup-wait').style.display='none';
        document.getElementById('sms-topup-done').style.display='';
        document.getElementById('sms-topup-done-text').textContent = (s.sms_count!=null? (Number(s.sms_count).toFixed(2)+' SMS added. ') : '') + (s.isp_balance_after!=null? ('New balance: '+Number(s.isp_balance_after).toFixed(2)+' SMS.') : '');
        refreshSmsCard();
      } else if (s && s.status === 'failed') {
        clearInterval(window._smsTopupPoll); window._smsTopupPoll=null;
        document.getElementById('sms-topup-wait-title').textContent='Payment not completed';
        document.getElementById('sms-topup-wait-text').textContent='You can close and try again.';
      }
    } catch (e) {}
    if (tries >= 40) { clearInterval(window._smsTopupPoll); window._smsTopupPoll=null;
      document.getElementById('sms-topup-wait-text').textContent='Still confirming... your balance will update shortly.'; }
  }, 3000);
}
window.refreshSmsCard = refreshSmsCard;
window.openSmsTopup = openSmsTopup;
window.closeSmsTopup = closeSmsTopup;
window.calcSmsTopup = calcSmsTopup;
window.paySmsTopup = paySmsTopup;
window.pollSmsTopup = pollSmsTopup;
  loadDashboard();
  refreshSmsCard();
  document.getElementById('sms-msg').addEventListener('input', e => {
    document.getElementById('sms-count').textContent = e.target.value.length;
  });
});

function applyPlanRestrictions() {
  planType = isp.plan_type || 'hotspot';
  document.body.classList.remove('plan-hotspot','plan-pppoe','plan-both');
  if (planType === 'hotspot') document.body.classList.add('plan-hotspot');
  else if (planType === 'pppoe') document.body.classList.add('plan-pppoe');
  // 'both' shows everything, no class needed
}

function setupSidebar() {
  document.getElementById('sb-isp-name').textContent = isp.company_name || 'ISP';
  const planLabels = { hotspot:'Hotspot Plan', pppoe:'PPPoE Plan', both:'Hotspot + PPPoE' };
  document.getElementById('sb-isp-plan').textContent = planLabels[isp.plan_type] || isp.plan_type || '—';
  document.getElementById('avatar-initial').textContent = (isp.company_name || 'I')[0].toUpperCase();
  loadWallet();
}

function setupNav() {
  document.querySelectorAll('.nav-item[data-page]').forEach(el => el.addEventListener('click', () => showPage(el.dataset.page)));
}


// ── Full-screen License Expired overlay (Phase 5 Step 2) ──
async function showLicenseExpiredOverlay(e){
  let amount = (e && e.amount!=null) ? Number(e.amount) : null;
  try{
    const d = await api('/isp/billing');
    _licenseState = d;
    if(amount==null && d && d.owed) amount = Number(d.owed.total);
  }catch(_){}
  const ov = document.getElementById('license-expired-overlay');
  if(!ov) return;
  const amt = document.getElementById('lexp-amount');
  if(amt) amt.textContent = 'KES ' + (amount!=null ? amount.toFixed(2) : '\u2014');
  ov.style.display = 'flex';
}
function hideLicenseExpiredOverlay(){
  const ov = document.getElementById('license-expired-overlay');
  if(ov) ov.style.display='none';
}

/* RUMALINK_USER_INPAGE: open a user profile inside the dashboard shell */
function showUserInDashboard(identifier, source){
  try{
    var frame = document.getElementById('user-detail-frame');
    var ispId = (function(){ try{ var q=new URLSearchParams(location.search); return q.get('ispId')||''; }catch(e){ return ''; } })();
    var url = 'user.html?identifier=' + encodeURIComponent(identifier) + '&source=' + encodeURIComponent(source||'');
    url += '&embedded=1'; /* RUMALINK_EMBED_CLEAN */
    if (ispId) url += '&ispId=' + encodeURIComponent(ispId);
    if (frame) frame.src = url;
    if (typeof showPage === 'function') showPage('user-detail');
  }catch(e){ console.error('showUserInDashboard:', e); }
}
function backFromUserDetail(){
  try{
    var frame = document.getElementById('user-detail-frame');
    if (frame) frame.src = 'about:blank';
    // Return to the sessions view by default (closest to where users are clicked).
    if (typeof showPage === 'function') showPage('active-sessions');
  }catch(e){}
}
function showPage(id) {
  // Hide ALL pages with inline style (nuclear approach - beats any CSS)
  document.querySelectorAll('.page').forEach(p => {
    p.style.display = 'none';
    p.classList.remove('active');
  });
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  // Show only the selected page
  const target = document.getElementById('page-' + id);
  if (target) {
    target.style.display = 'block';
    target.classList.add('active');
  }
  document.querySelector(`.nav-item[data-page="${id}"]`)?.classList.add('active');
  const titles = {
    dashboard:'Dashboard', devices:'MikroTik / NAS Devices',
    vouchers:'Hotspot Vouchers', 'hs-packages':'Hotspot Packages', 'hs-sessions':'Hotspot Sessions',
    subscribers:'PPPoE Subscribers', 'pppoe-packages':'PPPoE Packages', 'pppoe-sessions':'PPPoE Sessions',
    billing:'Billing & License', payments:'Payments', invoices:'Invoices', sms:'Send SMS',
    notifications:'Notifications', support:'Support', settings:'Settings'
  };
  document.getElementById('page-title').textContent = titles[id] || id;
  const loaders = {
    dashboard: loadDashboard, devices: loadDevices,
    vouchers: () => { loadVouchers(); loadVoucherStats(); },
    'hs-packages': loadHSPackages, 'hs-sessions': loadHSSessions,
    subscribers: loadSubscribers, 'pppoe-packages': loadPPPoEPackages,
    'pppoe-sessions': loadPPPoESessions, billing: loadBilling, payments: loadPayments,
    notifications: loadNotifications, support: loadTickets,
    settings: loadSettings, sms: () => { loadSMSLog(); loadSmsPurchases(); }
  };
  if (loaders[id]) loaders[id]();
}

// ── License banner + Billing page (Phase 4) ──
let _licenseState = null;
function _armLicenseWatch(expiresAt){
  if(window._licenseWatch){ clearInterval(window._licenseWatch); window._licenseWatch=null; }
  if(window._licenseWatchTO){ clearTimeout(window._licenseWatchTO); window._licenseWatchTO=null; }
  if(!expiresAt) return;
  const exp = new Date(expiresAt).getTime();
  if(isNaN(exp)) return;
  const fire=function(){ showLicenseExpiredOverlay({}); };
  // Poll every 20s in case the clock passes while the tab sits open.
  window._licenseWatch = setInterval(function(){ if(Date.now() >= exp){ fire(); } }, 20000);
  // Also fire exactly at the expiry instant if it's in the near future.
  const ms = exp - Date.now();
  if(ms > 0 && ms < 86400000){ window._licenseWatchTO = setTimeout(fire, ms + 500); }
  else if(ms <= 0){ fire(); }
}
async function loadLicenseBanner(){
  try{
    const d = await api('/isp/billing');
    _licenseState = d;
    var _ov=document.getElementById('license-expired-overlay'); if(_ov && d && !d.expired) _ov.style.display='none';
    const host = document.getElementById('license-banner-host');
    _armLicenseWatch(d.license_expires_at);
    if(!host) return;
    const days = (d.days_left==null) ? null : d.days_left;
    const owed = (d.owed && d.owed.total) ? Number(d.owed.total) : 0;
    const show = d.expired || (days!=null && days<=5);
    if(!show){ host.innerHTML=''; return; }
    const exp = d.license_expires_at ? new Date(d.license_expires_at) : null;
    const expStr = exp ? exp.toLocaleString('en-KE',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '';
    let msg;
    if(d.expired){ msg = '\u26A0\uFE0F Your license has EXPIRED ('+expStr+'). Pay KES '+owed.toFixed(2)+' now to restore access.'; }
    else { msg = '\u26A0\uFE0F Your license expires in '+days+' day'+(days===1?'':'s')+' \u2014 '+expStr+'. Amount due: KES '+owed.toFixed(2)+'. Click to pay.'; }
    host.innerHTML = '<div id="lic-banner-click" style="cursor:pointer;background:linear-gradient(90deg,#c0392b,#e74c3c);color:#fff;padding:11px 16px;border-radius:10px;margin-bottom:16px;font-size:.88rem;font-weight:600;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 10px rgba(231,76,60,.3)"><span>'+msg+'</span><span style="background:rgba(255,255,255,.2);padding:5px 12px;border-radius:8px;white-space:nowrap;margin-left:12px">Pay Now \u2192</span></div>';
    const el = document.getElementById('lic-banner-click');
    if(el) el.onclick = function(){ showPage('billing'); };
  }catch(e){}
}

async function loadBilling(){
  const wrap = document.getElementById('billing-body');
  if(!wrap) return;
  wrap.innerHTML = '<div class="loading"><div class="spinner"></div>Loading…</div>';
  try{
    const d = await api('/isp/billing');
    _licenseState = d;
    const o = d.owed || {};
    const exp = d.license_expires_at ? new Date(d.license_expires_at) : null;
    const expStr = exp ? exp.toLocaleString('en-KE',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
    const statusColor = d.expired ? '#e74c3c' : (d.days_left!=null && d.days_left<=5 ? '#f39c12' : '#00d4aa');
    const statusText = d.expired ? 'EXPIRED' : (d.license_status==='trial' ? 'Trial' : 'Active');
    const total = Number(o.total||0);
    const hist = (d.history||[]).map(h=>'<tr><td>'+new Date(h.created_at).toLocaleString('en-KE',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'})+'</td><td>'+(h.description||'—')+'</td><td>KES '+Number(h.amount||0).toFixed(2)+'</td><td><span style="color:'+(h.status==='paid'?'#00d4aa':h.status==='failed'?'#e74c3c':'#f39c12')+';font-weight:600">'+h.status+'</span></td></tr>').join('') || '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:16px">No platform payments yet</td></tr>';

    wrap.innerHTML =
      '<div class="grid-2" style="gap:16px;margin-bottom:18px">'+
        '<div class="panel"><div class="panel-body">'+
          '<div style="font-size:.78rem;color:var(--muted)">License Status</div>'+
          '<div style="font-size:1.3rem;font-weight:700;color:'+statusColor+'">'+statusText+'</div>'+
          '<div style="font-size:.82rem;color:var(--muted);margin-top:6px">Expires: <strong style="color:var(--white)">'+expStr+'</strong></div>'+
          (d.days_left!=null && !d.expired ? '<div style="font-size:.82rem;color:var(--muted)">'+d.days_left+' day(s) left</div>' : '')+
        '</div></div>'+
        '<div class="panel"><div class="panel-body">'+
          '<div style="font-size:.78rem;color:var(--muted)">Amount Due Now</div>'+
          '<div style="font-size:1.6rem;font-weight:800;color:var(--teal)">KES '+total.toFixed(2)+'</div>'+
          '<button class="btn btn-amber" style="margin-top:10px;width:100%" onclick="openPayNow()" '+(total<=0?'disabled':'')+'>\uD83D\uDCB3 Pay Now</button>'+
        '</div></div>'+
      '</div>'+
      '<div class="panel" style="margin-bottom:18px"><div class="panel-head"><h3>Current Invoice Breakdown</h3></div><div class="panel-body">'+
        '<table class="tbl" style="width:100%"><tbody>'+
          '<tr><td>Hotspot revenue this cycle</td><td style="text-align:right">KES '+Number(o.hotspot_revenue||0).toFixed(2)+'</td></tr>'+
          '<tr><td>Hotspot platform fee ('+(((o.hotspot_rate!=null?o.hotspot_rate:0))*100).toFixed(1).replace(/\.0$/,'')+'%)</td><td style="text-align:right">KES '+Number(o.hotspot_fee||0).toFixed(2)+'</td></tr>'+
          '<tr><td>PPPoE users this cycle ('+(o.pppoe_users||0)+' \u00D7 KES '+Number(o.amount_per_user||0).toFixed(2)+')</td><td style="text-align:right">KES '+Number(o.pppoe_fee||0).toFixed(2)+'</td></tr>'+
          '<tr style="border-top:2px solid var(--border);font-weight:800"><td>Total</td><td style="text-align:right;color:var(--teal)">KES '+total.toFixed(2)+'</td></tr>'+
        '</tbody></table>'+
        '<div style="font-size:.76rem;color:var(--muted);margin-top:10px">Cycle since '+(d.billing_window_start?new Date(d.billing_window_start).toLocaleDateString('en-KE',{day:'2-digit',month:'short',year:'numeric'}):'—')+'. Paying does not change your fixed expiry date; the next cycle starts when you pay.</div>'+
      '</div></div>'+
      '<div class="panel"><div class="panel-head"><h3>Payment History</h3></div><div class="panel-body" style="padding:0"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Status</th></tr></thead><tbody>'+hist+'</tbody></table></div></div></div>';
  }catch(e){ wrap.innerHTML='<p style="color:var(--red)">Failed to load billing</p>'; }
}

// ── License Pay modal + status-poll fallback (Phase 4 UX) ──
let _lpayPoll = null, _lpayTries = 0;
async function openPayNow(){
  // Always refresh the owed amount first so the first click works even from the lock overlay.
  let total = Number((_licenseState && _licenseState.owed && _licenseState.owed.total) || 0);
  try{ const d = await api('/isp/billing'); _licenseState = d; if(d && d.owed) total = Number(d.owed.total||0); }catch(_){}
  if(total<=0){ toast('Nothing is due right now','error'); return; }
  _lpayClearPoll();
  document.getElementById('lpay-amount').value = 'KES ' + total.toFixed(2);
  document.getElementById('lpay-phone').value = '';
  document.getElementById('lpay-form').style.display = '';
  document.getElementById('lpay-waiting').style.display = 'none';
  document.getElementById('lpay-result').style.display = 'none';
  document.getElementById('lpay-sub').textContent = 'Enter the M-Pesa number to receive the STK prompt.';
  const b = document.getElementById('lpay-btn'); if(b){ b.disabled=false; b.textContent='Send M-Pesa Prompt'; }
  openModal('modal-license-pay');
}

function _lpayClearPoll(){ if(_lpayPoll){ clearInterval(_lpayPoll); _lpayPoll=null; } _lpayTries=0; }

async function submitLicensePay(){
  const phone = (document.getElementById('lpay-phone').value||'').trim();
  if(!phone){ toast('Enter the M-Pesa phone number','error'); return; }
  const btn = document.getElementById('lpay-btn'); if(btn){ btn.disabled=true; btn.textContent='Sending…'; }
  try{
    const d = await api('/isp/billing/pay',{method:'POST',body:JSON.stringify({phone})});
    if(!d || !d.success){ toast((d&&d.error)||'Could not start payment','error'); if(btn){btn.disabled=false;btn.textContent='Send M-Pesa Prompt';} return; }
    document.getElementById('lpay-form').style.display='none';
    document.getElementById('lpay-waiting').style.display='';
    _lpayPollStatus(d.payment_id);
  }catch(e){ toast(e.message||'Payment failed','error'); if(btn){btn.disabled=false;btn.textContent='Send M-Pesa Prompt';} }
}

function _lpayPollStatus(paymentId){
  _lpayClearPoll();
  const maxTries = 16; // ~40s; /public-status self-heals via Safaricom stkpushquery
  _lpayPoll = setInterval(async ()=>{
    _lpayTries++;
    try{
      const s = await api('/payments/public-status/'+paymentId);
      if(s && s.status === 'paid'){
        _lpayClearPoll();
        _lpayPaymentSucceeded();
        return;
      }
      if(s && s.status === 'failed'){
        _lpayClearPoll();
        _lpayShowResult(false, (s.failure_reason||'Payment failed or was cancelled.'));
        return;
      }
    }catch(e){}
    if(_lpayTries >= maxTries){
      _lpayClearPoll();
      document.getElementById('lpay-wait-msg').innerHTML = 'Still confirming\u2026 If you completed the payment it will reflect automatically.<br><button class="btn btn-outline btn-sm" style="margin-top:10px" onclick="_lpayRecheck(\''+paymentId+'\')">Check again</button>';
    }
  }, 2500);
}

async function _lpayRecheck(paymentId){
  try{ const s = await api('/payments/public-status/'+paymentId); if(s && s.status==='paid'){ _lpayPaymentSucceeded(); return; } }catch(e){}
  toast('Not confirmed yet — please wait a moment','error');
}

function _lpayPaymentSucceeded(){
  _lpayShowResult(true, 'License renewed \u2713 Your access is restored.');
  hideLicenseExpiredOverlay();
  try{ loadBilling(); }catch(e){}
  try{ loadLicenseBanner(); }catch(e){}
  // Auto-close the modal and refresh the dashboard so access returns without a manual reload.
  setTimeout(function(){
    closeModal('modal-license-pay');
    try{ loadDashboard(); }catch(e){}
  }, 1800);
}

function _lpayShowResult(ok, msg){
  document.getElementById('lpay-waiting').style.display='none';
  const r = document.getElementById('lpay-result');
  r.style.display='';
  r.innerHTML = '<div style="font-size:2rem">'+(ok?'\u2705':'\u26A0\uFE0F')+'</div>'+
    '<div style="margin:10px 0;color:'+(ok?'var(--teal)':'var(--amber)')+';font-weight:600">'+msg+'</div>'+
    '<button class="btn '+(ok?'btn-teal':'btn-outline')+'" onclick="closeModal(\'modal-license-pay\')">Done</button>';
}


// ── API ────────────────────────────────────────────────────────
async function api(path, opts = {}) {
  const res = await fetch(API + path, {
    ...opts,
    headers: { 'Content-Type':'application/json', 'Authorization':'Bearer '+token, ...(opts.headers||{}) }
  });
  if (res.status === 401) { logout(); return; }
  if (res.status === 402) { try{ const _e=await res.json(); if(_e && (_e.code==='LICENSE_EXPIRED'||_e.error==='LICENSE_EXPIRED')){ showLicenseExpiredOverlay(_e); } }catch(_){ showLicenseExpiredOverlay({}); } throw new Error('LICENSE_EXPIRED'); }
  const j = await res.json();
  if (!res.ok) throw new Error(j.error || 'API error');
  return j;
}

// ── FORMAT ─────────────────────────────────────────────────────
const kes = v => `KES ${parseFloat(v||0).toLocaleString('en-KE',{minimumFractionDigits:2})}`;
const dt  = v => v ? new Date(v).toLocaleDateString('en-KE') : '—';
const dts = v => v ? new Date(v).toLocaleString('en-KE',{hour:'2-digit',minute:'2-digit',month:'short',day:'numeric'}) : '—';
const byt = b => b>1073741824?(b/1073741824).toFixed(1)+' GB':b>1048576?(b/1048576).toFixed(1)+' MB':(b/1024).toFixed(0)+' KB';
const dur = s => { if(!s)return'—';const h=Math.floor(s/3600),m=Math.floor((s%3600)/60);return h>0?`${h}h ${m}m`:`${m}m`; };

// ── TOAST ──────────────────────────────────────────────────────
function toast(msg, type='success') {
  const t=document.createElement('div');t.className=`toast ${type}`;
  t.innerHTML=`<span>${type==='success'?'✅':'❌'}</span><span>${msg}</span>`;
  document.getElementById('toasts').appendChild(t);
  setTimeout(()=>t.remove(),4000);
}

// ── MODALS ─────────────────────────────────────────────────────
function closeModal(id){document.getElementById(id).classList.remove('open')}
function openModal(id){document.getElementById(id).classList.add('open')}
document.querySelectorAll('.modal-overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)o.classList.remove('open')}));

// ── LOGOUT ─────────────────────────────────────────────────────
function logout(){localStorage.clear();window.location.href='/isp/login.html'}

// ── WALLET ─────────────────────────────────────────────────────
async function loadWallet(){
  try{ const d=await api('/isp/profile'); document.getElementById('sb-wallet').textContent=kes(d.profile?.wallet_balance); }catch(e){}
}

// ── DASHBOARD ──────────────────────────────────────────────────
async function loadDashboard(){
  loadLicenseBanner();
  try{
    /* RUMALINK_USAGE_CACHEFIX: bypass 304 cache so the usage field always arrives */
    const d=await (async()=>{
      const _t=(localStorage.getItem('rl_token')||localStorage.getItem('token')||'');
      const _r=await fetch((window.API||'/api')+'/isp/stats?_='+Date.now(),{
        cache:'no-store',
        headers:{'Authorization':'Bearer '+_t,'Cache-Control':'no-cache'}
      });
      return _r.json();
    })();
    document.getElementById('ds-today').textContent=kes(d.revenue?.today);
    document.getElementById('ds-month').textContent=kes(d.revenue?.this_month);
    document.getElementById('ds-sessions').textContent=(parseInt(d.sessions?.active_hotspot)||0)+(parseInt(d.sessions?.active_pppoe)||0);
    document.getElementById('ds-subs').textContent=d.pppoe?.active||0;
    document.getElementById('ds-vouchers').textContent=d.hotspot?.unused_vouchers||0;
    document.getElementById('ds-devices').textContent=`${d.devices?.online||0}/${d.devices?.total||0}`;
    /* RUMALINK_USAGE_CARD: fill total + per-mikrotik breakdown */
    (function(){
      // Self-contained helpers (no reliance on other functions in this file).
      function _rlFmtBytes(b){
        b = Number(b)||0;
        if (b <= 0) return '0 B';
        if (b < 1024) return b + ' B';
        var u = ['KB','MB','GB','TB','PB'], i = -1;
        do { b /= 1024; i++; } while (b >= 1024 && i < u.length-1);
        return (b >= 100 ? b.toFixed(0) : b.toFixed(b >= 10 ? 1 : 2)) + ' ' + u[i];
      }
      function _rlEsc(x){
        return String(x==null?'':x).replace(/[&<>"']/g,function(c){
          return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
      }
      var u = (d && d.usage) ? d.usage : {total_bytes:0, device_count:0, devices:[]};
      var el = document.getElementById('ds-data-today');
      if (el) el.textContent = _rlFmtBytes(u.total_bytes);
      var sub = document.getElementById('ds-data-sub');
      var panel = document.getElementById('usage-breakdown');
      var rows = document.getElementById('usage-breakdown-rows');
      if (panel && rows && (u.device_count||0) > 1) {
        panel.style.display = '';
        if (sub) sub.textContent = u.device_count + ' MikroTiks';
        rows.innerHTML = (u.devices||[]).map(function(dev){
          var dot = dev.is_online
            ? '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 3px rgba(0,212,170,.15)"></span>'
            : '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#6b7280"></span>';
          return '<div class="stat-card">'
            + '<div class="sc-label">' + dot + ' ' + _rlEsc(dev.name)
            + ' <span class="sc-sub" style="float:right">' + (dev.sessions||0) + ' sess</span></div>'
            + '<div class="sc-val teal">' + _rlFmtBytes(dev.bytes) + '</div>'
            + '<div class="sc-sub">' + (dev.is_online ? 'Online' : 'Offline') + ' \u00b7 today</div>'
            + '</div>';
        }).join('');
      } else if (panel) {
        panel.style.display = 'none';
        if (sub) sub.textContent = 'Hotspot + PPPoE';
      }
    })();
    document.getElementById('sb-wallet').textContent=kes(d.wallet_balance);
  }catch(e){}
  try{
    const d=await api('/isp/revenue-chart?monthly=1');
    renderChart(d.data||[]);
    try{var _iry=document.getElementById('isp-rev-year'); if(_iry)_iry.textContent=d.year||new Date().getFullYear();}catch(e){}
  }catch(e){}
  // v62.75: Load Expiring Soon (PPPoE) + PPPoE Online tables
  try{
    const dl = await api('/isp/dashboard-lists');
    
    // Expiring Soon table
    const expTbody = document.getElementById('dash-expiring');
    if (expTbody) {
      const rows = dl.expiring_pppoe || [];
      document.getElementById('exp-count').textContent = rows.length;
      expTbody.innerHTML = rows.length === 0
        ? '<tr><td colspan="3" style="text-align:center;color:var(--muted);padding:16px">No subscribers expiring soon</td></tr>'
        : rows.map(r => `<tr style="cursor:pointer" onclick="showUserInDashboard('${(r.phone||r.username)}','pppoe')">
            <td class="name">${r.full_name || r.username}<div style="font-size:.78rem;color:var(--muted);font-family:monospace">${r.username}</div></td>
            <td>${r.package_name || '—'}</td>
            <td><span class="badge ${r.expiry_state === 'expired' ? 'br' : 'ba'}">${r.expiry_state === 'expired' ? 'Expired ' + (r.next_billing_date ? new Date(r.next_billing_date).toLocaleDateString('en-KE',{month:'short',day:'numeric'}) : '') : 'Due ' + (r.next_billing_date ? new Date(r.next_billing_date).toLocaleDateString('en-KE',{month:'short',day:'numeric'}) : '')}</span></td>
          </tr>`).join('');
    }
    
    // PPPoE Online table  
    const onTbody = document.getElementById('dash-pppoe-sess');
    if (onTbody) {
      const rows = dl.pppoe_online || [];
      document.getElementById('pppoe-sess-count').textContent = rows.length;
      onTbody.innerHTML = rows.length === 0
        ? '<tr><td colspan="3" style="text-align:center;color:var(--muted);padding:16px">No active PPPoE sessions</td></tr>'
        : rows.map(r => {
            const upSec = r.acctstarttime ? Math.floor((Date.now() - new Date(r.acctstarttime).getTime()) / 1000) : 0;
            const h = Math.floor(upSec/3600), m = Math.floor((upSec%3600)/60);
            const dur = h > 0 ? `${h}h ${m}m` : `${m}m`;
            const badge = r.is_test ? ' <span style="background:rgba(243,156,18,.2);color:#f39c12;padding:1px 6px;border-radius:4px;font-size:.7rem;font-weight:600">🧪 TEST</span>' : '';
            return `<tr style="cursor:pointer" onclick="showUserInDashboard('${(r.phone||r.username)}','pppoe')">
              <td class="name">${r.username}${badge}<div style="font-size:.78rem;color:var(--muted)">${r.full_name || ''}</div></td>
              <td style="font-family:monospace">${r.ip || '—'}</td>
              <td>${dur}</td>
            </tr>`;
          }).join('');
    }
  }catch(e){ console.warn('dashboard-lists:', e.message); }
  
  try{
    const d=await api('/payments?limit=6');
    document.getElementById('dash-payments').innerHTML=(d.payments||[]).map(p=>`
      <tr><td class="name">${p.subscriber_name||p.voucher_code||'—'}</td>
      <td style="color:var(--teal);font-weight:600">${kes(p.amount)}</td>
      <td><span class="badge bg">${p.payment_method}</span></td>
      <td>${dts(p.created_at)}</td></tr>`).join('')||'<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:16px">No payments yet</td></tr>';
  }catch(e){}
}

function renderChart(data){
  const ctx=document.getElementById('revenue-chart').getContext('2d');
  if(revenueChart)revenueChart.destroy();
  revenueChart=new Chart(ctx,{type:'bar',data:{labels:data.map(d=>d.label?d.label:new Date(d.date).toLocaleDateString('en-KE',{month:'short',day:'numeric'})),datasets:[{label:'Revenue (KES)',data:data.map(d=>parseFloat(d.amount||0)),backgroundColor:'rgba(0,212,170,.18)',borderColor:'#00d4aa',borderWidth:1.5,borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#8899bb',font:{size:10}}},y:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#8899bb',font:{size:10},callback:v=>'KES '+v.toLocaleString()}}}}});
}

// ── DEVICES ────────────────────────────────────────────────────
async function loadDevices(){
  const grid=document.getElementById('device-grid');
  grid.innerHTML='<div class="loading"><div class="spinner"></div>Loading…</div>';
  try{
    const d=await api('/nas/');
    if(!d.devices?.length){grid.innerHTML='<div style="color:var(--muted);padding:24px;font-size:.88rem">No devices yet. Add your first MikroTik router.</div>';return;}
    grid.innerHTML=d.devices.map(dev=>`
      <div class="device-card ${dev.is_online?'online':''}" data-device-id="${dev.id}" style="cursor:pointer" onclick="if(!event.target.closest('button')){location.href='device.html?id='+encodeURIComponent('${dev.id}')}">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <div style="font-family:var(--font-head);font-weight:700;font-size:.95rem">${dev.name}</div>
          <div style="display:flex;align-items:center;gap:6px">
            <div class="status-dot ${dev.is_online?'sd-green':dev.is_provisioned?'sd-red':'sd-amber'}"></div>
            <span style="font-size:.76rem;color:var(--muted)">${dev.is_online?'Online':dev.is_provisioned?'Offline':'Pending'}</span>
          </div>
        </div>
        <div style="font-size:.8rem;color:var(--muted);line-height:1.9">
          ${dev.mikrotik_identity?`📛 ${dev.mikrotik_identity}<br>`:''}
          ${dev.wan_ip?`🌐 ${dev.wan_ip}<br>`:''}
          ${dev.mikrotik_board?`🖥️ ${dev.mikrotik_board}<br>`:''}
          ${dev.last_seen?`🕐 ${dts(dev.last_seen)}`:''}
        </div>
        ${!dev.is_provisioned?`
          <div style="margin-top:12px;background:rgba(243,156,18,.06);border:1px solid rgba(243,156,18,.15);border-radius:8px;padding:10px">
            <div style="font-size:.76rem;color:var(--amber);font-weight:600;margin-bottom:5px">⚠️ Not provisioned yet</div>
            <div class="code-box" style="font-size:.71rem;padding:8px 10px;margin:6px 0">${dev.provision_url?`/tool fetch url="${dev.provision_url}" http-method=post http-data="identity=[/system identity get name]&version=[/system package get routeros version]&board=[/system resource get board-name]" output=user as-value`:'—'}<button class="copy-btn" onclick="copyText('${dev.provision_url||''}')">Copy URL</button></div>
          </div>`:``}
        <div style="display:flex;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
          <button class="btn btn-red btn-sm" onclick="deleteDevice('${dev.id}')">Remove</button>
        </div>
      </div>`).join('');
  }catch(e){toast('Failed to load devices','error');}
}

function openAddDevice(){
  ['pstep-1-body','pstep-2-body','pstep-3-body'].forEach((id,i)=>document.getElementById(id).style.display=i===0?'':'none');
  document.getElementById('pstep-1').className='step-num active-step';
  document.getElementById('pstep-2').className='step-num';
  document.getElementById('pstep-3').className='step-num';
  document.getElementById('dev-name').value='';
  document.getElementById('dev-desc').value='';
  openModal('modal-device');
}

function toggleAntishare(enabled){
  document.getElementById('antishare-opts').style.display=enabled?'':'none';
}

async function createDevice(){
  const name=document.getElementById('dev-name').value.trim();
  if(!name){toast('Enter a device name','error');return;}
  const antishare=document.getElementById('dev-antishare').checked;
  const maxDevices=parseInt(document.getElementById('dev-max-devices').value)||1;
  const bridgedPorts=document.getElementById('dev-ports').value.split(',').map(p=>p.trim()).filter(Boolean);
  const body={
    name,
    description:document.getElementById('dev-desc').value,
    antishare_enabled:antishare,
    antishare_max_devices:maxDevices,
    bridged_ports:bridgedPorts,
    wan_interface:document.getElementById('dev-wan').value.trim()||'ether1',
    hotspot_interface:document.getElementById('dev-hotspot-iface').value.trim()||'bridge-local',
    hotspot_gateway:document.getElementById('dev-gateway').value.trim()||'192.168.88.1',
    hotspot_network:document.getElementById('dev-network').value.trim()||'192.168.88.0/24',
    hotspot_pool_start:document.getElementById('dev-pool-start').value.trim()||'192.168.88.10',
    hotspot_pool_end:document.getElementById('dev-pool-end').value.trim()||'192.168.88.250',
  };
  try{
    const d=await api('/nas/',{method:'POST',body:JSON.stringify(body)});
    document.getElementById('pstep-1-body').style.display='none';
    document.getElementById('pstep-2-body').style.display='';
    document.getElementById('pstep-1').className='step-num done';
    document.getElementById('pstep-2').className='step-num active-step';
    const script=d.config?.mikrotik_full_script||`/tool fetch url="${d.provision_url}" http-method=post output=user as-value`;
    document.getElementById('prov-cmd').innerHTML=`<code style="word-break:break-all;font-size:.68rem;white-space:pre-wrap">${escHtml(script)}</code><button class="copy-btn" onclick="copyCode()">Copy Full Script</button>`;
    currentDeviceToken=d.device?.provision_token;
    pollInterval=setInterval(checkProvisioned,4000);
    document.getElementById('done-antishare-msg').textContent=antishare?`, and anti-share (max ${maxDevices} device/session)`:' ';
  }catch(e){toast(e.message,'error');}
}

function escHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

async function checkProvisioned(){
  try{
    const d=await api('/nas/');
    const dev=d.devices?.find(dv=>dv.provision_token===currentDeviceToken);
    if(dev?.is_provisioned){
      clearInterval(pollInterval);
      document.getElementById('pstep-2-body').style.display='none';
      document.getElementById('pstep-3-body').style.display='';
      document.getElementById('pstep-2').className='step-num done';
      document.getElementById('pstep-3').className='step-num done';
    }
  }catch(e){}
}

function copyCode(){
  const code=document.getElementById('prov-cmd').querySelector('code')?.textContent||'';
  navigator.clipboard.writeText(code).then(()=>toast('Copied to clipboard!'));
}
function copyText(t){navigator.clipboard.writeText(t).then(()=>toast('Copied!'));}
async function deleteDevice(id){
  if(!confirm('Remove this device?'))return;
  try{await api(`/nas/${id}`,{method:'DELETE'});toast('Device removed');loadDevices();}catch(e){toast(e.message,'error');}
}

// ── VOUCHERS ───────────────────────────────────────────────────
async function loadVoucherStats(){
  try{const d=await api('/vouchers/stats/summary');document.getElementById('v-total').textContent=d.total||0;document.getElementById('v-unused').textContent=d.unused||0;document.getElementById('v-active').textContent=d.active||0;document.getElementById('v-used').textContent=d.used||0;}catch(e){}
}

async function loadVouchers(){
  const status=document.getElementById('v-filter').value;
  const tbody=document.getElementById('vouchers-tbody');
  tbody.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:16px">Loading…</td></tr>';
  try{
    const d=await api(`/vouchers?page=${vPage}&limit=50${status?'&status='+status:''}`);
    tbody.innerHTML=(d.vouchers||[]).map(v=>`
      <tr style="cursor:pointer" onclick="showUserInDashboard((v.buyer_phone||v.code),'hotspot')"><td class="name" style="font-family:monospace;letter-spacing:1px">${v.code}${v.is_test ? ' <span style="background:rgba(243,156,18,.2);color:#f39c12;padding:1px 6px;border-radius:4px;font-size:.7rem;font-weight:600">🧪 TEST</span>' : ''}</td>
      <td>${v.package_name}</td>
      <td><span class="badge ${v.status==='unused'?'bg':v.status==='active'?'ba':v.status==='used'?'bm':'br'}">${v.status}</span></td>
      <td>${v.buyer_phone||'—'}</td>
      <td>${dt(v.used_at)}</td>
      <td>${dt(v.expires_at)}</td>
      <td>${v.is_paid?kes(v.amount_paid):'<span style="color:var(--muted)">Unpaid</span>'}</td></tr>`).join('')||'<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:20px">No vouchers found</td></tr>';
  }catch(e){}
}

async function openGenerateVouchers(){
  try{const d=await api('/hotspot/packages');document.getElementById('v-pkg-sel').innerHTML=(d.packages||[]).map(p=>`<option value="${p.id}">${p.name} — ${kes(p.price)}</option>`).join('');}catch(e){}
  openModal('modal-vouchers');
}

async function generateVouchers(){
  try{
    const d=await api('/vouchers/generate',{method:'POST',body:JSON.stringify({package_id:document.getElementById('v-pkg-sel').value,quantity:parseInt(document.getElementById('v-qty').value),prefix:document.getElementById('v-prefix').value})});
    toast(`${d.quantity} vouchers generated!`);closeModal('modal-vouchers');loadVouchers();loadVoucherStats();
  }catch(e){toast(e.message,'error');}
}

// ── HS PACKAGES ────────────────────────────────────────────────
async function loadHSPackages(){
  try{
    const d=await api('/hotspot/packages');
    const grid=document.getElementById('hs-pkg-grid');
    grid.innerHTML=d.packages?.length?d.packages.map(p=>`
      <div class="device-card" data-device-id="${d.id}" style="cursor:pointer">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <div style="font-family:var(--font-head);font-weight:700">${p.name}</div>
          <span style="font-family:var(--font-head);font-weight:700;color:var(--teal)">${kes(p.price)}</span>
        </div>
        <div style="font-size:.8rem;color:var(--muted);line-height:1.9">
          ⏱ ${p.duration_hours?p.duration_hours+' hours':'Unlimited'}<br>
          🚀 ${p.bandwidth_down_mbps?p.bandwidth_down_mbps+'Mbps':'Unlimited speed'}<br>
          💾 ${p.data_limit_mb?(p.data_limit_mb/1024).toFixed(1)+' GB':'No data cap'}<br>
          🎟 ${p.voucher_count||0} vouchers
        </div>
        <div style="display:flex;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
          <button class="btn btn-outline btn-sm" onclick="openGenerateVouchers()">+ Vouchers</button>
          <button class="btn btn-red btn-sm" onclick="deleteHSPkg('${p.id}')">Delete</button>
        </div>
      </div>`).join(''):'<div style="color:var(--muted);padding:20px;font-size:.88rem">No packages. Create one to start selling vouchers.</div>';
  }catch(e){}
}

function openHSPackageModal(){
  const html=`<div class="modal">
    <h2>New Hotspot Package</h2>
    <div class="fg2"><div class="fg"><label>Name *</label><input id="hsp-name" placeholder="e.g. 1 Hour Premium"/></div><div class="fg"><label>Price (KES) *</label><input id="hsp-price" type="number" placeholder="50"/></div></div>
    <div class="fg2"><div class="fg"><label>Duration (hours)</label><input id="hsp-hrs" type="number" placeholder="1 (blank=unlimited)"/></div><div class="fg"><label>Download Mbps</label><input id="hsp-down" type="number" placeholder="5 (blank=unlimited)"/></div></div>
    <div class="fg2"><div class="fg"><label>Upload Mbps</label><input id="hsp-up" type="number"/></div><div class="fg"><label>Data Limit (MB)</label><input id="hsp-data" type="number" placeholder="blank=unlimited"/></div></div>
    <div class="fg"><label>MikroTik Profile Name</label><input id="hsp-profile" placeholder="e.g. hotspot-1hr"/></div>
    <div class="modal-actions"><button class="btn btn-outline" onclick="this.closest('.modal-overlay').remove()">Cancel</button><button class="btn btn-teal" onclick="saveHSPkg()">Create</button></div>
  </div>`;
  const ov=document.createElement('div');ov.className='modal-overlay open';ov.innerHTML=html;
  ov.addEventListener('click',e=>{if(e.target===ov)ov.remove();});document.body.appendChild(ov);
}

async function saveHSPkg(){
  try{
    await api('/hotspot/packages',{method:'POST',body:JSON.stringify({name:document.getElementById('hsp-name').value,price:document.getElementById('hsp-price').value,duration_hours:document.getElementById('hsp-hrs').value||null,bandwidth_down_mbps:document.getElementById('hsp-down').value||null,bandwidth_up_mbps:document.getElementById('hsp-up').value||null,data_limit_mb:document.getElementById('hsp-data').value||null,mikrotik_profile:document.getElementById('hsp-profile').value})});
    toast('Package created!');document.querySelectorAll('.modal-overlay').forEach(o=>o.remove());loadHSPackages();
  }catch(e){toast(e.message,'error');}
}

async function deleteHSPkg(id){
  if(!confirm('Delete this package?'))return;
  try{await api(`/hotspot/packages/${id}`,{method:'DELETE'});toast('Deleted');loadHSPackages();}catch(e){toast(e.message,'error');}
}

// ── HS SESSIONS ────────────────────────────────────────────────
async function loadHSSessions(){
  try{
    const d=await api('/hotspot/sessions');
    document.getElementById('hs-sess-tbody').innerHTML=(d.sessions||[]).map(s=>`
      <tr data-code="${s.voucher_code||''}" data-phone="${s.buyer_phone||''}" style="cursor:pointer"><td style="font-family:monospace;font-size:.8rem">${s.mac_address||'—'}</td><td>${s.ip_address||'—'}</td>
      <td style="font-family:monospace">${s.voucher_code||'—'}</td><td>${s.package_name||'—'}</td>
      <td>${s.device_name||'—'}</td><td>${dts(s.started_at)}</td></tr>`).join('')||'<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:20px">No active sessions</td></tr>';
  }catch(e){}
}

// ── PPPOE PACKAGES ─────────────────────────────────────────────
async function loadPPPoEPackages() {
  try {
    const d = await api('/pppoe/packages');
    const grid = document.getElementById('pppoe-pkg-grid');
    if (!grid) return;
    if (!d.packages?.length) {
      grid.innerHTML = '<div style="color:var(--muted);padding:20px;font-size:.88rem">No PPPoE packages. Create one to start.</div>';
      return;
    }
    // Stash for edit lookup
    window.__pppoe_packages = d.packages;
    grid.innerHTML = d.packages.map(p => `
      <div class="device-card" style="cursor:pointer" onclick="editPPPoEPackage('${p.id}')">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <div style="font-family:var(--font-head);font-weight:700">${p.name}</div>
          <span style="font-family:var(--font-head);font-weight:700;color:var(--teal)">${kes(p.price)}/${p.billing_cycle||'mo'}</span>
        </div>
        <div style="font-size:.8rem;color:var(--muted);line-height:1.9">
          🚀 ${p.bandwidth_down_mbps||'∞'}Mbps ↓ / ${p.bandwidth_up_mbps||'∞'}Mbps ↑<br>
          💾 ${p.data_limit_gb ? p.data_limit_gb + ' GB/month' : 'Unlimited data'}<br>
          👥 ${p.subscriber_count||0} active subscribers<br>
          🎯 Profile: ${p.mikrotik_profile||'—'}
        </div>
        <div style="display:flex;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
          <button class="btn btn-outline btn-sm" onclick="event.stopPropagation();editPPPoEPackage('${p.id}')">✏️ Edit</button>
          <button class="btn btn-red btn-sm" onclick="event.stopPropagation();deletePPPoEPackage('${p.id}')">Delete</button>
        </div>
      </div>
    `).join('');
  } catch(e) { console.error('loadPPPoEPackages:', e); }
}

function openPPPoEPackageModal(){
  const html=`<div class="modal">
    <h2>New PPPoE Package</h2>
    <div class="fg2"><div class="fg"><label>Name *</label><input id="pp-name" placeholder="e.g. Home 10Mbps"/></div><div class="fg"><label>Price/Month (KES) *</label><input id="pp-price" type="number" placeholder="1500"/></div></div>
    <div class="fg2"><div class="fg"><label>Download Mbps</label><input id="pp-down" type="number" placeholder="10"/></div><div class="fg"><label>Upload Mbps</label><input id="pp-up" type="number" placeholder="5"/></div></div>
    <div class="fg2"><div class="fg"><label>Data Limit (GB)</label><input id="pp-data" type="number" placeholder="blank=unlimited"/></div><div class="fg"><label>MikroTik Profile</label><input id="pp-profile" placeholder="e.g. pppoe-10M"/></div></div>
    <div class="fg"><label>IP Pool</label><input id="pp-pool" placeholder="e.g. pppoe-pool"/></div>
    <div class="modal-actions"><button class="btn btn-outline" onclick="this.closest('.modal-overlay').remove()">Cancel</button><button class="btn btn-teal" onclick="savePPPoEPkg()">Create</button></div>
  </div>`;
  const ov=document.createElement('div');ov.className='modal-overlay open';ov.innerHTML=html;
  ov.addEventListener('click',e=>{if(e.target===ov)ov.remove();});document.body.appendChild(ov);
}

async function savePPPoEPkg(){
  try{
    await api('/pppoe/packages',{method:'POST',body:JSON.stringify({name:document.getElementById('pp-name').value,price:document.getElementById('pp-price').value,bandwidth_down_mbps:document.getElementById('pp-down').value||null,bandwidth_up_mbps:document.getElementById('pp-up').value||null,data_limit_gb:document.getElementById('pp-data').value||null,mikrotik_profile:document.getElementById('pp-profile').value,address_pool:document.getElementById('pp-pool').value})});
    toast('Package created!');document.querySelectorAll('.modal-overlay').forEach(o=>o.remove());loadPPPoEPackages();
  }catch(e){toast(e.message,'error');}
}

async function deletePPPoEPkg(id){if(!confirm('Delete?'))return;try{await api(`/pppoe/packages/${id}`,{method:'DELETE'});toast('Deleted');loadPPPoEPackages();}catch(e){toast(e.message,'error');}}

// ── SUBSCRIBERS ────────────────────────────────────────────────
async function loadSubscribers(){
  const search=document.getElementById('sub-search').value;
  const status=document.getElementById('sub-filter').value;
  const tbody=document.getElementById('subs-tbody');
  tbody.innerHTML='<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:16px">Loading…</td></tr>';
  try{
    const d=await api(`/pppoe/subscribers?page=${subPage}&limit=20${search?'&search='+encodeURIComponent(search):''}${status?'&status='+status:''}`);
    tbody.innerHTML=(d.subscribers||[]).map(s=>`
      <tr>
        <td class="name">${s.full_name}</td>
        <td style="font-family:monospace;font-size:.82rem">${s.username}</td>
        <td>${s.phone||'—'}</td>
        <td>${s.package_name}</td>
        <td><span class="badge ${s.status==='active'?'bg':s.status==='suspended'?'br':'ba'}">${s.status}</span>${parseInt(s.is_online)>0?'<span style="font-size:.7rem;color:var(--teal);margin-left:5px">● Online</span>':''}</td>
        <td>${dt(s.next_billing_date)}</td>
        <td style="color:${parseFloat(s.balance)<0?'var(--red)':'var(--teal)'}">${kes(s.balance)}</td>
        <td style="white-space:nowrap">
          <button class="btn btn-outline btn-sm" onclick="sendPaymentDetails('${s.id}','${s.phone||''}')">💬 Pay Details</button>
          <button class="btn btn-outline btn-sm" onclick="openPaymentFor('${s.id}')">Pay</button>
          <button class="btn btn-sm ${s.status==='suspended'?'btn-teal':'btn-red'}" onclick="toggleSub('${s.id}','${s.status==='suspended'?'active':'suspended'}')">${s.status==='suspended'?'Activate':'Suspend'}</button>
        </td>
      </tr>`).join('')||'<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:20px">No subscribers</td></tr>';
  }catch(e){toast('Failed to load subscribers','error');}
}

async function openAddSubscriber(){
  try{const d=await api('/pppoe/packages');document.getElementById('sub-pkg').innerHTML=(d.packages||[]).map(p=>`<option value="${p.id}">${p.name} — ${kes(p.price)}/mo</option>`).join('');}catch(e){}
  document.getElementById('sub-password').value=Math.random().toString(36).slice(-8).toUpperCase();
  openModal('modal-subscriber');
}

async function addSubscriber(){
  try{
    await api('/pppoe/subscribers',{method:'POST',body:JSON.stringify({full_name:document.getElementById('sub-name').value,phone:document.getElementById('sub-phone').value,username:document.getElementById('sub-username').value,password:document.getElementById('sub-password').value,email:document.getElementById('sub-email').value,id_number:document.getElementById('sub-idno').value,package_id:document.getElementById('sub-pkg').value,county:document.getElementById('sub-county').value,town:document.getElementById('sub-town').value,is_test:document.getElementById('sub-is-test')?.checked||false})});
    toast('Subscriber added! SMS sent if phone provided.');closeModal('modal-subscriber');loadSubscribers();
  }catch(e){toast(e.message,'error');}
}

async function toggleSub(id,status){
  try{await api(`/pppoe/subscribers/${id}/status`,{method:'PATCH',body:JSON.stringify({status})});toast(`Subscriber ${status}`);loadSubscribers();}catch(e){toast(e.message,'error');}
}

async function sendPaymentDetails(id,phone){
  if(!phone){toast('Subscriber has no phone number','error');return;}
  try{await api(`/pppoe/subscribers/${id}/send-payment-details`,{method:'POST'});toast(`Payment details sent to ${phone}`);}catch(e){toast(e.message,'error');}
}

function openPaymentFor(subId){
  document.getElementById('modal-payment').dataset.subId=subId;
  openModal('modal-payment');
}

// ── PPPOE SESSIONS ─────────────────────────────────────────────
async function loadPPPoESessions(){
  try{
    const d=await api('/pppoe/sessions?status=active');
    document.getElementById('pppoe-sess-tbody').innerHTML=(d.sessions||[]).map(s=>`
      <tr data-user="${s.username||''}" style="cursor:pointer"><td class="name">${s.username}</td><td>${s.full_name}</td><td>${s.framed_ip||'—'}</td>
      <td>${byt(s.bytes_downloaded)}</td><td>${byt(s.bytes_uploaded)}</td><td>${dur(s.session_time_seconds)}</td></tr>`).join('')||'<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:20px">No active sessions</td></tr>';
  }catch(e){}
}

// ── PAYMENTS ───────────────────────────────────────────────────
async function loadPayments(){
  try{
    const d=await api('/payments?limit=50');
    document.getElementById('payments-tbody').innerHTML=(d.payments||[]).map(p=>`
      <tr data-phone="${p.phone_number||p.phone||p.buyer_phone||''}" data-code="${p.voucher_code||''}" style="cursor:pointer"><td class="name">${p.subscriber_name||p.voucher_code||'—'}</td>
      <td style="color:var(--teal);font-weight:600">${kes(p.amount)}</td>
      <td><span class="badge bg">${p.payment_method}</span></td>
      <td><span class="badge ${p.status==='paid'?'bg':p.status==='pending'?'ba':'br'}">${p.status}</span></td>
      <td style="color:var(--red)">-${kes(p.commission_amount)}</td>
      <td>${dts(p.created_at)}</td></tr>`).join('')||'<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:20px">No payments yet</td></tr>';
  }catch(e){}
}

function openManualPayment(){document.getElementById('modal-payment').dataset.subId='';openModal('modal-payment');}

async function recordPayment(){
  const subId=document.getElementById('modal-payment').dataset.subId;
  try{
    await api('/payments/manual',{method:'POST',body:JSON.stringify({amount:document.getElementById('pay-amount').value,payment_method:document.getElementById('pay-method').value,subscriber_id:subId||undefined,description:document.getElementById('pay-desc').value,reference:document.getElementById('pay-ref').value})});
    toast('Payment recorded!');closeModal('modal-payment');loadPayments();loadWallet();
  }catch(e){toast(e.message,'error');}
}

// ── SMS ────────────────────────────────────────────────────────
window._smsLogData = []; window._smsLogPage = 1; window._smsPurchData = []; window._smsPurchPage = 1; const SMS_PAGE_SIZE = 25;

function escHtml(s){ return String(s==null?'':s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

function renderPager(containerId, total, page, cb){
  const pages = Math.ceil(total / SMS_PAGE_SIZE);
  const el = document.getElementById(containerId);
  if (!el) return;
  if (pages <= 1) { el.innerHTML=''; return; }
  let h = '';
  h += `<button class="btn btn-outline btn-sm" ${page<=1?'disabled':''} onclick="${cb}(${page-1})">‹ Prev</button>`;
  h += `<span style="padding:6px 10px;color:var(--muted);font-size:.82rem">Page ${page} of ${pages}</span>`;
  h += `<button class="btn btn-outline btn-sm" ${page>=pages?'disabled':''} onclick="${cb}(${page+1})">Next ›</button>`;
  el.innerHTML = h;
}

async function loadSMSLog(){
  try{
    const d = await api('/sms/logs');
    window._smsLogData = d.logs || [];
    window._smsLogPage = 1;
    renderSmsLogPage(1);
  }catch(e){}
}
function smsLogGo(p){ renderSmsLogPage(p); }
window.smsLogGo = smsLogGo;
function renderSmsLogPage(page){
  window._smsLogPage = page;
  const data = window._smsLogData || [];
  const start = (page-1)*SMS_PAGE_SIZE;
  const rows = data.slice(start, start+SMS_PAGE_SIZE);
  const tb = document.getElementById('sms-log-tbody');
  if (!tb) return;
  tb.innerHTML = rows.map((l, i) => {
    const idx = start + i;
    const preview = (l.message||'').length > 40 ? (l.message.slice(0,40)+'…') : (l.message||'');
    return `<tr style="cursor:pointer" onclick="viewSmsLog(${idx})">
      <td>${escHtml(l.recipient)}</td>
      <td style="color:var(--muted)">${escHtml(preview)}</td>
      <td><span class="badge ${l.status==='sent'?'bg':'br'}">${escHtml(l.status)}</span></td>
      <td>${dts(l.sent_at)}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:18px">No SMS sent yet</td></tr>';
  renderPager('sms-log-pager', data.length, page, 'smsLogGo');
}
function viewSmsLog(idx){
  const l = (window._smsLogData||[])[idx];
  if (!l) return;
  document.getElementById('sms-view-sub').textContent = dts(l.sent_at) + ' · ' + (l.status||'');
  document.getElementById('sms-view-to').textContent = l.recipient || '—';
  document.getElementById('sms-view-msg').textContent = l.message || '(no message stored)';
  document.getElementById('sms-view-overlay').classList.add('open');
}
window.viewSmsLog = viewSmsLog;

// ── SMS tabs ──
function switchSmsTab(tab, el){
  document.querySelectorAll('#page-sms .stab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('#page-sms .stab-content').forEach(c => c.classList.remove('active'));
  if (el) el.classList.add('active');
  document.getElementById('stab-sms-' + tab)?.classList.add('active');
  if (tab === 'log') loadSMSLog();
  if (tab === 'purchases') loadSmsPurchases();
}
window.switchSmsTab = switchSmsTab;

function smsCountUpdate(){ const m=document.getElementById('sms-msg'); const c=document.getElementById('sms-count'); if(m&&c) c.textContent = m.value.length; }
window.smsCountUpdate = smsCountUpdate;

// ── Smart recipient picker ──
window._smsRecipSet = new Set();
function smsRenderChips(){
  const wrap = document.getElementById('sms-chips');
  if (!wrap) return;
  wrap.innerHTML = Array.from(window._smsRecipSet).map(p =>
    `<span style="display:inline-flex;align-items:center;gap:5px;background:rgba(0,212,170,.12);border:1px solid rgba(0,212,170,.3);color:#00d4aa;border-radius:14px;padding:3px 10px;font-size:.78rem">${escHtml(p)}<span style="cursor:pointer;font-weight:700" onclick="smsRemoveChip('${escHtml(p)}')">×</span></span>`
  ).join('');
}
function smsRemoveChip(p){ window._smsRecipSet.delete(p); smsRenderChips(); }
window.smsRemoveChip = smsRemoveChip;
function smsAddRecipients(arr){ (arr||[]).forEach(p => { if(p) window._smsRecipSet.add(String(p).trim()); }); smsRenderChips(); }

async function smsRecipFocus(){
  // show group options
  const dd = document.getElementById('sms-recip-dropdown');
  if (!dd) return;
  dd.innerHTML = '<div style="padding:12px;color:var(--muted);font-size:.82rem">Loading groups…</div>';
  dd.style.display = 'block';
  try {
    const d = await api('/isp/sms/recipients/groups');
    const groups = (d.groups||[]).filter(g => g.count > 0 || g.key === 'all');
    dd.innerHTML = '<div style="padding:8px 12px;font-size:.7rem;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--border)">Send to a group</div>' +
      groups.map(g => `<div class="sms-recip-item" style="padding:10px 12px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,.04)" onmouseover="this.style.background='rgba(255,255,255,.05)'" onmouseout="this.style.background=''" onclick="smsPickGroup('${g.key}')">
        <span style="font-size:.86rem">${escHtml(g.label)}</span>
        <span style="font-size:.74rem;color:#00d4aa">${g.count>0?g.count+' recipients':'add'}</span>
      </div>`).join('') +
      '<div style="padding:8px 12px;font-size:.72rem;color:var(--muted)">…or type a name, username, or phone to search individuals</div>';
  } catch(e){ dd.innerHTML='<div style="padding:12px;color:var(--muted)">Could not load groups</div>'; }
}
window.smsRecipFocus = smsRecipFocus;

async function smsPickGroup(key){
  const dd = document.getElementById('sms-recip-dropdown');
  try {
    if (dd) dd.innerHTML = '<div style="padding:12px;color:var(--muted)">Adding recipients…</div>';
    const d = await api('/isp/sms/recipients/list?group=' + encodeURIComponent(key));
    smsAddRecipients((d.recipients||[]).map(r => r.phone));
    if (dd) dd.style.display = 'none';
    document.getElementById('sms-to').value = '';
    toast('Added ' + (d.count||0) + ' recipients');
  } catch(e){ toast('Could not add group', 'error'); }
}
window.smsPickGroup = smsPickGroup;

let _smsSearchTO = null;
function smsRecipInput(){
  const q = document.getElementById('sms-to').value.trim();
  const dd = document.getElementById('sms-recip-dropdown');
  if (_smsSearchTO) clearTimeout(_smsSearchTO);
  // allow direct phone entry: if it looks like a full phone, Enter/comma adds it
  if (q.length < 2) { smsRecipFocus(); return; }
  _smsSearchTO = setTimeout(async () => {
    try {
      const d = await api('/isp/sms/recipients/search?q=' + encodeURIComponent(q));
      let h = '';
      if ((d.results||[]).length) {
        h = (d.results).map(r => `<div style="padding:10px 12px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,.04)" onmouseover="this.style.background='rgba(255,255,255,.05)'" onmouseout="this.style.background=''" onclick="smsPickOne('${escHtml(r.phone)}','${escHtml(r.label||'')}')">
          <span style="font-size:.86rem">${escHtml(r.label||r.phone)} <span style="color:var(--muted);font-size:.76rem">${escHtml(r.phone)}</span></span>
          <span style="font-size:.72rem;color:#00d4aa">${escHtml(r.kind||'')}</span>
        </div>`).join('');
      } else {
        h = '<div style="padding:10px 12px;color:var(--muted);font-size:.82rem">No match.</div>';
      }
      // offer to add the typed value directly if it has digits
      if (/\d{6,}/.test(q)) {
        h += `<div style="padding:10px 12px;cursor:pointer;color:#00d4aa;font-size:.84rem;border-top:1px solid var(--border)" onclick="smsPickOne('${escHtml(q)}','')">➕ Add number "${escHtml(q)}"</div>`;
      }
      if (dd){ dd.innerHTML = h; dd.style.display='block'; }
    } catch(e){}
  }, 250);
}
window.smsRecipInput = smsRecipInput;
function smsPickOne(phone, label){
  smsAddRecipients([phone]);
  document.getElementById('sms-to').value = '';
  const dd = document.getElementById('sms-recip-dropdown');
  if (dd) dd.style.display = 'none';
}
window.smsPickOne = smsPickOne;

// close dropdown on outside click
document.addEventListener('click', (e) => {
  const box = document.getElementById('sms-recip-dropdown');
  const input = document.getElementById('sms-to');
  const chips = document.getElementById('sms-chips');
  if (box && box.style.display==='block' && e.target!==input && !box.contains(e.target) && (!chips || !chips.contains(e.target))) {
    box.style.display='none';
  }
});

async function sendSMS(){
  // combine picked chips + anything still typed in the box
  const typed = document.getElementById('sms-to').value.split(',').map(s=>s.trim()).filter(Boolean);
  typed.forEach(t => window._smsRecipSet.add(t));
  smsRenderChips();
  document.getElementById('sms-to').value='';
  const recipients = Array.from(window._smsRecipSet);
  const message = document.getElementById('sms-msg').value.trim();
  if(!recipients.length||!message){ toast('Add recipients and a message','error'); return; }
  try{
    const d = await api('/sms/send',{method:'POST',body:JSON.stringify({recipients,message})});
    const sent = d.results?.filter(r=>r.status==='sent').length || 0;
    const failed = d.results?.filter(r=>r.status==='failed') || [];
    if (failed.length && failed[0].error) toast(`Sent ${sent}. ${failed.length} failed: ${failed[0].error}`, failed.length?'error':true);
    else toast(`Sent to ${sent} recipient${sent===1?'':'s'}`);
    document.getElementById('sms-msg').value='';
    window._smsRecipSet.clear(); smsRenderChips(); smsCountUpdate();
    loadSMSLog();
    if (window.refreshSmsCard) window.refreshSmsCard();   // update header balance pill instantly
    if (window.loadSmsPurchases) window.loadSmsPurchases(); // keep purchase ledger in sync
  }catch(e){ toast(e.message,'error'); }
}

// ── NOTIFICATIONS ──────────────────────────────────────────────
async function loadNotifications(){
  try{
    const d=await api('/notifications/');
    const list=document.getElementById('notif-list');
    const unread=d.notifications?.some(n=>!n.is_read);
    document.getElementById('notif-dot').style.display=unread?'block':'none';
    list.innerHTML=(d.notifications||[]).map(n=>`
      <div style="background:var(--card);border:1px solid ${n.is_read?'var(--border)':'rgba(0,212,170,.2)'};border-radius:10px;padding:14px 18px;margin-bottom:10px;display:flex;align-items:flex-start;gap:12px">
        <span style="font-size:1.1rem">${n.type==='success'?'✅':n.type==='warning'?'⚠️':n.type==='error'?'❌':'ℹ️'}</span>
        <div style="flex:1">
          <div style="font-weight:500;font-size:.88rem${n.is_read?';color:var(--muted)':''}">${n.title}</div>
          <div style="color:var(--muted);font-size:.82rem;margin-top:3px;font-weight:300">${n.message}</div>
          <div style="font-size:.72rem;color:var(--border);margin-top:5px">${dts(n.created_at)}</div>
        </div>
        ${!n.is_read?`<button class="btn btn-outline btn-sm" onclick="markRead('${n.id}')">✓</button>`:''}
      </div>`).join('')||'<div style="text-align:center;color:var(--muted);padding:40px">No notifications</div>';
  }catch(e){}
}

async function markRead(id){try{await api(`/notifications/${id}/read`,{method:'PATCH'});loadNotifications();}catch(e){}}
async function markAllRead(){try{await api('/notifications/read-all',{method:'PATCH'});loadNotifications();toast('All marked as read');}catch(e){}}

// ── SUPPORT ────────────────────────────────────────────────────
async function loadTickets(){
  try{const d=await api('/support/');document.getElementById('tickets-tbody').innerHTML=(d.tickets||[]).map(t=>`<tr><td class="name">${t.subject}</td><td><span class="badge ${t.priority==='urgent'?'br':t.priority==='high'?'ba':'bm'}">${t.priority}</span></td><td><span class="badge ${t.status==='open'?'bg':'bm'}">${t.status}</span></td><td>${dts(t.created_at)}</td></tr>`).join('')||'<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px">No tickets</td></tr>';}catch(e){}
}

function openNewTicket(){openModal('modal-ticket');}
async function submitTicket(){
  try{await api('/support/',{method:'POST',body:JSON.stringify({subject:document.getElementById('ticket-subject').value,message:document.getElementById('ticket-msg').value,priority:document.getElementById('ticket-pri').value})});toast('Ticket submitted!');closeModal('modal-ticket');loadTickets();}catch(e){toast(e.message,'error');}
}

// ── SETTINGS ───────────────────────────────────────────────────
function switchSettingsTab(tab, el) {
  document.querySelectorAll('.stab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.stab-content').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('stab-' + tab)?.classList.add('active');
  if (tab === 'portal') renderPortalTemplates();
  if (tab === 'payment-methods') loadPaymentMethods();
  if (tab === 'sms-gw') loadSMSGatewaySettings();
}

async function loadSettings(){
  try{
    const d=await api('/isp/profile');
    const p=d.profile;
    document.getElementById('set-company').value=p.company_name||'';
    document.getElementById('set-owner').value=p.owner_name||'';
    document.getElementById('set-phone').value=p.phone||'';
    document.getElementById('set-county').value=p.county||'';
    document.getElementById('set-town').value=p.town||'';
    document.getElementById('set-address').value=p.address||'';
    document.getElementById('set-apikey').value=p.api_key||'';
    document.getElementById('portal-url').value=`https://rumalinkenterprise.online/captive/${p.id}`;
  }catch(e){}
  try{
    const d=await api('/portal-settings/');
    const pt=d.portal;
    if(pt){
      selectedTemplate=pt.template||'classic';
      document.getElementById('portal-title').value=pt.welcome_title||'';
      document.getElementById('portal-sub').value=pt.welcome_subtitle||'';
      document.getElementById('portal-color').value=pt.primary_color||'#00d4aa';
      document.getElementById('portal-color2').value=pt.secondary_color||'#0d1530';
      document.getElementById('portal-show-logo').checked=pt.show_logo!==false;
      document.getElementById('portal-powered-by').checked=pt.show_powered_by!==false;
      document.getElementById('portal-tv-mode').checked=pt.enable_tv_mode!==false;
      document.getElementById('portal-support-number').value=pt.support_number||'';
      document.getElementById('portal-support-label').value=pt.support_label||'Need Help? Call Us';
    }
  }catch(e){}
}

async function saveProfile(){
  try{await api('/isp/profile',{method:'PUT',body:JSON.stringify({company_name:document.getElementById('set-company').value,owner_name:document.getElementById('set-owner').value,phone:document.getElementById('set-phone').value,county:document.getElementById('set-county').value,town:document.getElementById('set-town').value,address:document.getElementById('set-address').value})});toast('Profile saved!');}catch(e){toast(e.message,'error');}
}

async function changePassword(){
  const pw=document.getElementById('set-newpw').value;
  if(!pw||pw.length<8){toast('Password must be at least 8 characters','error');return;}
  const current=prompt('Enter your current password:');
  if(!current)return;
  try{await api('/isp/change-password',{method:'POST',body:JSON.stringify({current_password:current,new_password:pw})});toast('Password changed!');document.getElementById('set-newpw').value='';}catch(e){toast(e.message,'error');}
}

async function regenApiKey(){
  if(!confirm('Regenerate API key? The old key will stop working immediately.'))return;
  try{const d=await api('/isp/regenerate-api-key',{method:'POST'});document.getElementById('set-apikey').value=d.api_key;toast('API key regenerated!');}catch(e){toast(e.message,'error');}
}

// ── CAPTIVE PORTAL SETTINGS ────────────────────────────────────
function renderPortalTemplates(){
  const grid=document.getElementById('portal-templates-grid');
  grid.innerHTML=PORTAL_TEMPLATES.map(t=>`
    <div class="portal-card ${selectedTemplate===t.id?'selected':''}" onclick="selectTemplate('${t.id}')">
      <div class="portal-card-preview" style="background:${t.bg}">
        <span style="font-size:2.5rem">${t.icon}</span>
        ${selectedTemplate===t.id?'<div class="portal-selected-badge">✓ Selected</div>':''}
      </div>
      <div class="portal-card-label">
        <div style="font-weight:600;font-size:.88rem">${t.name}</div>
        <div style="font-size:.76rem;color:var(--muted);margin-top:2px">${t.desc}</div>
      </div>
    </div>`).join('');
}

function selectTemplate(id){
  selectedTemplate=id;
  renderPortalTemplates();
}

async function savePortalTemplate(){
  try{await api('/portal-settings/',{method:'POST',body:JSON.stringify({template:selectedTemplate})});toast(`${selectedTemplate} template saved!`);}catch(e){toast(e.message,'error');}
}

async function savePortalSettings(){
  try{
    await api('/portal-settings/',{method:'POST',body:JSON.stringify({
      template:selectedTemplate,
      welcome_title:document.getElementById('portal-title').value,
      welcome_subtitle:document.getElementById('portal-sub').value,
      primary_color:document.getElementById('portal-color').value,
      secondary_color:document.getElementById('portal-color2').value,
      show_logo:document.getElementById('portal-show-logo').checked,
      show_powered_by:document.getElementById('portal-powered-by').checked,
      enable_tv_mode:document.getElementById('portal-tv-mode').checked,
      support_number:document.getElementById('portal-support-number').value.trim()||null,
      support_label:document.getElementById('portal-support-label').value.trim()||'Need Help? Call Us'
    })});
    toast('Portal settings saved!');
  }catch(e){toast(e.message,'error');}
}

function previewPortal(){
  const isp_id=document.getElementById('portal-url').value.split('/').pop();
  const url=`/captive/${selectedTemplate}.html?isp=${isp_id}`;
  document.getElementById('preview-name').textContent=PORTAL_TEMPLATES.find(t=>t.id===selectedTemplate)?.name||selectedTemplate;
  document.getElementById('preview-iframe').src=url;
  openModal('modal-preview');
}

function copyPortalLink(){
  const url=document.getElementById('portal-url').value;
  navigator.clipboard.writeText(url).then(()=>toast('Portal link copied!'));
}

// ── SMS GATEWAY SETTINGS ────────────────────────────────────────
async function loadSMSGatewaySettings(){
  try{
    const d=await api('/isp/profile');
    const gw=d.profile?.sms_gateway||'';
    document.getElementById('sms-gateway-select').value=gw;
    document.getElementById('sms-sender-id').value=d.profile?.sms_sender_id||'';
    if(gw)updateSMSFields();
  }catch(e){}
}

function updateSMSFields(){
  const gw=document.getElementById('sms-gateway-select').value;
  const note=document.getElementById('rumalink-sms-note');
  if(gw==='rumalink'){
    // RumaLink SMS uses the platform's own gateway — ISP enters no credentials.
    document.getElementById('sms-gateway-fields').style.display='none';
    if(note) note.style.display='';
    return;
  }
  if(note) note.style.display='none';
  const show=!!gw;
  document.getElementById('sms-gateway-fields').style.display=show?'':'none';
  if(!gw)return;
  const config=KENYA_SMS_GATEWAYS[gw];
  document.getElementById('sms-username-field').style.display=config?.needsUsername?'':'none';
  document.getElementById('sms-partnerid-field').style.display=config?.needsPartnerId?'':'none';
}

async function testSMSGateway(){
  const phone=document.getElementById('sms-test-phone').value.trim();
  const gw=document.getElementById('sms-gateway-select').value;
  if(!phone||!gw){toast('Select a gateway and enter a test phone','error');return;}
  const resultEl=document.getElementById('sms-test-result');
  resultEl.style.display='block';
  resultEl.style.background='rgba(243,156,18,.08)';
  resultEl.style.border='1px solid rgba(243,156,18,.2)';
  resultEl.style.color='var(--amber)';
  resultEl.textContent='Sending test SMS…';
  try{
    await api('/sms/send',{method:'POST',body:JSON.stringify({recipients:[phone],message:`RumaLink test SMS from ${document.getElementById('sms-sender-id').value||'RumaLink'}. If you received this, your SMS gateway is working correctly!`})});
    resultEl.style.background='rgba(0,212,170,.08)';
    resultEl.style.border='1px solid rgba(0,212,170,.2)';
    resultEl.style.color='var(--teal)';
    resultEl.textContent='✅ Test SMS sent! Check your phone. If received, click Save.';
  }catch(e){
    resultEl.style.background='rgba(231,76,60,.08)';
    resultEl.style.border='1px solid rgba(231,76,60,.2)';
    resultEl.style.color='var(--red)';
    resultEl.textContent='❌ SMS failed: '+e.message;
  }
}

async function saveSMSGateway(){
  try{
    await api('/isp/profile',{method:'PUT',body:JSON.stringify({sms_gateway:document.getElementById('sms-gateway-select').value,sms_api_key:document.getElementById('sms-api-key').value,sms_sender_id:document.getElementById('sms-sender-id').value,sms_username:document.getElementById('sms-username').value,sms_partner_id:document.getElementById('sms-partner-id').value})});
    toast('SMS gateway saved!');
    if (window.refreshSmsCard) window.refreshSmsCard();   // show/hide the header SMS pill instantly
    if (window.loadSmsPurchases) window.loadSmsPurchases(); // show/hide the Purchase History tab
  }catch(e){toast(e.message,'error');}
}

// ── PAYMENT METHODS ────────────────────────────────────────────
async function loadPaymentMethods(){
  const list=document.getElementById('pm-list');
  list.innerHTML='<div class="loading"><div class="spinner"></div>Loading…</div>';
  try{
    const d=await api('/payment-methods/');
    if(!d.methods?.length){list.innerHTML='<p style="color:var(--muted);font-size:.88rem">No payment methods configured. Add one below.</p>';return;}
    const icons={mpesa_stk:'📱',till:'📱',paybill:'📱',bank:'🏦',cash:'💵'};
    const labels={mpesa_stk:'MPesa STK Push',till:'MPesa Till',paybill:'MPesa Paybill',bank:'Bank Transfer',cash:'Cash',equity:'Equity Bank (instant)'};
    list.innerHTML=d.methods.map(m=>`
      <div class="pm-card">
        <div class="pm-card-left">
          <div class="pm-icon" style="background:rgba(0,212,170,.1)">${icons[m.method_type]||'💳'}</div>
          <div>
            <div class="pm-name">${m.label||labels[m.method_type]||m.method_type}</div>
            <div class="pm-detail">
              ${m.till_number?'Till: '+m.till_number:''}
              ${m.paybill_number?'Paybill: '+m.paybill_number:''}
              ${m.account_number?'Acc: '+m.account_number:''}
              ${m.use_admin_credentials?'<span style="color:var(--teal)">Using platform credentials</span>':''}
              ${m.is_default?'<span style="background:rgba(0,212,170,.15);color:var(--teal);padding:2px 8px;border-radius:100px;font-size:.7rem;margin-left:6px">Default</span>':''}
            </div>
          </div>
        </div>
        <div class="pm-actions">
          <div class="status-dot ${m.is_verified?'sd-green':'sd-amber'}" title="${m.is_verified?'Verified':'Not tested yet'}"></div>
          <button class="btn btn-red btn-sm" onclick="deletePaymentMethod('${m.id}')">Remove</button>
        </div>
      </div>`).join('');
  }catch(e){list.innerHTML='<p style="color:var(--red);font-size:.88rem">Failed to load payment methods</p>';}
}

function openAddPaymentMethod(){
  document.getElementById('pm-type').value='';
  document.getElementById('pm-label').value='';
  document.getElementById('pm-test-result').style.display='none';
  ['stk','till','paybill','bank','equity'].forEach(t=>document.getElementById(`pm-fields-${t}`).style.display='none');
  openModal('modal-pm');
}

function updatePMFields(){
  const type=document.getElementById('pm-type').value;
  ['stk','till','paybill','bank','equity'].forEach(t=>document.getElementById(`pm-fields-${t}`).style.display='none');
  if(type==='mpesa_stk')document.getElementById('pm-fields-stk').style.display='';
  else if(type==='till')document.getElementById('pm-fields-till').style.display='';
  else if(type==='paybill')document.getElementById('pm-fields-paybill').style.display='';
  else if(type==='bank')document.getElementById('pm-fields-bank').style.display='';
  else if(type==='equity')document.getElementById('pm-fields-equity').style.display='';
}

function toggleAdminCreds(){
  const useAdmin=document.getElementById('pm-use-admin').checked;
  document.getElementById('pm-own-creds').style.display=useAdmin?'none':'';
  document.getElementById('pm-forward-section').style.display=useAdmin?'':'none';
}

async function testPaymentMethod(){
  const type=document.getElementById('pm-type').value;
  const phone=document.getElementById('pm-test-phone').value.trim();
  const res=document.getElementById('pm-test-result');
  if(!phone){toast('Enter a test phone number','error');return;}
  if(!type){toast('Select a payment method type','error');return;}

  res.style.display='block';
  res.style.cssText='display:block;background:rgba(243,156,18,.08);border:1px solid rgba(243,156,18,.2);color:var(--amber);padding:10px;border-radius:8px;font-size:.82px;margin-bottom:12px;font-size:.82rem';
  res.textContent='Sending KES 1 test payment…';

  const btn=document.getElementById('pm-test-btn');
  btn.disabled=true;

  // For non-API methods, just verify the details are filled
  if(type==='till'||type==='paybill'||type==='bank'||type==='cash'){
    setTimeout(()=>{
      res.style.cssText='display:block;background:rgba(0,212,170,.08);border:1px solid rgba(0,212,170,.2);color:var(--teal);padding:10px;border-radius:8px;font-size:.82rem;margin-bottom:12px';
      res.textContent='✅ Manual payment method verified. You can save it now.';
      btn.disabled=false;
    },800);
    return;
  }

  // MPesa STK test
  const useAdmin=document.getElementById('pm-use-admin').checked;
  const payload={
    method_type:type, test_phone:phone, use_admin_credentials:useAdmin,
    shortcode:document.getElementById('pm-shortcode')?.value,
    consumer_key:document.getElementById('pm-ck')?.value,
    consumer_secret:document.getElementById('pm-cs')?.value,
    passkey:document.getElementById('pm-passkey')?.value,
    is_sandbox:document.getElementById('pm-sandbox')?.checked
  };

  try{
    // Save temporarily to test
    const saved=await api('/payment-methods/',{method:'POST',body:JSON.stringify({...payload,label:'Test'})});
    const testRes=await api(`/payment-methods/${saved.method?.id}/test`,{method:'POST',body:JSON.stringify({test_phone:phone})});
    res.style.cssText='display:block;background:rgba(0,212,170,.08);border:1px solid rgba(0,212,170,.2);color:var(--teal);padding:10px;border-radius:8px;font-size:.82rem;margin-bottom:12px';
    res.textContent=`✅ ${testRes.message} You can now save this payment method.`;
    // Delete the temp one
    if(saved.method?.id)await api(`/payment-methods/${saved.method.id}`,{method:'DELETE'});
  }catch(e){
    res.style.cssText='display:block;background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.2);color:var(--red);padding:10px;border-radius:8px;font-size:.82rem;margin-bottom:12px';
    res.textContent='❌ Test failed: '+e.message;
  }
  btn.disabled=false;
}

async function savePaymentMethod(){
  const type=document.getElementById('pm-type').value;
  if(!type){toast('Select a payment method type','error');return;}
  const useAdmin=document.getElementById('pm-use-admin')?.checked||false;
  const payload={
    method_type:type, label:document.getElementById('pm-label').value||type,
    use_admin_credentials:useAdmin,
    is_default:document.getElementById('pm-default').checked,
    shortcode:document.getElementById('pm-shortcode')?.value||null,
    consumer_key:document.getElementById('pm-ck')?.value||null,
    consumer_secret:document.getElementById('pm-cs')?.value||null,
    passkey:document.getElementById('pm-passkey')?.value||null,
    is_sandbox:document.getElementById('pm-sandbox')?.checked||false,
    till_number:document.getElementById('pm-till')?.value||null,
    paybill_number:document.getElementById('pm-paybill')?.value||null,
    account_reference:document.getElementById('pm-acc-ref')?.value||null,
    bank_name:document.getElementById('pm-bank-name')?.value||null,
    account_number:document.getElementById('pm-bank-acc')?.value||null,
    account_name:document.getElementById('pm-bank-accname')?.value||null,
    branch:document.getElementById('pm-bank-branch')?.value||null,
    forward_to_type:document.getElementById('pm-fwd-type')?.value||null,
    forward_to_number:document.getElementById('pm-fwd-number')?.value||null,
    forward_to_name:document.getElementById('pm-fwd-name')?.value||null,
  };
  if(type==='equity'){
    payload.account_number=document.getElementById('pm-equity-acc')?.value||null;
    payload.account_name=document.getElementById('pm-equity-name')?.value||null;
    payload.bank_name='Equity Bank';
    payload.provider='equity_jenga';
    if(!document.getElementById('pm-label').value) payload.label='Equity Bank';
    if(!payload.account_number||!payload.account_name){toast('Enter your Equity account number and name','error');return;}
  }
  try{
    await api('/payment-methods/',{method:'POST',body:JSON.stringify(payload)});
    toast('Payment method saved!');closeModal('modal-pm');loadPaymentMethods();
  }catch(e){toast(e.message,'error');}
}

async function deletePaymentMethod(id){
  if(!confirm('Remove this payment method?'))return;
  try{await api(`/payment-methods/${id}`,{method:'DELETE'});toast('Removed');loadPaymentMethods();}catch(e){toast(e.message,'error');}
}

function toggleSidebar(){
  const sb = document.querySelector('.sidebar');
  const ov = document.getElementById('sidebar-overlay');
  const open = sb.classList.toggle('open');
  ov.classList.toggle('open', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
// Close sidebar when nav item clicked on mobile
document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', () => {
    if(window.innerWidth <= 900){
      document.querySelector('.sidebar').classList.remove('open');
      document.getElementById('sidebar-overlay').classList.remove('open');
      document.body.style.overflow = '';
    }
  });
});
</script>
<div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>

<!-- Payment spinner widget -->
<div id="rml-spinner-include"></div>
<script>
fetch('/captive/payment-spinner.html').then(r => r.text()).then(html => {
  document.getElementById('rml-spinner-include').innerHTML = html;
  document.querySelectorAll('#rml-spinner-include script').forEach(s => {
    var n = document.createElement('script');
    n.textContent = s.textContent;
    document.body.appendChild(n);
  });
});
// Hook payment endpoints to show spinner
(function(){
  var origFetch = window.fetch;
  window.fetch = function(url, opts) {
    var prom = origFetch.apply(this, arguments);
    if (typeof url === 'string' && opts && opts.method === 'POST' && 
        url.indexOf('/billing/pay') === -1 && (url.indexOf('/payments/invoice-pay') > -1 || url.indexOf('/pay') > -1)) {
      prom.then(r => r.clone().json()).then(data => {
        if (data && data.payment_id && typeof rumalinkShowPaymentSpinner === 'function') {
          var body = {};
          try { body = JSON.parse(opts.body || '{}'); } catch(e){}
          rumalinkShowPaymentSpinner({
            phone: body.phone,
            amount: body.amount || data.amount,
            paymentId: data.payment_id,
            statusUrl: '/api/payments/status/' + data.payment_id
          });
        }
      }).catch(()=>{});
    }
    return prom;
  };
})();
</script>
<script>
/* ============================================================
   RumaLink Provisioning Override v2
   - Clean 2-field modal (name + description) — network auto-generated
   - Two-step bootstrap command (download .rsc + import)
   - After router connects, discover ports and ask which to bridge (WAN excluded)
   ============================================================ */
(function(){
  let provToken = null, provDeviceId = null, provPoll = null, ifacePoll = null;

  // Replace the Add Device modal content with the clean version
  function injectModal(){
    const modal = document.getElementById('modal-device');
    if (!modal) return;
    const box = modal.querySelector('.modal');
    if (!box) return;
    box.innerHTML = `
      <h2 style="font-family:var(--font-head,inherit);margin-bottom:4px">Add MikroTik Device</h2>
      <p style="color:var(--muted,#888);font-size:.88rem;margin-bottom:16px">Network settings are generated automatically. Just name your device and paste one command.</p>

      <div id="rl-pstep1">
        <div class="form-group"><label>Device / Location Name *</label>
          <input id="rl-dev-name" type="text" placeholder="e.g. Main Router - Westlands"/></div>
        <div class="form-group"><label>Description (optional)</label>
          <input id="rl-dev-desc" type="text" placeholder="e.g. Covers Westlands estate"/></div>
        <div class="modal-actions">
          <button class="btn btn-outline" onclick="closeModal('modal-device')">Cancel</button>
          <button class="btn btn-teal" onclick="rlCreateDevice()">Generate Link →</button>
        </div>
      </div>

      <div id="rl-pstep2" style="display:none">
        <p style="color:var(--muted,#888);font-size:.86rem;margin-bottom:10px">Paste this into your MikroTik terminal (Winbox → New Terminal):</p>
        <div style="background:#0a0e1a;border:1px solid rgba(0,212,170,.2);border-radius:8px;padding:12px;font-family:monospace;font-size:.72rem;color:#00d4aa;word-break:break-all;position:relative;margin-bottom:12px">
          <span id="rl-prov-cmd">Generating…</span>
          <button class="btn btn-sm" style="position:absolute;top:8px;right:8px" onclick="rlCopyCmd()">Copy</button>
        </div>
        <div style="display:flex;align-items:center;gap:10px;padding:12px;background:rgba(243,156,18,.06);border-radius:8px">
          <div class="spinner" style="width:20px;height:20px;border:3px solid rgba(243,156,18,.2);border-top-color:#f39c12;border-radius:50%;animation:rlspin 1s linear infinite"></div>
          <div style="font-size:.84rem">Waiting for your router to connect…</div>
        </div>
        <div class="modal-actions"><button class="btn btn-outline" onclick="rlCloseProv()">Close (finish later)</button></div>
      </div>

      <div id="rl-pstep3" style="display:none">
        <p style="color:#00d4aa;font-weight:600;margin-bottom:6px">✓ Router connected!</p>
        <p style="color:var(--muted,#888);font-size:.86rem;margin-bottom:12px">Select which ports to use for the hotspot/PPPoE LAN. The WAN port (your internet source) is excluded automatically.</p>
        <div id="rl-port-list" style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px"></div>
        <div class="modal-actions">
          <button class="btn btn-outline" onclick="rlCloseProv()">Skip (use all)</button>
          <button class="btn btn-teal" onclick="rlSaveBridgePorts()">Apply Ports →</button>
        </div>
      </div>

      <div id="rl-pstep4" style="display:none">
        <div style="text-align:center;padding:20px 0">
          <div style="font-size:3rem">✅</div>
          <h3 style="margin:8px 0">Device Ready!</h3>
          <p style="color:var(--muted,#888);font-size:.88rem">Your MikroTik is provisioned and managed by RumaLink.</p>
        </div>
        <div class="modal-actions"><button class="btn btn-teal" onclick="rlCloseProv(); (window.loadDevices&&loadDevices())">View Devices</button></div>
      </div>
    `;
    if (!document.getElementById('rl-spin-style')) {
      const st = document.createElement('style'); st.id='rl-spin-style';
      st.textContent='@keyframes rlspin{to{transform:rotate(360deg)}}';
      document.head.appendChild(st);
    }
  }

  window.rlCreateDevice = async function(){
    const name = document.getElementById('rl-dev-name').value.trim();
    if (!name) { (window.toast||alert)('Enter a device name','error'); return; }
    try {
      const d = await api('/nas/', { method:'POST', body: JSON.stringify({ name, description: document.getElementById('rl-dev-desc').value }) });
      provToken = d.device?.provision_token || d.provision_token;
      provDeviceId = d.device?.id || d.id;
      const base = (d.provision_url || (location.origin + '/api/provision/' + provToken)).replace(/\/script$/,'');
      const cmd = `/tool fetch url="${base}/script" mode=https dst-path=rumalink-setup.rsc; :delay 2s; /import file-name=rumalink-setup.rsc`;
      document.getElementById('rl-prov-cmd').textContent = cmd;
      document.getElementById('rl-pstep1').style.display='none';
      document.getElementById('rl-pstep2').style.display='';
      provPoll = setInterval(rlCheckConnected, 4000);
    } catch(e){ (window.toast||alert)(e.message||'Failed','error'); }
  };

  window.rlCheckConnected = async function(){
    try {
      const d = await api('/nas/');
      const dev = (d.devices||[]).find(x => x.provision_token === provToken);
      if (dev && dev.is_provisioned) {
        clearInterval(provPoll);
        // Move to port selection — poll for discovered interfaces
        document.getElementById('rl-pstep2').style.display='none';
        document.getElementById('rl-pstep3').style.display='';
        rlLoadPorts();
      }
    } catch(e){}
  };

  window.rlLoadPorts = async function(){
    const listEl = document.getElementById('rl-port-list');
    listEl.innerHTML = '<div style="color:#888;font-size:.84rem">Detecting router ports…</div>';
    let tries = 0;
    ifacePoll = setInterval(async () => {
      tries++;
      try {
        const res = await fetch(`/api/provision/${provToken}/interfaces`, { cache:'no-store' });
        const d = await res.json();
        if (d.discovered && d.bridge_candidates && d.bridge_candidates.length) {
          clearInterval(ifacePoll);
          listEl.innerHTML = d.bridge_candidates.map(p =>
            `<label style="display:flex;align-items:center;gap:8px;padding:8px;background:rgba(255,255,255,.03);border-radius:6px;cursor:pointer">
              <input type="checkbox" class="rl-port" value="${p}" checked/> <span>${p}</span>
            </label>`).join('') +
            `<div style="font-size:.76rem;color:#888;margin-top:4px">WAN port <b>${d.wan}</b> excluded (your internet source)</div>`;
        } else if (tries > 8) {
          // Discovery didn't report (older router script) — let them proceed with auto
          clearInterval(ifacePoll);
          listEl.innerHTML = '<div style="color:#888;font-size:.84rem">Auto-detected: all LAN ports will be bridged (WAN excluded automatically).</div>';
        }
      } catch(e){ if (tries>8){ clearInterval(ifacePoll); listEl.innerHTML='<div style="color:#888;font-size:.84rem">Using automatic port selection.</div>'; } }
    }, 3000);
  };

  window.rlSaveBridgePorts = async function(){
    const ports = Array.from(document.querySelectorAll('.rl-port:checked')).map(c=>c.value);
    try {
      if (ports.length) {
        await fetch(`/api/provision/${provToken}/set-bridge-ports`, {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ports: ports.join(',') })
        });
        (window.toast||alert)('Ports applied! Re-run the import command on your router to apply.','success');
      }
    } catch(e){}
    document.getElementById('rl-pstep3').style.display='none';
    document.getElementById('rl-pstep4').style.display='';
  };

  window.rlCopyCmd = function(){ navigator.clipboard.writeText(document.getElementById('rl-prov-cmd').textContent); (window.toast||alert)('Copied!','success'); };
  window.rlCloseProv = function(){ if(provPoll)clearInterval(provPoll); if(ifacePoll)clearInterval(ifacePoll); closeModal('modal-device'); resetProv(); };
  function resetProv(){ ['rl-pstep1'].forEach(i=>{const e=document.getElementById(i);if(e)e.style.display='';}); ['rl-pstep2','rl-pstep3','rl-pstep4'].forEach(i=>{const e=document.getElementById(i);if(e)e.style.display='none';}); }

  // Override openAddDevice to use our modal
  const origOpen = window.openAddDevice;
  window.openAddDevice = function(){ injectModal(); resetProv(); if(window.openModal) openModal('modal-device'); };

  // Inject on load
  if (document.readyState !== 'loading') injectModal();
  else document.addEventListener('DOMContentLoaded', injectModal);
})();
</script>





<script>
/* RumaLink Provisioning Override v3 — standalone (no apiFetch dependency) */
(function(){
  let provToken=null, provDeviceId=null, provPoll=null, ifacePoll=null;

  // Self-contained fetch with auth (works even when dashboard's apiFetch isn't global)
  function getToken(){ return localStorage.getItem('rl_token') || window.token || ''; }
  function apiBase(){ return (location.origin || 'https://rumalinkenterprise.online') + '/api'; }
  async function rlApi(path, opts){
    opts = opts || {};
    const res = await fetch(apiBase() + path, Object.assign({}, opts, {
      headers: Object.assign({
        'Content-Type':'application/json',
        'Authorization':'Bearer ' + getToken()
      }, opts.headers || {})
    }));
    const text = await res.text();
    let json = {}; try { json = JSON.parse(text); } catch(e){}
    if (!res.ok) throw new Error(json.error || text || ('HTTP ' + res.status));
    return json;
  }

  function injectModal(){
    const modal = document.getElementById('modal-device');
    if (!modal) return;
    const box = modal.querySelector('.modal') || modal.querySelector('.modal-content') || modal.firstElementChild;
    if (!box) return;
    box.innerHTML = `
      <h2 style="margin-bottom:4px">Add MikroTik Device</h2>
      <p style="color:#888;font-size:.88rem;margin-bottom:16px">Network settings are generated automatically. Just name your device and paste one command.</p>

      <div id="rl-pstep1">
        <div class="form-group" style="margin-bottom:12px">
          <label style="display:block;margin-bottom:4px">Device / Location Name *</label>
          <input id="rl-dev-name" type="text" placeholder="e.g. Main Router - Westlands" style="width:100%;padding:10px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.05);color:inherit;border-radius:6px;box-sizing:border-box"/>
        </div>
        <div class="form-group" style="margin-bottom:12px">
          <label style="display:block;margin-bottom:4px">Description (optional)</label>
          <input id="rl-dev-desc" type="text" placeholder="e.g. Covers Westlands estate" style="width:100%;padding:10px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.05);color:inherit;border-radius:6px;box-sizing:border-box"/>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
          <button class="btn btn-outline" onclick="(window.closeModal&&closeModal('modal-device'))||document.getElementById('modal-device').classList.remove('open')">Cancel</button>
          <button class="btn btn-teal" style="background:#00d4aa;color:#0d1530;border:none;padding:10px 20px;border-radius:6px;font-weight:600;cursor:pointer" onclick="rlCreateDevice()">Generate Link →</button>
        </div>
      </div>

      <div id="rl-pstep2" style="display:none">
        <p style="color:#888;font-size:.86rem;margin-bottom:10px">Paste this into your MikroTik terminal (Winbox → New Terminal):</p>
        <div style="background:#0a0e1a;border:1px solid rgba(0,212,170,.2);border-radius:8px;padding:12px;font-family:monospace;font-size:.72rem;color:#00d4aa;word-break:break-all;position:relative;margin-bottom:12px">
          <span id="rl-prov-cmd">Generating…</span>
          <button style="position:absolute;top:8px;right:8px;background:#00d4aa;color:#0d1530;border:none;padding:4px 10px;border-radius:4px;cursor:pointer;font-size:.7rem;font-weight:600" onclick="rlCopyCmd()">Copy</button>
        </div>
        <div style="display:flex;align-items:center;gap:10px;padding:12px;background:rgba(243,156,18,.06);border-radius:8px">
          <div style="width:20px;height:20px;border:3px solid rgba(243,156,18,.2);border-top-color:#f39c12;border-radius:50%;animation:rlspin 1s linear infinite"></div>
          <div style="font-size:.84rem">Waiting for your router to connect…</div>
        </div>
        <div style="text-align:right;margin-top:12px"><button class="btn btn-outline" onclick="rlCloseProv()">Close (finish later)</button></div>
      </div>

      <div id="rl-pstep3" style="display:none">
        <p style="color:#00d4aa;font-weight:600;margin-bottom:6px">✓ Router connected!</p>
        <p style="color:#888;font-size:.86rem;margin-bottom:12px">Select which ports to use for the hotspot LAN. The WAN port (your internet source) is excluded automatically.</p>
        <div id="rl-port-list" style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px"></div>
        <div style="display:flex;gap:8px;justify-content:flex-end">
          <button class="btn btn-outline" onclick="rlCloseProv()">Skip</button>
          <button class="btn btn-teal" style="background:#00d4aa;color:#0d1530;border:none;padding:10px 20px;border-radius:6px;font-weight:600;cursor:pointer" onclick="rlSaveBridgePorts()">Apply Ports →</button>
        </div>
      </div>

      <div id="rl-pstep4" style="display:none">
        <div style="text-align:center;padding:20px 0">
          <div style="font-size:3rem">✅</div>
          <h3 style="margin:8px 0">Device Ready!</h3>
          <p style="color:#888;font-size:.88rem">Your MikroTik is provisioned and managed by RumaLink.</p>
        </div>
        <div style="text-align:right"><button class="btn btn-teal" style="background:#00d4aa;color:#0d1530;border:none;padding:10px 20px;border-radius:6px;font-weight:600;cursor:pointer" onclick="rlCloseProv(); window.loadDevices&&loadDevices()">View Devices</button></div>
      </div>
    `;
    if (!document.getElementById('rl-spin-style')) {
      const st = document.createElement('style'); st.id='rl-spin-style';
      st.textContent='@keyframes rlspin{to{transform:rotate(360deg)}}';
      document.head.appendChild(st);
    }
  }

  window.rlCreateDevice = async function(){
    const name = document.getElementById('rl-dev-name').value.trim();
    if (!name) { (window.toast||alert)('Enter a device name'); return; }
    try {
      const d = await rlApi('/nas/', { method:'POST', body: JSON.stringify({ name, description: document.getElementById('rl-dev-desc').value }) });
      provToken = d.device?.provision_token || d.provision_token;
      provDeviceId = d.device?.id || d.id;
      // Build the two-step bootstrap command pointing at /script
      const base = (d.provision_url || (location.origin + '/api/provision/' + provToken)).replace(/\/script$/,'');
      const cmd = `/tool fetch url="${base}/script" mode=https dst-path=rumalink-setup.rsc; :delay 2s; /import file-name=rumalink-setup.rsc`;
      document.getElementById('rl-prov-cmd').textContent = cmd;
      document.getElementById('rl-pstep1').style.display='none';
      document.getElementById('rl-pstep2').style.display='';
      provPoll = setInterval(rlCheckConnected, 4000);
    } catch(e){ (window.toast||alert)('Failed: ' + e.message); }
  };

  window.rlCheckConnected = async function(){
    try {
      const d = await rlApi('/nas/');
      const dev = (d.devices||[]).find(x => x.provision_token === provToken);
      if (dev && dev.is_provisioned) {
        clearInterval(provPoll);
        document.getElementById('rl-pstep2').style.display='none';
        document.getElementById('rl-pstep3').style.display='';
        rlLoadPorts();
      }
    } catch(e){}
  };

  window.rlLoadPorts = async function(){
    const listEl = document.getElementById('rl-port-list');
    listEl.innerHTML = '<div style="color:#888;font-size:.84rem">Detecting router ports…</div>';
    let tries = 0;
    ifacePoll = setInterval(async () => {
      tries++;
      try {
        const res = await fetch('/api/provision/' + provToken + '/interfaces', { cache:'no-store' });
        const d = await res.json();
        if (d.discovered && d.bridge_candidates && d.bridge_candidates.length) {
          clearInterval(ifacePoll);
          listEl.innerHTML = d.bridge_candidates.map(p =>
            `<label style="display:flex;align-items:center;gap:8px;padding:8px;background:rgba(255,255,255,.03);border-radius:6px;cursor:pointer">
              <input type="checkbox" class="rl-port" value="${p}" checked/> <span>${p}</span>
            </label>`).join('') +
            `<div style="font-size:.76rem;color:#888;margin-top:4px">WAN port <b>${d.wan}</b> excluded (your internet source)</div>`;
        } else if (tries > 8) {
          clearInterval(ifacePoll);
          listEl.innerHTML = '<div style="color:#888;font-size:.84rem">Auto-detected: all LAN ports will be bridged (WAN excluded).</div>';
        }
      } catch(e){ if (tries>8){ clearInterval(ifacePoll); listEl.innerHTML='<div style="color:#888;font-size:.84rem">Using automatic port selection.</div>'; } }
    }, 3000);
  };

  window.rlSaveBridgePorts = async function(){
    const ports = Array.from(document.querySelectorAll('.rl-port:checked')).map(c=>c.value);
    try {
      if (ports.length) {
        await fetch('/api/provision/' + provToken + '/set-bridge-ports', {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ports: ports.join(',') })
        });
        (window.toast||function(m){console.log(m);})('Ports applied! Re-run import on router to apply changes.');
      }
    } catch(e){}
    document.getElementById('rl-pstep3').style.display='none';
    document.getElementById('rl-pstep4').style.display='';
  };

  window.rlCopyCmd = function(){
    navigator.clipboard.writeText(document.getElementById('rl-prov-cmd').textContent);
    (window.toast||function(m){console.log(m);})('Copied!');
  };
  window.rlCloseProv = function(){
    if(provPoll)clearInterval(provPoll); if(ifacePoll)clearInterval(ifacePoll);
    if(window.closeModal) closeModal('modal-device');
    else document.getElementById('modal-device').classList.remove('open');
    ['rl-pstep1'].forEach(i=>{const e=document.getElementById(i);if(e)e.style.display='';});
    ['rl-pstep2','rl-pstep3','rl-pstep4'].forEach(i=>{const e=document.getElementById(i);if(e)e.style.display='none';});
  };

  window.openAddDevice = function(){
    injectModal();
    if(window.openModal) openModal('modal-device');
    else document.getElementById('modal-device').classList.add('open');
  };

  if (document.readyState !== 'loading') injectModal();
  else document.addEventListener('DOMContentLoaded', injectModal);
})();
</script>






<script>
/* === RumaLink Device Detail Modal v6 — strict click filtering === */
(function(){
  if (window.__rlDevDetailV6) return;
  window.__rlDevDetailV6 = true;
  console.log('[RL-DeviceDetail-v6] loaded');

  function getToken(){ return localStorage.getItem('rl_token') || window.token || ''; }
  async function api(path, opts){
    opts = opts || {};
    var r = await fetch('/api' + path, Object.assign({
      headers: { 'Authorization': 'Bearer ' + getToken(), 'Content-Type': 'application/json' }
    }, opts));
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  }
  function fmtBytes(b){ if(!b||b<=0) return '—'; if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(1)+' KB'; if(b<1073741824) return (b/1048576).toFixed(1)+' MB'; return (b/1073741824).toFixed(2)+' GB'; }
  function fmtMB(mb){ if(!mb||mb<=0) return '—'; if(mb<1024) return mb+' MB'; return (mb/1024).toFixed(1)+' GB'; }
  function fmtUptime(s){ if(!s)return '—'; var d=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60); return (d?d+'d ':'')+(h?h+'h ':'')+m+'m'; }
  function bar(used,total,color){ var pct = total ? Math.min(100, Math.round(used/total*100)) : 0; return '<div style="background:rgba(255,255,255,.05);height:8px;border-radius:4px;overflow:hidden;margin-top:4px"><div style="background:'+color+';width:'+pct+'%;height:100%"></div></div><div style="font-size:.72rem;color:#888;margin-top:2px">'+fmtMB(used)+' / '+fmtMB(total)+' ('+pct+'%)</div>'; }

  var devicesInOrder = [];

  async function refreshDevices() {
    try {
      var d = await api('/nas/');
      devicesInOrder = d.devices || [];
      tagCards();
    } catch(e) { console.warn('[RL-DeviceDetail-v6] fetch failed:', e.message); }
  }

  function tagCards() {
    var cards = document.querySelectorAll('.device-card');
    cards.forEach(function(card, idx){
      var dev = devicesInOrder[idx];
      if (!dev || !dev.id) return;
      card.setAttribute('data-device-id', dev.id);
      card.style.cursor = 'pointer';
    });
  }

  window.rlTestTunnel = async function(deviceId, buttonEl) {
    var resultEl = document.getElementById('rl-tunnel-result');
    if (resultEl) { resultEl.style.display = 'block'; resultEl.innerHTML = '<span style="color:#888">Testing tunnel via 10.8.0.x...</span>'; }
    if (buttonEl) { buttonEl.disabled = true; buttonEl.textContent = 'Testing…'; }
    try {
      var r = await api('/nas/' + deviceId + '/test-tunnel');
      if (r.ok) {
        if (resultEl) resultEl.innerHTML = '<div style="background:rgba(46,204,113,.12);border:1px solid rgba(46,204,113,.3);color:#2ecc71;padding:10px 14px;border-radius:8px;font-size:.85rem">✓ <strong>Tunnel OK</strong> — round-trip ' + r.latency_ms + 'ms via WG<br><span style="color:rgba(255,255,255,.6);font-size:.8rem">Board: ' + (r.board || '—') + ' • RouterOS ' + (r.version || '—') + ' • Uptime ' + (r.uptime || '—') + '</span></div>';
      } else {
        if (resultEl) resultEl.innerHTML = '<div style="background:rgba(231,76,60,.12);border:1px solid rgba(231,76,60,.3);color:#e74c3c;padding:10px 14px;border-radius:8px;font-size:.85rem">✗ <strong>Tunnel failed</strong>: ' + r.error + '</div>';
      }
    } catch(e) {
      if (resultEl) resultEl.innerHTML = '<div style="background:rgba(231,76,60,.12);border:1px solid rgba(231,76,60,.3);color:#e74c3c;padding:10px 14px;border-radius:8px;font-size:.85rem">✗ ' + e.message + '</div>';
    }
    if (buttonEl) { buttonEl.disabled = false; buttonEl.textContent = 'Test Tunnel'; }
  };

  window.rlLoadLiveSessions = async function(deviceId) {
    var box = document.getElementById('rl-live-sessions-body');
    if (!box) return;
    box.innerHTML = '<div style="text-align:center;padding:14px;color:#888;font-size:.85rem">Querying router…</div>';
    try {
      var r = await api('/nas/' + deviceId + '/live-sessions');
      if (!r.sessions || !r.sessions.length) {
        box.innerHTML = '<div style="text-align:center;padding:14px;color:#888;font-size:.85rem">No active hotspot sessions on router</div>';
        return;
      }
      box.innerHTML = r.sessions.map(function(s){
        return '<div style="padding:10px;border-bottom:1px solid rgba(255,255,255,.05);display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:.83rem">'
             + '<div><div style="font-family:monospace;color:#00d4aa">' + (s.user || '—') + '</div>'
             +   '<div style="color:#888;font-size:.72rem">' + (s.mac_address || '') + ' • ' + (s.address || '') + ' • ' + (s.uptime || '') + '</div></div>'
             + '<div style="text-align:right">'
             +   '<div style="font-size:.78rem">↓' + fmtBytes(s.bytes_in) + ' ↑' + fmtBytes(s.bytes_out) + '</div>'
             +   '<button onclick="rlKickSession(\'' + deviceId + '\', \'' + s.id + '\')" style="background:rgba(231,76,60,.15);color:#e74c3c;border:1px solid rgba(231,76,60,.3);padding:3px 10px;border-radius:5px;font-size:.72rem;cursor:pointer;margin-top:3px">Kick</button>'
             + '</div></div>';
      }).join('');
    } catch(e) {
      box.innerHTML = '<div style="text-align:center;padding:14px;color:#e74c3c;font-size:.82rem">Failed: ' + e.message + '</div>';
    }
  };

  window.rlKickSession = async function(deviceId, sessionId) {
    if (!confirm('Disconnect this user from WiFi?')) return;
    try {
      await api('/nas/' + deviceId + '/disconnect-session/' + encodeURIComponent(sessionId), { method: 'POST' });
      rlLoadLiveSessions(deviceId);
    } catch(e) { alert('Failed: ' + e.message); }
  };

  window.rlOpenDeviceDetail = async function(deviceId){
    if (!deviceId || deviceId === 'undefined') return;
    var modal = document.getElementById('rl-dd');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'rl-dd';
      modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:99998;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)';
      modal.innerHTML = '<div id="rl-dd-box" style="background:#0d1530;border:1px solid rgba(0,212,170,.25);border-radius:14px;padding:24px;max-width:620px;width:100%;max-height:88vh;overflow-y:auto;color:#fff;font-family:sans-serif"></div>';
      modal.addEventListener('click', function(e){ if(e.target===modal) modal.remove(); });
      document.body.appendChild(modal);
    }
    var box = document.getElementById('rl-dd-box');
    box.innerHTML = '<div style="text-align:center;padding:40px;color:#888">Loading…</div>';
    try {
      var data = await api('/nas/' + deviceId);
      var d = data.device || {}, s = data.sessions || {};
      var online = d.is_online, cpu = d.cpu_load || 0;
      var lastSeen = d.last_seen ? new Date(d.last_seen).toLocaleString() : 'never';
      var wgHandshake = d.wg_last_handshake_seconds || 0;
      var hsOk = wgHandshake > 0 && wgHandshake < 180;
      var wgChip = d.wireguard_ip
        ? '<span style="padding:4px 10px;border-radius:12px;font-size:.78rem;background:'+(hsOk?'rgba(0,212,170,.15);color:#00d4aa':'rgba(243,156,18,.15);color:#f39c12')+'">WG: '+d.wireguard_ip+(hsOk?' ✓':' (no HS)')+'</span>'
        : '';
      box.innerHTML =
        '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">'
        +   '<div><h2 style="margin:0">'+(d.name||'Device')+'</h2><div style="color:#888;font-size:.85rem;margin-top:2px">'+(d.description||'')+'</div></div>'
        +   '<button onclick="document.getElementById(\'rl-dd\').remove()" style="background:none;border:none;color:#888;font-size:1.4rem;cursor:pointer">×</button>'
        + '</div>'
        + '<div style="display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap">'
        +   '<span style="padding:4px 10px;border-radius:12px;font-size:.78rem;background:'+(online?'rgba(0,212,170,.15);color:#00d4aa':'rgba(231,76,60,.15);color:#e74c3c')+'">'+(online?'● Online':'● Offline')+'</span>'
        +   '<span style="padding:4px 10px;border-radius:12px;font-size:.78rem;background:rgba(255,255,255,.06);color:#aaa">Last seen: '+lastSeen+'</span>'
        +   wgChip
        + '</div>'
        + (d.wireguard_ip ?
            '<div style="background:rgba(0,212,170,.04);border:1px solid rgba(0,212,170,.18);padding:14px;border-radius:10px;margin-bottom:18px">'
            + '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px">'
            +   '<div><h3 style="margin:0;font-size:.95rem">🔌 Live Tunnel Test</h3><div style="font-size:.74rem;color:#888;margin-top:2px">Direct REST call to router via WireGuard</div></div>'
            +   '<button onclick="rlTestTunnel(\''+deviceId+'\', this)" style="background:#00d4aa;color:#0d1530;border:none;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:600;font-size:.85rem">Test Tunnel</button>'
            + '</div><div id="rl-tunnel-result" style="display:none"></div></div>'
          : '')
        + '<h3 style="font-size:.9rem;margin:0 0 10px;color:#aaa;text-transform:uppercase;letter-spacing:.5px">Performance</h3>'
        + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px">'
        +   '<div style="background:rgba(255,255,255,.03);padding:12px;border-radius:8px"><div style="font-size:.78rem;color:#888">CPU Load</div><div style="font-size:1.4rem;font-weight:600;color:'+(cpu>80?'#e74c3c':cpu>50?'#f39c12':'#00d4aa')+'">'+cpu+'%</div><div style="background:rgba(255,255,255,.05);height:8px;border-radius:4px;overflow:hidden;margin-top:6px"><div style="background:'+(cpu>80?'#e74c3c':cpu>50?'#f39c12':'#00d4aa')+';width:'+cpu+'%;height:100%"></div></div></div>'
        +   '<div style="background:rgba(255,255,255,.03);padding:12px;border-radius:8px"><div style="font-size:.78rem;color:#888">Uptime</div><div style="font-size:1.4rem;font-weight:600;color:#00d4aa">'+fmtUptime(d.uptime_seconds)+'</div></div>'
        +   '<div style="background:rgba(255,255,255,.03);padding:12px;border-radius:8px"><div style="font-size:.78rem;color:#888">Memory</div>'+bar(d.memory_used_mb||0,d.memory_total_mb||0,'#00d4aa')+'</div>'
        +   '<div style="background:rgba(255,255,255,.03);padding:12px;border-radius:8px"><div style="font-size:.78rem;color:#888">Storage</div>'+bar(d.disk_used_mb||0,d.disk_total_mb||0,'#3498db')+'</div>'
        + '</div>'
        + (d.wireguard_ip ?
            '<div style="display:flex;justify-content:space-between;align-items:center;margin:0 0 10px"><h3 style="font-size:.9rem;margin:0;color:#aaa;text-transform:uppercase;letter-spacing:.5px">Live Hotspot Sessions (from router)</h3><button onclick="rlLoadLiveSessions(\''+deviceId+'\')" style="background:rgba(255,255,255,.05);color:#aaa;border:1px solid rgba(255,255,255,.1);padding:4px 10px;border-radius:5px;font-size:.72rem;cursor:pointer">Refresh</button></div>'
            + '<div id="rl-live-sessions-body" style="background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.05);border-radius:8px;min-height:48px;margin-bottom:18px"></div>'
          : '')
        + '<h3 style="font-size:.9rem;margin:0 0 10px;color:#aaa;text-transform:uppercase;letter-spacing:.5px">Router Info</h3>'
        + '<div style="background:rgba(255,255,255,.03);padding:12px;border-radius:8px;font-size:.84rem;line-height:1.7">'
        +   '<div><span style="color:#888">Identity:</span> '+(d.mikrotik_identity||'—')+'</div>'
        +   '<div><span style="color:#888">Board:</span> '+(d.mikrotik_board||'—')+'</div>'
        +   '<div><span style="color:#888">RouterOS:</span> '+(d.mikrotik_version||'—')+'</div>'
        +   '<div><span style="color:#888">MAC:</span> '+(d.mikrotik_mac||'—')+'</div>'
        +   '<div><span style="color:#888">WAN IP:</span> '+(d.wan_ip||'—')+'</div>'
        +   '<div><span style="color:#888">Hotspot Net:</span> '+(d.hotspot_network||'—')+'</div>'
        +   '<div><span style="color:#888">WG IP:</span> '+(d.wireguard_ip||'—')+'</div>'
        + '</div>'
        + '<div style="text-align:right;margin-top:16px">'
        +   '<button onclick="document.getElementById(\'rl-dd\').remove()" style="background:rgba(255,255,255,.05);color:#fff;border:1px solid rgba(255,255,255,.15);padding:8px 16px;border-radius:6px;cursor:pointer">Close</button>'
        +   '<button onclick="rlOpenDeviceDetail(\''+deviceId+'\')" style="background:#00d4aa;color:#0d1530;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-weight:600;margin-left:8px">Refresh</button>'
        + '</div>';
      if (d.wireguard_ip) setTimeout(function(){ rlLoadLiveSessions(deviceId); }, 200);
    } catch(e) {
      box.innerHTML = '<div style="color:#e74c3c;text-align:center;padding:30px">Failed: '+e.message+'</div>';
    }
  };

  // ─── STRICT click filtering ───
  // Only fire device detail when click target itself is the .device-card OR a NON-INTERACTIVE
  // descendant (text/icon/etc). Buttons, links, inputs, [onclick], and elements inside the
  // dashboard nav/sidebar are ignored.
  document.addEventListener('click', function(e){
    var t = e.target;

    // Bail if click is on or inside an interactive element
    if (t.closest('button, a, input, select, textarea, label, [onclick], [contenteditable]')) {
      return;
    }
    // Bail if click is inside an existing modal/dialog
    if (t.closest('.modal, [role="dialog"], #rl-dd, #rl-pm, #rl-lp')) {
      return;
    }
    // Bail if click target has explicit handler
    if (t.hasAttribute('onclick') || t.hasAttribute('data-page')) {
      return;
    }

    // Only proceed if we're inside a .device-card on the DEVICES page
    var card = t.closest('.device-card');
    if (!card) return;
    // Ensure we're on the devices page (not an accidental matching element elsewhere)
    var page = card.closest('#page-devices, [id="page-devices"]');
    if (!page) return;  // STRICT: only on devices page

    var id = card.getAttribute('data-device-id');
    if (id && id !== 'undefined') {
      e.preventDefault();
      rlOpenDeviceDetail(id);
      return;
    }
    var allCards = Array.from(page.querySelectorAll('.device-card'));
    var idx = allCards.indexOf(card);
    if (idx >= 0 && devicesInOrder[idx]) {
      e.preventDefault();
      rlOpenDeviceDetail(devicesInOrder[idx].id);
    } else {
      refreshDevices().then(function(){
        var rc = Array.from(page.querySelectorAll('.device-card'));
        var ri = rc.indexOf(card);
        if (ri >= 0 && devicesInOrder[ri]) rlOpenDeviceDetail(devicesInOrder[ri].id);
      });
    }
  });

  var obs = new MutationObserver(function(mutations){
    var has = false;
    mutations.forEach(function(m){ m.addedNodes.forEach(function(n){ if (n.nodeType === 1 && (n.classList?.contains('device-card') || n.querySelector?.('.device-card'))) has = true; }); });
    if (has) refreshDevices();
  });
  obs.observe(document.body, { childList: true, subtree: true });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', refreshDevices);
  else refreshDevices();

  document.addEventListener('click', function(e){
    if (e.target.closest('[data-page="devices"]')) setTimeout(refreshDevices, 600);
  });
})();
</script>




<script>
/* === RumaLink Dashboard Complete v4 — payment from + package edit + payment detail === */
(function(){
  if (window.__rlDashV4) return;
  window.__rlDashV4 = true;
  console.log('[RL-Dash-v4] loaded');

  function getToken(){ return localStorage.getItem('rl_token') || window.token || ''; }
  async function api(path, opts){
    opts = opts || {};
    var r = await fetch('/api' + path, Object.assign({
      headers: { 'Authorization': 'Bearer ' + getToken(), 'Content-Type': 'application/json' }
    }, opts));
    if (!r.ok) {
      var t = await r.text().catch(function(){return '';});
      throw new Error('HTTP ' + r.status + ': ' + t);
    }
    return r.json();
  }
  function kes(n){ return 'KES ' + Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function dts(s){ if(!s)return '—'; try{ return new Date(s).toLocaleString(); }catch(e){ return '—'; } }
  function esc(s){ return String(s||'').replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }

  // ─── 1. PAYMENTS list: from = payer_phone first ──────────────────────────
  window.payPage = window.payPage || 1;
  window.payPageSize = window.payPageSize || 20;
  window.payTotal = window.payTotal || 0;
  window.payUpdatePagination = function() {
    var info = document.getElementById('pay-page-info');
    var prev = document.getElementById('pay-prev');
    var next = document.getElementById('pay-next');
    var sel = document.getElementById('pay-page-size');
    if (sel && String(sel.value) !== String(window.payPageSize)) sel.value = window.payPageSize;
    var total = window.payTotal || 0, size = window.payPageSize || 20, page = window.payPage || 1;
    var start = total === 0 ? 0 : ((page - 1) * size) + 1;
    var end = Math.min(page * size, total);
    if (info) info.textContent = total === 0 ? 'No payments' : (start + '\u2013' + end + ' of ' + total);
    var atStart = page <= 1, atEnd = (page * size) >= total;
    if (prev) { prev.disabled = atStart; prev.style.opacity = atStart ? '.4' : '1'; prev.style.cursor = atStart ? 'not-allowed' : 'pointer'; }
    if (next) { next.disabled = atEnd; next.style.opacity = atEnd ? '.4' : '1'; next.style.cursor = atEnd ? 'not-allowed' : 'pointer'; }
  };
  window.payChangePageSize = function(v) { window.payPageSize = parseInt(v) || 20; window.payPage = 1; if (window.loadPayments) window.loadPayments(); };
  window.payPrevPage = function() { if ((window.payPage||1) > 1) { window.payPage--; if (window.loadPayments) window.loadPayments(); } };
  window.payNextPage = function() { if (((window.payPage||1) * (window.payPageSize||20)) < (window.payTotal||0)) { window.payPage++; if (window.loadPayments) window.loadPayments(); } };
  async function loadPaymentsForced() {
    var tbody = document.getElementById('payments-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#888">Loading…</td></tr>';
    try {
      var d = await api('/payments?status=paid&page=' + (window.payPage||1) + '&limit=' + (window.payPageSize||20));
      var payments = d.payments || [];
      window.payTotal = (typeof d.total === 'number') ? d.total : payments.length;
      window.payUpdatePagination();
      console.log('[RL-Dash-v4] payments received:', payments.length, 'sample:', payments[0]);
      if (!payments.length) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#888">No payments yet</td></tr>';
        return;
      }
      tbody.innerHTML = payments.map(function(p){
        var from = p.payer_phone || p.mpesa_phone || p.phone_number
                || p.subscriber_name || p.subscriber_username
                || p.voucher_code || '—';
        var method = (p.method_display || p.payment_method || p.payment_gateway || 'mpesa_stk');
        method = String(method).toUpperCase().replace(/_/g, ' ');
        var statusClass = p.status==='paid'?'badge-green':p.status==='pending'?'badge-amber':'badge-red';
        return '<tr data-payment-id="' + esc(p.id) + '" style="cursor:pointer">'
          + '<td class="name">' + esc(p.subscriber_username || p.voucher_code || '\u2014') + '</td>'
          + '<td style="font-family:monospace">' + esc(from) + '</td>'
          + '<td style="color:#00d4aa;font-weight:600">' + kes(p.amount) + '</td>'
          + '<td><span class="badge badge-green">' + esc(method) + '</span></td>'
          + '<td><span class="badge ' + statusClass + '">' + esc(p.status) + '</span></td>'
          + '<td>' + dts(p.created_at) + '</td>'
          + '</tr>';
      }).join('');
    } catch(e) {
      console.error('[RL-Dash-v4] loadPayments failed:', e);
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#e74c3c">Failed: ' + esc(e.message) + '</td></tr>';
    }
  }

  function forceOverridePayments() {
    window.loadPayments = loadPaymentsForced;
  }
  forceOverridePayments();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', forceOverridePayments);
  setTimeout(forceOverridePayments, 100);
  setTimeout(forceOverridePayments, 1000);
  setTimeout(forceOverridePayments, 3000);

  // ─── 2. PACKAGE EDIT MODAL ────────────────────────────────────────────────
  function openPackageEditor(pkg) {
    var existing = document.getElementById('rl-pkg-mod');
    if (existing) existing.remove();
    var m = document.createElement('div');
    m.id = 'rl-pkg-mod';
    m.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:99998;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)';
    m.innerHTML = ''
      + '<div style="background:#0d1530;border:1px solid rgba(0,212,170,.25);border-radius:14px;padding:24px;max-width:540px;width:100%;max-height:88vh;overflow-y:auto;color:#fff;font-family:sans-serif">'
      + '  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px"><h2 style="margin:0">📦 Edit Package</h2><button onclick="document.getElementById(\'rl-pkg-mod\').remove()" style="background:none;border:none;color:#888;font-size:1.4rem;cursor:pointer">×</button></div>'
      + '  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">'
      + '    <label style="grid-column:1/-1"><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Name</div><input id="pk-name" value="' + esc(pkg.name||'') + '" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label style="grid-column:1/-1"><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Description</div><input id="pk-desc" value="' + esc(pkg.description||'') + '" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Price (KES)</div><input id="pk-price" type="number" step="0.01" value="' + (pkg.price||0) + '" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Duration (hours)</div><input id="pk-hours" type="number" value="' + (pkg.duration_hours||'') + '" placeholder="empty=unlimited" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Down (Mbps)</div><input id="pk-down" type="number" value="' + (pkg.bandwidth_down_mbps||'') + '" placeholder="empty=unlimited" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Up (Mbps)</div><input id="pk-up" type="number" value="' + (pkg.bandwidth_up_mbps||'') + '" placeholder="empty=unlimited" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Data Limit (MB)</div><input id="pk-data" type="number" value="' + (pkg.data_limit_mb||'') + '" placeholder="empty=unlimited" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Simultaneous Sessions</div><input id="pk-sess" type="number" value="' + (pkg.simultaneous_sessions||1) + '" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"/></label>'
      + '    <label style="grid-column:1/-1"><div style="font-size:.78rem;color:#aaa;margin-bottom:4px">Status</div><select id="pk-active" style="width:100%;padding:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:8px;color:#fff;box-sizing:border-box"><option value="true"' + (pkg.is_active!==false?' selected':'') + '>Active</option><option value="false"' + (pkg.is_active===false?' selected':'') + '>Disabled</option></select></label>'
      + '  </div>'
      + '  <div id="pk-msg" style="display:none;margin-top:14px;padding:10px;border-radius:8px;font-size:.84rem"></div>'
      + '  <div style="text-align:right;margin-top:18px;display:flex;justify-content:flex-end;gap:8px">'
      + '    <button onclick="document.getElementById(\'rl-pkg-mod\').remove()" style="background:rgba(255,255,255,.05);color:#fff;border:1px solid rgba(255,255,255,.15);padding:9px 18px;border-radius:6px;cursor:pointer">Cancel</button>'
      + '    <button id="pk-save" style="background:#00d4aa;color:#0d1530;border:none;padding:9px 18px;border-radius:6px;cursor:pointer;font-weight:600">Save Changes</button>'
      + '  </div>'
      + '</div>';
    m.addEventListener('click', function(e){ if (e.target === m) m.remove(); });
    document.body.appendChild(m);

    document.getElementById('pk-save').addEventListener('click', async function(){
      var body = {
        name: document.getElementById('pk-name').value.trim(),
        description: document.getElementById('pk-desc').value.trim(),
        price: parseFloat(document.getElementById('pk-price').value) || 0,
        duration_hours: parseInt(document.getElementById('pk-hours').value) || null,
        bandwidth_down_mbps: parseInt(document.getElementById('pk-down').value) || null,
        bandwidth_up_mbps: parseInt(document.getElementById('pk-up').value) || null,
        data_limit_mb: parseInt(document.getElementById('pk-data').value) || null,
        simultaneous_sessions: parseInt(document.getElementById('pk-sess').value) || 1,
        is_active: document.getElementById('pk-active').value === 'true'
      };
      var btn = this;
      btn.disabled = true; btn.textContent = 'Saving…';
      var msgEl = document.getElementById('pk-msg');
      try {
        await api('/hotspot/packages/' + pkg.id, { method: 'PUT', body: JSON.stringify(body) });
        msgEl.style.cssText = 'display:block;margin-top:14px;padding:10px;border-radius:8px;font-size:.84rem;background:rgba(0,212,170,.15);color:#00d4aa';
        msgEl.textContent = '✓ Package updated';
        setTimeout(function(){
          document.getElementById('rl-pkg-mod').remove();
          if (typeof window.loadHSPackages === 'function') window.loadHSPackages();
        }, 800);
      } catch(e) {
        msgEl.style.cssText = 'display:block;margin-top:14px;padding:10px;border-radius:8px;font-size:.84rem;background:rgba(231,76,60,.15);color:#e74c3c';
        msgEl.textContent = '✗ ' + e.message;
        btn.disabled = false; btn.textContent = 'Save Changes';
      }
    });
  }

  // Click on package card -> edit modal
  document.addEventListener('click', function(e){
    var t = e.target;
    if (t.closest('button, a, input, select, textarea, label, [onclick], [contenteditable]')) return;
    if (t.closest('.modal, [role="dialog"], #rl-dd, #rl-pm, #rl-lp, #rl-pkg-mod, #rl-pay-mod')) return;
    var page = t.closest('#page-hs-packages');
    if (!page) return;
    var card = t.closest('.device-card');
    if (!card) return;
    var allCards = Array.from(page.querySelectorAll('.device-card'));
    var idx = allCards.indexOf(card);
    if (idx < 0) return;
    api('/hotspot/packages').then(function(d){
      var pkg = (d.packages || [])[idx];
      if (pkg) openPackageEditor(pkg);
    }).catch(function(err){
      console.error('Failed to fetch package:', err);
      alert('Failed to load package: ' + err.message);
    });
  });

  // ─── 3. PAYMENT DETAIL MODAL — click any payment row ──────────────────────
  function openPaymentDetail(pmt) {
    var existing = document.getElementById('rl-pay-mod');
    if (existing) existing.remove();
    var m = document.createElement('div');
    m.id = 'rl-pay-mod';
    m.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:99998;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)';
    function row(label, val) {
      return '<div style="display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)"><span style="color:#888">' + esc(label) + '</span><span style="font-weight:500">' + (val||'—') + '</span></div>';
    }
    m.innerHTML = ''
      + '<div style="background:#0d1530;border:1px solid rgba(0,212,170,.25);border-radius:14px;padding:24px;max-width:480px;width:100%;color:#fff;font-family:sans-serif;max-height:88vh;overflow-y:auto">'
      + '  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"><h2 style="margin:0">💳 Payment Receipt</h2><button onclick="document.getElementById(\'rl-pay-mod\').remove()" style="background:none;border:none;color:#888;font-size:1.4rem;cursor:pointer">×</button></div>'
      + row('Amount', '<span style="color:#00d4aa;font-weight:700">' + kes(pmt.amount) + '</span>')
      + row('Status', '<span class="badge ' + (pmt.status==='paid'?'badge-green':pmt.status==='pending'?'badge-amber':'badge-red') + '">' + esc(pmt.status) + '</span>')
      + row('Method', esc(String(pmt.method_display||pmt.payment_method||pmt.payment_gateway||'—').toUpperCase().replace(/_/g,' ')))
      + row('Payer Phone', '<span style="font-family:monospace">' + esc(pmt.payer_phone||pmt.mpesa_phone||pmt.phone_number||'—') + '</span>')
      + (pmt.mpesa_amount ? row('M-Pesa Amount', kes(pmt.mpesa_amount)) : '')
      + (pmt.mpesa_name ? row('M-Pesa Name', esc(pmt.mpesa_name)) : '')
      + (pmt.transaction_id ? row('Transaction ID', '<span style="font-family:monospace">' + esc(pmt.transaction_id) + '</span>') : '')
      + (pmt.voucher_code ? row('Voucher Code', '<span style="font-family:monospace;color:#00d4aa">' + esc(pmt.voucher_code) + '</span>') : '')
      + (pmt.package_name ? row('Package', esc(pmt.package_name)) : '')
      + row('Commission', kes(pmt.commission_amount) + ' (' + (pmt.commission_rate||0) + '%)')
      + row('Net to ISP', '<span style="color:#00d4aa">' + kes(pmt.net_amount || (pmt.amount - (pmt.commission_amount||0))) + '</span>')
      + row('Created', dts(pmt.created_at))
      + (pmt.paid_at ? row('Paid', dts(pmt.paid_at)) : '')
      + (pmt.failure_reason ? row('Failure Reason', '<span style="color:#e74c3c">' + esc(pmt.failure_reason) + '</span>') : '')
      + '  <div style="text-align:right;margin-top:18px"><button onclick="document.getElementById(\'rl-pay-mod\').remove()" style="background:rgba(255,255,255,.05);color:#fff;border:1px solid rgba(255,255,255,.15);padding:9px 20px;border-radius:6px;cursor:pointer">Close</button></div>'
      + '</div>';
    m.addEventListener('click', function(e){ if (e.target === m) m.remove(); });
    document.body.appendChild(m);
  }

  // Click a payment row -> open detail
  document.addEventListener('click', function(e){
    var t = e.target;
    if (t.closest('button, a, input, select, textarea, [onclick]')) return;
    if (t.closest('.modal, #rl-pay-mod, #rl-pkg-mod')) return;
    var row = t.closest('#payments-tbody tr');
    if (!row) return;
    var id = row.getAttribute('data-payment-id');
    if (!id) return;
    api('/isp/recent').then(function(d){
      var pmt = (d.payments || []).find(function(p){ return p.id === id; });
      if (!pmt) {
        // Fallback: fetch from /api/payments?limit=50
        api('/payments?limit=50').then(function(d2){
          var p = (d2.payments||[]).find(function(x){ return x.id === id; });
          if (p) openPaymentDetail(p);
        });
        return;
      }
      openPaymentDetail(pmt);
    }).catch(function(err){
      console.error('Failed to load payment:', err);
    });
  });

  console.log('[RL-Dash-v4] ready (payments override + package edit + payment detail)');
})();
</script>


<script>
/* === RumaLink HS Sessions Force-Override v1 === */
(function(){
  if (window.__rlHsSessionsV1) return;
  window.__rlHsSessionsV1 = true;
  console.log('[RL-HsSessions-v1] loaded');

  function getToken(){ return localStorage.getItem('rl_token') || window.token || ''; }
  async function api(path){
    var r = await fetch('/api' + path, { headers: { 'Authorization': 'Bearer ' + getToken() }});
    if (!r.ok) {
      var t = await r.text().catch(function(){return '';});
      throw new Error('HTTP ' + r.status + ': ' + t);
    }
    return r.json();
  }
  function esc(s){ return String(s||'').replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function fmtBytes(b){ if(!b||b<=0) return '0 B'; if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(1)+' KB'; if(b<1073741824) return (b/1048576).toFixed(1)+' MB'; return (b/1073741824).toFixed(2)+' GB'; }

  async function loadHSSessionsForced() {
    var tbody = document.getElementById('hs-sessions-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#888">Loading…</td></tr>';
    try {
      var d = await api('/hotspot/sessions');
      var sessions = d.sessions || [];
      console.log('[RL-HsSessions-v1] received', sessions.length, 'session(s)', sessions);
      if (!sessions.length) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#888">No active hotspot sessions</td></tr>';
        return;
      }
      tbody.innerHTML = sessions.map(function(s){
        return '<tr>'
          + '<td class="name" style="font-family:monospace">' + esc(s.mac_address||'—') + '</td>'
          + '<td style="font-family:monospace">' + esc(s.ip_address||'—') + '</td>'
          + '<td style="font-family:monospace;color:#00d4aa">' + esc(s.voucher_code||'—') + '</td>'
          + '<td>' + esc(s.package_name||'—') + '</td>'
          + '<td style="color:#888">' + esc(s.device_name||'—') + '</td>'
          + '<td style="color:#888">↓' + fmtBytes(s.bytes_in) + ' ↑' + fmtBytes(s.bytes_out) + ' / ' + esc(s.uptime||'—') + '</td>'
          + '</tr>';
      }).join('');
    } catch(e) {
      console.error('[RL-HsSessions-v1] FAILED:', e);
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#e74c3c">Failed to load: ' + esc(e.message) + '</td></tr>';
    }
  }

  function forceOverride() {
    window.loadHSSessions = loadHSSessionsForced;
    console.log('[RL-HsSessions-v1] loadHSSessions overridden');
  }

  forceOverride();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', forceOverride);
  setTimeout(forceOverride, 100);
  setTimeout(forceOverride, 1000);
  setTimeout(forceOverride, 3000);

  // Auto-load when navigating to HS Sessions page + every 15s while on it
  var autoRefreshTimer = null;
  document.addEventListener('click', function(e){
    var nav = e.target.closest('[data-page="hs-sessions"]');
    if (nav) {
      setTimeout(loadHSSessionsForced, 200);
      if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      autoRefreshTimer = setInterval(function(){
        var pg = document.getElementById('page-hs-sessions');
        if (pg && pg.classList.contains('active')) loadHSSessionsForced();
        else { clearInterval(autoRefreshTimer); autoRefreshTimer = null; }
      }, 15000);
    }
  });

  console.log('[RL-HsSessions-v1] ready');
})();
</script>




<script>
/* === RumaLink Sidebar Cleanup v1 — remove duplicate items === */
(function(){
  if (window.__rlSidebarCleanV1) return;
  window.__rlSidebarCleanV1 = true;
  console.log('[RL-SidebarClean-v1] loaded');

  function cleanup() {
    // Find all sidebar items
    var allItems = document.querySelectorAll('[data-page]');
    var seen = {};
    var byText = {};
    var removed = 0;

    allItems.forEach(function(item){
      var dataPage = item.getAttribute('data-page');
      var text = (item.textContent || '').trim().toLowerCase();
      // Normalize text - remove extra whitespace and icons
      var normText = text.replace(/[^a-z0-9 ]/g, '').replace(/\s+/g, ' ').trim();

      // Track by data-page first
      if (seen[dataPage]) {
        // Duplicate by data-page - remove the later one
        item.remove();
        removed++;
        return;
      }
      seen[dataPage] = item;

      // Track by visible text for cross-data-page duplicates
      if (byText[normText]) {
        // Duplicate text - keep the FIRST one, remove this
        item.remove();
        removed++;
        return;
      }
      byText[normText] = item;
    });

    if (removed > 0) console.log('[RL-SidebarClean-v1] removed', removed, 'duplicate sidebar item(s)');

    // Also remove duplicate pages by id
    var pages = document.querySelectorAll('[id^="page-"]');
    var seenPages = {};
    var pgRemoved = 0;
    pages.forEach(function(p){
      if (seenPages[p.id]) {
        p.remove();
        pgRemoved++;
        return;
      }
      seenPages[p.id] = p;
    });
    if (pgRemoved > 0) console.log('[RL-SidebarClean-v1] removed', pgRemoved, 'duplicate page(s)');
  }

  // Run multiple times to catch late insertions
  cleanup();
  setTimeout(cleanup, 500);
  setTimeout(cleanup, 1500);
  setTimeout(cleanup, 3500);

  // Also watch for new sidebar items being added
  var obs = new MutationObserver(function(mutations){
    var shouldClean = false;
    mutations.forEach(function(m){
      m.addedNodes.forEach(function(n){
        if (n.nodeType === 1 && (n.hasAttribute && n.hasAttribute('data-page'))) shouldClean = true;
      });
    });
    if (shouldClean) cleanup();
  });
  obs.observe(document.body, { childList: true, subtree: true });

  console.log('[RL-SidebarClean-v1] watching for duplicates');
})();
</script>

<script>
/* === RumaLink Active Sessions v3 — minimal, no page creation === */
(function(){
  if (window.__rlActiveSessV3) return;
  window.__rlActiveSessV3 = true;

  // Block ALL prior versions
  window.__rlActiveSessV1 = true;
  window.__rlActiveSessV2 = true;

  console.log('[RL-ActiveSess-v3] loaded');

  function getToken(){ return localStorage.getItem('rl_token') || window.token || ''; }
  async function api(path){
    var r = await fetch('/api' + path, { headers: { 'Authorization': 'Bearer ' + getToken() }});
    if (!r.ok) { var t = await r.text().catch(function(){return '';}); throw new Error('HTTP ' + r.status + ': ' + t.substring(0,200)); }
    return r.json();
  }
  function esc(s){ return String(s||'').replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function fmtBytes(b){ if(!b||b<=0) return '0 B'; if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(1)+' KB'; if(b<1073741824) return (b/1048576).toFixed(1)+' MB'; return (b/1073741824).toFixed(2)+' GB'; }
  function dts(s){ if(!s)return '—'; try{ return new Date(s).toLocaleString(); }catch(e){ return '—'; } }

  var allSessions = [];
  var currentFilter = 'all';

  // Find the Active Sessions page that ALREADY exists (added by v9)
  // It may have id "page-active-sessions", "page-sessions-active", or similar
  function findActivePage() {
    var candidates = ['page-active-sessions', 'page-sessions-active', 'page-sessions', 'page-active'];
    for (var i = 0; i < candidates.length; i++) {
      var el = document.getElementById(candidates[i]);
      if (el) return el;
    }
    // Try via sidebar nav data-page → corresponding page id
    var nav = Array.from(document.querySelectorAll('[data-page]')).find(function(n){
      var t = (n.textContent || '').toLowerCase();
      return t.indexOf('active session') !== -1 || t.indexOf('sessions') !== -1;
    });
    if (nav) {
      var dp = nav.getAttribute('data-page');
      var p = document.getElementById('page-' + dp);
      if (p) return p;
    }
    return null;
  }

  function findTbody() {
    var page = findActivePage();
    if (!page) return null;
    // Look for tbody inside it
    return page.querySelector('tbody[id*="session"], tbody[id*="active"], tbody');
  }

  function findTabButtons() {
    var page = findActivePage();
    if (!page) return [];
    return page.querySelectorAll('[data-filter], .rl-as-tab, .tab-btn');
  }

  function renderSessions() {
    var tbody = findTbody();
    if (!tbody) return;
    var filtered = currentFilter === 'all' ? allSessions : allSessions.filter(function(s){ return s.type === currentFilter; });

    findTabButtons().forEach(function(btn){
      var f = btn.getAttribute('data-filter');
      if (!f) return;
      var cnt = f === 'all' ? allSessions.length : allSessions.filter(function(s){ return s.type === f; }).length;
      var cntEl = btn.querySelector('.cnt, .count, span');
      if (cntEl) cntEl.textContent = cnt;
      else {
        // Update text directly preserving label
        var label = btn.getAttribute('data-label') || btn.textContent.replace(/\s*\d+\s*$/, '').trim();
        if (!btn.getAttribute('data-label')) btn.setAttribute('data-label', label);
        btn.innerHTML = esc(label) + ' <span class="cnt">' + cnt + '</span>';
      }
    });

    if (!filtered.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#888">No active sessions</td></tr>';
      return;
    }

    tbody.innerHTML = filtered.map(function(s){
      var typeClr = s.type === 'hotspot' ? '#00d4aa' : '#3498db';
      var ipMac = '<div style="font-family:monospace">' + esc(s.ip_address||'—') + '</div>'
                + '<div style="font-family:monospace;color:#888;font-size:.78rem">' + esc(s.mac_address||'—') + '</div>';
      return '<tr data-type="' + (s.type||'hotspot') + '" data-phone="' + esc(s.phone||'') + '" data-code="' + esc((s.username||'').split("@")[0]) + '" style="border-top:1px solid rgba(255,255,255,.03);cursor:pointer">'
        + '<td style="padding:12px"><span style="color:' + typeClr + ';font-weight:600;text-transform:uppercase;font-size:.78rem">' + esc(s.type||'—') + '</span></td>'
        + '<td style="padding:12px;font-family:monospace;color:#00d4aa">' + esc(s.username||'—') + '</td>'
        + '<td style="padding:12px;font-family:monospace">' + esc(s.phone||'—') + '</td>'
        + '<td style="padding:12px">' + ipMac + '</td>'
        + '<td style="padding:12px">' + esc(s.package_name||'—') + '</td>'
        + '<td style="padding:12px">' + esc(s.uptime||dts(s.start_time)) + '</td>'
        + '<td style="padding:12px;color:#888">' + (s.expires_at ? dts(s.expires_at) : '—') + '</td>'
        + '<td style="padding:12px;font-size:.85rem"><span style="color:#00d4aa">↓' + fmtBytes(s.bytes_in) + '</span> <span style="color:#888">/</span> <span style="color:#3498db">↑' + fmtBytes(s.bytes_out) + '</span></td>'
        + '</tr>';
    }).join('');
  }

  async function loadActiveSessions() {
    var tbody = findTbody();
    if (!tbody) {
      console.warn('[RL-ActiveSess-v3] no tbody found - will try again in 500ms');
      setTimeout(loadActiveSessions, 500);
      return;
    }
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#888">Loading…</td></tr>';
    try {
      var d = await api('/isp/sessions/active');
      allSessions = (d && d.sessions) || [];
      console.log('[RL-ActiveSess-v3] received', allSessions.length, 'session(s):', allSessions);
      renderSessions();
    } catch (e) {
      console.error('[RL-ActiveSess-v3] load failed:', e);
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#e74c3c">Failed: ' + esc(e.message) + '</td></tr>';
    }
  }
  window.rlLoadActiveSessions = loadActiveSessions;

  // Click handlers
  document.addEventListener('click', function(e){
    var tab = e.target.closest('[data-filter]');
    if (tab) {
      var page = findActivePage();
      if (page && page.contains(tab)) {
        currentFilter = tab.getAttribute('data-filter');
        findTabButtons().forEach(function(b){
          b.style.background = b === tab ? '#00d4aa' : 'rgba(255,255,255,.05)';
          b.style.color = b === tab ? '#0d1530' : '#fff';
          b.style.border = b === tab ? 'none' : '1px solid rgba(255,255,255,.15)';
        });
        renderSessions();
        return;
      }
    }
    // Sidebar nav click - detect Active Sessions related items
    var nav = e.target.closest('[data-page]');
    if (nav) {
      var t = (nav.textContent || '').toLowerCase();
      if (t.indexOf('active session') !== -1 || t.indexOf('sessions') !== -1) {
        setTimeout(loadActiveSessions, 200);
      }
    }
  });

  // Auto-refresh while on the page
  setInterval(function(){
    var page = findActivePage();
    if (page && page.offsetParent !== null && (page.style.display !== 'none')) {
      loadActiveSessions();
    }
  }, 15000);

  // Initial load attempt
  setTimeout(function(){
    var page = findActivePage();
    if (page && page.offsetParent !== null) loadActiveSessions();
  }, 1500);

      console.log('[RL-ActiveSess-v3] ready (no page/sidebar creation - hooks existing)');
})();
</script>


<script>
/* === RumaLink All Users v5 — in-sync with backend, no page creation === */
(function(){
  if (window.__rlUsersV5) return;
  window.__rlUsersV5 = true;
  // Block prior versions
  window.__rlUsersV4 = true; window.__rlUsersV3 = true;
  console.log('[RL-Users-v5] loaded');

  function getToken(){ return localStorage.getItem('rl_token') || window.token || ''; }
  async function api(path, opts){
    opts = opts || {};
    var r = await fetch('/api' + path, Object.assign({
      headers: { 'Authorization': 'Bearer ' + getToken(), 'Content-Type': 'application/json' }
    }, opts));
    if (!r.ok) { var t = await r.text().catch(function(){return '';}); throw new Error('HTTP ' + r.status + ': ' + t.substring(0,200)); }
    return r.json();
  }
  function esc(s){ return String(s||'').replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function dts(s){ if(!s)return '—'; try{ return new Date(s).toLocaleString(); }catch(e){ return '—'; } }
  function relExpiry(exp) {
    if (!exp) return { text: '—', color: '#888' };
    var now = Date.now();
    var when = new Date(exp).getTime();
    var diff = when - now;
    if (diff < 0) return { text: 'Expired', color: '#e74c3c' };
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    if (h > 24) return { text: Math.floor(h/24)+'d '+(h%24)+'h', color: '#00d4aa' };
    if (h > 0) return { text: h+'h '+m+'m', color: '#f39c12' };
    return { text: m+'m', color: '#e74c3c' };
  }

  var state = { users: [], counts: {all:0,hotspot:0,pppoe:0,online:0}, filter: 'all', search: '' };

  function findUsersPage() {
    var candidates = ['page-users', 'page-all-users', 'page-customers'];
    for (var i = 0; i < candidates.length; i++) {
      var el = document.getElementById(candidates[i]);
      if (el) return el;
    }
    // Find via sidebar nav text
    var nav = Array.from(document.querySelectorAll('[data-page]')).find(function(n){
      var t = (n.textContent || '').toLowerCase();
      return t.indexOf('all users') !== -1 || t.indexOf('users') !== -1 || t.indexOf('customers') !== -1;
    });
    if (nav) {
      var dp = nav.getAttribute('data-page');
      var p = document.getElementById('page-' + dp);
      if (p) return p;
    }
    return null;
  }

  function findTbody() {
    var page = findUsersPage();
    if (!page) return null;
    return page.querySelector('tbody[id*="user"], tbody[id*="customer"], tbody');
  }

  function findTabs() {
    var page = findUsersPage();
    if (!page) return [];
    return page.querySelectorAll('[data-user-filter], .users-tab, .rl-us-tab');
  }

  function findSearchInput() {
    var page = findUsersPage();
    if (!page) return null;
    return page.querySelector('input[type="search"], input[placeholder*="earch" i], input[placeholder*="ilter" i]');
  }

  function renderRows() {
    var tbody = findTbody();
    if (!tbody) return;
    var rows = state.users;
    if (state.filter !== 'all') rows = rows.filter(function(u){ return u.type === state.filter; });
    if (state.search) {
      var q = state.search.toLowerCase();
      rows = rows.filter(function(u){
        return ((u.username||'').toLowerCase().indexOf(q) !== -1)
            || ((u.phone||'').toLowerCase().indexOf(q) !== -1)
            || ((u.full_name||'').toLowerCase().indexOf(q) !== -1);
      });
    }

    // Update tab counts
    findTabs().forEach(function(b){
      var f = b.getAttribute('data-user-filter');
      if (!f) return;
      var n = state.counts[f] || 0;
      var cntEl = b.querySelector('.cnt, .count, span');
      if (cntEl) cntEl.textContent = n;
      else {
        var label = b.getAttribute('data-label') || b.textContent.replace(/\s*\d+\s*$/, '').trim();
        if (!b.getAttribute('data-label')) b.setAttribute('data-label', label);
        b.innerHTML = esc(label) + ' <span class="cnt">' + n + '</span>';
      }
    });

    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#888">No users</td></tr>';
      return;
    }

    tbody.innerHTML = rows.map(function(u){
      var typeClr = u.type === 'hotspot' ? '#00d4aa' : '#3498db';
      var statusClr = u.status === 'active' ? '#00d4aa' : u.status === 'expired' ? '#e74c3c' : '#888';
      var exp = relExpiry(u.expires_at);
      var onlineBadge = u.online
        ? '<span style="background:rgba(0,212,170,.2);color:#00d4aa;padding:2px 8px;border-radius:6px;font-size:.7rem;font-weight:600">● ONLINE</span>'
        : '<span style="color:#666;font-size:.78rem">offline</span>';
      return '<tr data-user-id="' + esc(u.id) + '" data-user-type="' + esc(u.type) + '" style="cursor:pointer;border-top:1px solid rgba(255,255,255,.03)">'
        + '<td style="padding:12px"><span style="color:' + typeClr + ';font-weight:600;text-transform:uppercase;font-size:.78rem">' + esc(u.type||'—') + '</span></td>'
        + '<td style="padding:12px;font-family:monospace;color:#00d4aa;font-weight:600">' + esc(u.username||'—') + '</td>'
        + '<td style="padding:12px;font-family:monospace">' + esc(u.phone||'—') + '</td>'
        + '<td style="padding:12px">' + esc(u.package_name||'—') + '</td>'
        + '<td style="padding:12px"><span style="color:' + statusClr + ';font-weight:600">' + esc(u.status||'—') + '</span></td>'
        + '<td style="padding:12px;color:' + exp.color + '">' + exp.text + '</td>'
        + '<td style="padding:12px">' + onlineBadge + '</td>'
        + '<td style="padding:12px;color:#888">' + dts(u.created_at) + '</td>'
        + '</tr>';
    }).join('');
  }

  async function loadUsers() {
    var tbody = findTbody();
    if (!tbody) { setTimeout(loadUsers, 500); return; }
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#888">Loading…</td></tr>';
    try {
      var qs = '';
      if (state.search) qs += '&search=' + encodeURIComponent(state.search);
      var d = await api('/isp/users?limit=500' + qs);
      state.users = d.users || [];
      state.counts = d.counts || {all:0,hotspot:0,pppoe:0,online:0};
      console.log('[RL-Users-v5] received', state.users.length, 'user(s); counts:', state.counts);
      renderRows();
    } catch(e) {
      console.error('[RL-Users-v5] failed:', e);
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#e74c3c">Failed: ' + esc(e.message) + '</td></tr>';
    }
  }
  window.rlLoadUsers = loadUsers;

  // User detail modal
  function openUserDetail(user) {
      // v62.8: Override - navigate to user.html instead of opening modal
      try {
        // Read ispId from rl_isp localStorage (JSON-stringified object)
        var ispId = '';
        try {
          var ispData = JSON.parse(localStorage.getItem('rl_isp') || '{}');
          ispId = ispData.id || '';
        } catch(_) {}
        if (!ispId) {
          ispId = (new URLSearchParams(location.search).get('ispId'))
            || localStorage.getItem('rl_isp_id')
            || localStorage.getItem('isp_id')
            || localStorage.getItem('ispId')
            || (window.currentISP && window.currentISP.id)
            || document.body.dataset.ispId || '';
        }
        var ident = user.phone || user.buyer_phone || user.username || user.code || user.voucher_code;
        if (!ident) { console.warn('openUserDetail: no identifier'); return; }
        var isPhoneLike = String(ident).match(/^\+?\d/) || String(ident).indexOf('254') === 0;
        var key = isPhoneLike ? 'phone' : 'code';
        /* RUMALINK_CLICK_REWIRE */ showUserInDashboard(ident, (key==='code'?'hotspot':'pppoe')); return;
      } catch(e) { console.error('openUserDetail redirect:', e); }
    }

  // Click handlers
  document.addEventListener('click', function(e){
    var tab = e.target.closest('[data-user-filter]');
    if (tab) {
      var page = findUsersPage();
      if (page && page.contains(tab)) {
        state.filter = tab.getAttribute('data-user-filter');
        findTabs().forEach(function(b){
          b.style.background = b === tab ? '#00d4aa' : 'rgba(255,255,255,.05)';
          b.style.color = b === tab ? '#0d1530' : '#fff';
          b.style.border = b === tab ? 'none' : '1px solid rgba(255,255,255,.15)';
        });
        renderRows();
        return;
      }
    }
    var nav = e.target.closest('[data-page]');
    if (nav) {
      var t = (nav.textContent || '').toLowerCase();
      if (t.indexOf('all users') !== -1 || t.indexOf('users') !== -1 || t.indexOf('customers') !== -1) {
        setTimeout(loadUsers, 200);
      }
    }
    var row = e.target.closest('[data-user-id]');
    if (row && row.closest('tbody')) {
      var uid = row.getAttribute('data-user-id');
      var u = state.users.find(function(x){ return x.id === uid; });
      if (u) openUserDetail(u);
    }
  });

  // Search input
  document.addEventListener('input', function(e){
    var page = findUsersPage();
    if (!page || !page.contains(e.target)) return;
    var inp = findSearchInput();
    if (e.target === inp) {
      state.search = e.target.value || '';
      renderRows();
    }
  });

  // Auto-load when sidebar clicked + auto-refresh every 30s while visible
  setInterval(function(){
    var page = findUsersPage();
    if (page && page.offsetParent !== null && page.style.display !== 'none') loadUsers();
  }, 30000);

  setTimeout(function(){
    var page = findUsersPage();
    if (page && page.offsetParent !== null) loadUsers();
  }, 1500);

  console.log('[RL-Users-v5] ready');
})();
</script>


<script>
// v62.24: PPPoE package edit modal
async function editPPPoEPackage(packageId) {
  try {
    let pkgs = window.__pppoe_packages;
    if (!pkgs) {
      const d = await api('/pppoe/packages');
      pkgs = (d && d.packages) || [];
      window.__pppoe_packages = pkgs;
    }
    const p = pkgs.find(x => x.id === packageId);
    if (!p) { toast('Package not found', 'error'); return; }
    const safe = s => (s == null ? '' : String(s).replace(/"/g, '&quot;'));
    const sel = (val, opt) => val === opt ? ' selected' : '';
    const html = `<div class="modal">
      <h2>Edit PPPoE Package</h2>
      <div class="sub">${safe(p.name)}</div>
      <div class="fg2"><div class="fg"><label>Name *</label><input id="pp-edit-name" value="${safe(p.name)}"/></div><div class="fg"><label>Price (KES) *</label><input id="pp-edit-price" type="number" value="${p.price||''}"/></div></div>
      <div class="fg2"><div class="fg"><label>Download Mbps</label><input id="pp-edit-down" type="number" value="${p.bandwidth_down_mbps||''}"/></div><div class="fg"><label>Upload Mbps</label><input id="pp-edit-up" type="number" value="${p.bandwidth_up_mbps||''}"/></div></div>
      <div class="fg2"><div class="fg"><label>Data Limit (GB, blank=unlimited)</label><input id="pp-edit-data" type="number" value="${p.data_limit_gb||''}"/></div><div class="fg"><label>MikroTik Profile</label><input id="pp-edit-profile" value="${safe(p.mikrotik_profile)}"/></div></div>
      <div class="fg2"><div class="fg"><label>Billing Cycle</label><select id="pp-edit-cycle"><option value="monthly"${sel(p.billing_cycle,'monthly')}>Monthly</option><option value="weekly"${sel(p.billing_cycle,'weekly')}>Weekly</option><option value="daily"${sel(p.billing_cycle,'daily')}>Daily</option></select></div><div class="fg"><label>IP Pool</label><input id="pp-edit-pool" value="${safe(p.address_pool)}"/></div></div>
      <div class="fg"><label>Description</label><input id="pp-edit-desc" value="${safe(p.description)}"/></div>
      <div class="modal-actions"><button class="btn btn-outline" onclick="this.closest('.modal-overlay').remove()">Cancel</button><button class="btn btn-teal" onclick="savePPPoEPackageEdit('${p.id}')">Save Changes</button></div>
    </div>`;
    const ov = document.createElement('div');
    ov.className = 'modal-overlay open';
    ov.innerHTML = html;
    ov.addEventListener('click', e => { if (e.target === ov) ov.remove(); });
    document.body.appendChild(ov);
  } catch(e) { console.error('editPPPoEPackage:', e); toast(e.message || 'Error', 'error'); }
}

async function savePPPoEPackageEdit(packageId) {
  try {
    const payload = {
      name: document.getElementById('pp-edit-name').value,
      description: document.getElementById('pp-edit-desc').value,
      price: document.getElementById('pp-edit-price').value,
      billing_cycle: document.getElementById('pp-edit-cycle').value,
      bandwidth_down_mbps: document.getElementById('pp-edit-down').value || null,
      bandwidth_up_mbps: document.getElementById('pp-edit-up').value || null,
      data_limit_gb: document.getElementById('pp-edit-data').value || null,
      mikrotik_profile: document.getElementById('pp-edit-profile').value,
      address_pool: document.getElementById('pp-edit-pool').value,
      is_active: true
    };
    await api('/pppoe/packages/' + packageId, { method: 'PUT', body: JSON.stringify(payload) });
    toast('Package updated');
    document.querySelectorAll('.modal-overlay').forEach(o => o.remove());
    if (typeof loadPPPoEPackages === 'function') loadPPPoEPackages();
  } catch(e) { console.error('savePPPoEPackageEdit:', e); toast(e.message || 'Save failed', 'error'); }
}

async function deletePPPoEPackage(packageId) {
  if (!confirm('Delete this PPPoE package?  Any subscribers using it must be reassigned first.')) return;
  try {
    await api('/pppoe/packages/' + packageId, { method: 'DELETE' });
    toast('Package deleted');
    if (typeof loadPPPoEPackages === 'function') loadPPPoEPackages();
  } catch(e) { console.error('deletePPPoEPackage:', e); toast(e.message || 'Delete failed', 'error'); }
}

// v62.71: Generate test K-code (no payment, no M-Pesa)
async function generateTestVoucher() {
  try {
    const pkgRes = await api('/hotspot/packages');
    const packages = pkgRes.packages || [];
    if (packages.length === 0) { toast('No hotspot packages configured', 'error'); return; }
    const pkg = packages[0];
    const ok = confirm(`Generate test K-code for package "${pkg.name}"? It will be free, marked as test, and excluded from revenue.`);
    if (!ok) return;
    const r = await api('/isp/hotspot/test-voucher', { method: 'POST', body: JSON.stringify({ package_id: pkg.id }) });
    toast(`🧪 Test K-code created: ${r.voucher.code}`, 'success');
    if (typeof loadVouchers === 'function') loadVouchers();
  } catch (e) { toast(e.message, 'error'); }
}


// v62.72: Open Add Hotspot User modal — pre-fill next K-code + load packages
async function openAddHotspotUser() {
  try {
    // Reset form
    document.getElementById('hsu-code').value = '';
    document.getElementById('hsu-phone').value = '';
    document.getElementById('hsu-mac').value = '';
    document.getElementById('hsu-is-test').checked = false;
    
    // Get next code suggestion
    try {
      const r = await api('/isp/hotspot/next-code');
      document.getElementById('hsu-code').placeholder = r.next_code + ' (auto)';
    } catch(e) {}
    
    // Load packages into dropdown
    const d = await api('/hotspot/packages');
    document.getElementById('hsu-pkg').innerHTML = (d.packages || [])
      .map(p => `<option value="${p.id}">${p.name} — ${kes(p.price)} / ${p.duration_hours || '?'}h</option>`).join('');
    
    if (!(d.packages || []).length) { toast('Create a hotspot package first', 'error'); return; }
    
    openModal('modal-hsuser');
  } catch (e) { toast(e.message, 'error'); }
}

// v62.72: Submit the Add Hotspot User form
async function createHotspotUser() {
  try {
    const body = {
      code: document.getElementById('hsu-code').value.trim().toUpperCase() || undefined,
      package_id: document.getElementById('hsu-pkg').value,
      buyer_phone: document.getElementById('hsu-phone').value.trim() || undefined,
      mac_address: document.getElementById('hsu-mac').value.trim().toUpperCase() || undefined,
      is_test: document.getElementById('hsu-is-test').checked
    };
    if (!body.package_id) { toast('Pick a package', 'error'); return; }
    
    const r = await api('/isp/hotspot/manual-voucher', { method: 'POST', body: JSON.stringify(body) });
    const icon = body.is_test ? '🧪' : '✅';
    toast(`${icon} ${body.is_test ? 'Test ' : ''}Voucher created: ${r.voucher.code}`, 'success');
    closeModal('modal-hsuser');
    if (typeof loadVouchers === 'function') loadVouchers();
    if (typeof loadVoucherStats === 'function') loadVoucherStats();
  } catch (e) { toast(e.message, 'error'); }
}


/* RUMALINK_AS_USAGE_CARDS: fill the 3 Active Sessions usage cards */
function _asFmtBytes(b){
  b = Number(b)||0;
  if (b <= 0) return '0 B';
  if (b < 1024) return b + ' B';
  var u = ['KB','MB','GB','TB','PB'], i = -1;
  do { b /= 1024; i++; } while (b >= 1024 && i < u.length-1);
  return (b >= 100 ? b.toFixed(0) : b.toFixed(b >= 10 ? 1 : 2)) + ' ' + u[i];
}
async function loadActiveSessionsUsage(){
  try{
    var t = (localStorage.getItem('rl_token')||localStorage.getItem('token')||'');
    var r = await fetch((window.API||'/api')+'/isp/usage/today-split?_='+Date.now(), {
      cache:'no-store', headers:{'Authorization':'Bearer '+t}
    });
    if(!r.ok) return;
    var d = await r.json();
    var h=document.getElementById('as-hotspot-data'); if(h) h.textContent=_asFmtBytes(d.hotspot_bytes);
    var p=document.getElementById('as-pppoe-data');   if(p) p.textContent=_asFmtBytes(d.pppoe_bytes);
    var t2=document.getElementById('as-total-data');  if(t2) t2.textContent=_asFmtBytes(d.total_bytes);
  }catch(e){}
}
/* Hook: run when the Active Sessions page becomes visible + on its refresh button */
(function(){
  try{
    var navItem = document.querySelector('.nav-item[data-page="active-sessions"]');
    if(navItem) navItem.addEventListener('click', function(){ setTimeout(loadActiveSessionsUsage, 250); });
    var refresh = document.getElementById('rl-as-refresh');
    if(refresh) refresh.addEventListener('click', function(){ setTimeout(loadActiveSessionsUsage, 100); });
    // Also load if the page is already active on first paint.
    var pg = document.getElementById('page-active-sessions');
    if(pg && pg.classList.contains('active')) setTimeout(loadActiveSessionsUsage, 400);
  }catch(e){}
})();

</script>

<!-- SMS TOPUP MODAL -->
<div class="modal-overlay" id="sms-topup-overlay">
  <div class="modal" style="max-width:440px">
    <h2>Top Up SMS</h2>
    <div class="sub">Buy SMS credits from RumaLink. Pay via M-Pesa STK.</div>
    <div id="sms-topup-form">
      <div class="fg"><label>M-Pesa Phone Number</label><input type="tel" id="sms-topup-phone" placeholder="07XXXXXXXX"/></div>
      <div class="fg"><label>Amount (KES)</label><input type="number" id="sms-topup-amount" min="1" step="1" placeholder="e.g. 100" oninput="calcSmsTopup()"/></div>
      <div style="background:rgba(0,212,170,.08);border:1px solid rgba(0,212,170,.25);border-radius:8px;padding:12px 14px;margin:6px 0 14px;font-size:.9rem">
        You will get <strong id="sms-topup-count" style="color:#00d4aa">0.00 SMS</strong>
        <div style="color:var(--muted);font-size:.78rem;margin-top:2px">at KES <span id="sms-topup-price">0.50</span> per SMS</div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" onclick="closeSmsTopup()">Cancel</button>
        <button class="btn btn-teal" id="sms-topup-pay" onclick="paySmsTopup()">Pay</button>
      </div>
    </div>
    <div id="sms-topup-wait" style="display:none;text-align:center;padding:14px 0">
      <div style="font-weight:700" id="sms-topup-wait-title">Confirming Payment...</div>
      <div style="color:var(--muted);font-size:.85rem;margin-top:4px" id="sms-topup-wait-text">Enter your M-Pesa PIN on your phone.</div>
    </div>
    <div id="sms-topup-done" style="display:none;text-align:center;padding:14px 0">
      <div style="font-size:2.4rem;color:#00d4aa">&#10003;</div>
      <div style="font-weight:700;color:#00d4aa" id="sms-topup-done-title">SMS Added!</div>
      <div style="color:var(--muted);font-size:.85rem;margin-top:4px" id="sms-topup-done-text"></div>
      <div class="modal-actions" style="justify-content:center"><button class="btn btn-teal" onclick="closeSmsTopup(true)">Done</button></div>
    </div>
  </div>
</div>
<!-- SMS MESSAGE VIEW MODAL -->
<div class="modal-overlay" id="sms-view-overlay">
  <div class="modal" style="max-width:480px">
    <h2>Message Details</h2>
    <div class="sub" id="sms-view-sub">—</div>
    <div style="margin:14px 0">
      <div style="font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">Recipient</div>
      <div id="sms-view-to" style="font-weight:600;margin-bottom:14px">—</div>
      <div style="font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">Message</div>
      <div id="sms-view-msg" style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:14px;white-space:pre-wrap;word-break:break-word;line-height:1.5">—</div>
    </div>
    <div class="modal-actions"><button class="btn btn-teal" onclick="document.getElementById('sms-view-overlay').classList.remove('open')">Close</button></div>
  </div>
</div>
</body>
</html>
