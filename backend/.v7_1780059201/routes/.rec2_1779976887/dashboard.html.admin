}

// ── ISP DETAIL PANEL ──
async function openISPPanel(id) {
  currentISPId = id;
  document.getElementById('isp-detail-panel').classList.add('open');
  document.getElementById('sp-overlay').style.display = 'block';
  try {
    const d = await apiFetch(`/admin/isps/${id}`);
    const i = d.isp;
    document.getElementById('sp-isp-name').textContent = i.company_name;
    document.getElementById('sp-isp-email').textContent = i.email;
    document.getElementById('sp-plan').innerHTML = `<span class="badge ${i.plan_type === 'hotspot' ? 'bt' : 'ba'}">${i.plan_type}</span>`;
    document.getElementById('sp-status').innerHTML = `<span class="badge ${i.status === 'active' ? 'bg' : i.status === 'pending' ? 'ba' : 'br'}">${i.status}</span>`;
    document.getElementById('sp-owner').textContent = i.owner_name;
    document.getElementById('sp-phone').textContent = i.phone || '—';
    document.getElementById('sp-location').textContent = [i.county, i.town].filter(Boolean).join(', ') || '—';
    document.getElementById('sp-joined').textContent = dt(i.created_at);
    document.getElementById('sp-last-login').textContent = dts(i.last_login);
    document.getElementById('sp-revenue').textContent = kes(i.total_revenue);
    document.getElementById('sp-commission').textContent = kes(i.total_commission);
    document.getElementById('sp-wallet').textContent = kes(i.wallet_balance);
    document.getElementById('sp-devices').textContent = i.device_count || 0;
    document.getElementById('sp-pppoe-users').textContent = `${i.active_pppoe_users || 0} active / ${i.total_pppoe_users || 0} total`;
    document.getElementById('sp-apikey').textContent = i.api_key || '—';
    document.getElementById('sp-payments-tbody').innerHTML = (d.recent_payments || []).map(p => `
      <tr><td style="color:var(--teal)">${kes(p.amount)}</td><td>${p.payment_method}</td><td><span class="badge ${p.status === 'paid' ? 'bg' : 'ba'}">${p.status}</span></td><td>${dt(p.created_at)}</td></tr>`).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--muted)">No payments</td></tr>';
  } catch (e) { toast('Failed to load ISP details', 'error'); }
}

function closeISPPanel() {
  document.getElementById('isp-detail-panel').classList.remove('open');
  document.getElementById('sp-overlay').style.display = 'none';
  currentISPId = null;
}

async function updateISPStatus(id, status) {
  if (!confirm(`${status === 'active' ? 'Activate' : status === 'suspended' ? 'Suspend' : 'Cancel'} this ISP account?`)) return;
  try {
    await apiFetch(`/admin/isps/${id}/status`, { method: 'PATCH', body: JSON.stringify({ status }) });
    toast(`ISP ${status} successfully`);
    closeISPPanel();
    loadISPs(); loadDashboard();
    if (status === 'suspended') loadSuspendedISPs();
    if (status === 'active') loadPendingISPs();
  } catch (e) { toast(e.message, 'error'); }
}

// ── COMMISSIONS ──
async function loadCommissions() {
  const month = document.getElementById('comm-month')?.value;
  const year = document.getElementById('comm-year')?.value;
  try {
    const d = await apiFetch(`/admin/commissions${month ? '?month=' + month : ''}${year ? (month ? '&' : '?') + 'year=' + year : ''}`);
    document.getElementById('comm-total').textContent = kes(d.totals?.total);
    document.getElementById('comm-settled').textContent = kes(d.totals?.settled);
    document.getElementById('comm-pending-val').textContent = kes((parseFloat(d.totals?.total) - parseFloat(d.totals?.settled)) || 0);
    document.getElementById('comm-tbody').innerHTML = (d.commissions || []).map(c => `
      <tr>
        <td class="name">${c.company_name}</td>
        <td style="color:var(--amber);font-weight:600">${kes(c.amount)}</td>
        <td><span class="badge bm">${(parseFloat(c.rate) * 100).toFixed(1)}%</span></td>
        <td style="color:var(--teal)">${kes(c.payment_amount)}</td>
        <td>${c.payment_method}</td>
        <td><span class="badge ${c.is_settled ? 'bg' : 'ba'}">${c.is_settled ? 'Settled' : 'Pending'}</span></td>
        <td>${dt(c.created_at)}</td>
      </tr>`).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:24px">No commissions yet</td></tr>';
  } catch (e) {}
}

