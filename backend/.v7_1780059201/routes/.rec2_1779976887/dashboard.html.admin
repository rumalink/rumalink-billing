<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Admin Dashboard — RumaLink Enterprise</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
:root{--ink:#060910;--navy:#0b1220;--mid:#111c32;--teal:#00d4aa;--teal2:#00b894;--amber:#f39c12;--red:#e74c3c;--green:#2ecc71;--white:#eef2ff;--muted:#7a8baa;--card:#0f1a2e;--border:#1a2a45;--sidebar:230px;--font-head:'Syne',sans-serif;--font-body:'DM Sans',sans-serif}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{background:var(--ink);color:var(--white);font-family:var(--font-body);display:flex}

/* SIDEBAR */
.sidebar{width:var(--sidebar);background:var(--navy);border-right:1px solid var(--border);display:flex;flex-direction:column;height:100vh;position:sticky;top:0;flex-shrink:0}
.sb-logo{padding:20px 18px 14px;border-bottom:1px solid var(--border)}
.sb-logo-top{font-family:var(--font-head);font-size:1.05rem;font-weight:800;color:var(--teal)}
.sb-logo-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(243,156,18,.1);border:1px solid rgba(243,156,18,.2);color:var(--amber);padding:3px 10px;border-radius:100px;font-size:.68rem;font-weight:700;letter-spacing:.5px;margin-top:6px}
.sb-admin{padding:12px 18px;border-bottom:1px solid var(--border);background:rgba(0,0,0,.2)}
.sb-admin-name{font-size:.85rem;font-weight:500}
.sb-admin-role{font-size:.7rem;color:var(--amber);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.sb-nav{flex:1;padding:10px 0;overflow-y:auto}
.nav-group{font-size:.63rem;color:var(--border);text-transform:uppercase;letter-spacing:1.5px;padding:12px 18px 4px;font-weight:700}
.nav-item{display:flex;align-items:center;gap:11px;padding:9px 18px;color:var(--muted);font-size:.86rem;cursor:pointer;transition:all .15s;border-left:3px solid transparent;user-select:none}
.nav-item:hover{color:var(--white);background:rgba(255,255,255,.04)}
.nav-item.active{color:var(--amber);background:rgba(243,156,18,.07);border-left-color:var(--amber);font-weight:500}
.nav-item .icon{width:17px;text-align:center;font-size:.95rem;flex-shrink:0}
.sb-bottom{padding:14px 18px;border-top:1px solid var(--border)}
.sb-stats{background:rgba(0,212,170,.06);border:1px solid rgba(0,212,170,.12);border-radius:9px;padding:11px;margin-bottom:10px}
.sb-stat-label{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
.sb-stat-val{font-family:var(--font-head);font-size:1.15rem;font-weight:700;color:var(--teal);margin-top:1px}
.btn-logout{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:.82rem;cursor:pointer;padding:3px 0;background:none;border:none;font-family:var(--font-body)}
.btn-logout:hover{color:var(--red)}
.btn-amber{background:var(--amber);color:var(--ink);border:none;border-radius:8px;padding:10px 20px;font-family:var(--font-body);font-weight:600;cursor:pointer;transition:all .2s}
.btn-amber:hover:not(:disabled){background:#e67e22;transform:translateY(-1px)}
.btn-amber:disabled{opacity:.55;cursor:not-allowed}

/* MAIN */
.main{flex:1;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.topbar{padding:13px 26px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(6,9,16,.9);backdrop-filter:blur(12px);position:sticky;top:0;z-index:50}
.topbar-title{font-family:var(--font-head);font-size:1.05rem;font-weight:700}
.topbar-right{display:flex;align-items:center;gap:14px}
.notif-btn{position:relative;background:none;border:none;color:var(--muted);font-size:1.15rem;cursor:pointer}
.notif-dot{position:absolute;top:0;right:0;width:7px;height:7px;background:var(--red);border-radius:50%}
.admin-av{width:32px;height:32px;background:linear-gradient(135deg,var(--amber),#e67e22);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-head);font-size:.8rem;font-weight:700;color:#fff}
.content{flex:1;padding:26px}

/* PAGES */
.page{display:none}.page.active{display:block}

/* STAT CARDS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px;margin-bottom:22px}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px;position:relative;overflow:hidden;transition:border-color .2s}
.stat-card::after{content:'';position:absolute;top:0;right:0;width:60px;height:60px;border-radius:0 12px 0 60px;background:rgba(255,255,255,.02)}
.stat-card:hover{border-color:rgba(0,212,170,.2)}
.sc-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between}
.sc-icon{font-size:1rem;opacity:.6}
.sc-val{font-family:var(--font-head);font-size:1.9rem;font-weight:700;line-height:1}
.sc-val.teal{color:var(--teal)}.sc-val.amber{color:var(--amber)}.sc-val.red{color:var(--red)}.sc-val.green{color:var(--green)}
.sc-sub{font-size:.74rem;color:var(--muted);margin-top:6px}
.sc-change{font-size:.75rem;padding:2px 8px;border-radius:100px;font-weight:600}
.sc-change.up{background:rgba(46,204,113,.1);color:var(--green)}.sc-change.down{background:rgba(231,76,60,.1);color:var(--red)}

/* LAYOUT */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:20px}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:20px}
.grid-2-1{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-bottom:20px}

/* PANEL */
.panel{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:0}
.panel-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.panel-head h3{font-family:var(--font-head);font-size:.9rem;font-weight:700}
.panel-body{padding:18px}

/* TABLE */
.tbl{width:100%;border-collapse:collapse;font-size:.84rem}
.tbl-wrap{overflow-x:auto}
.tbl th{text-align:left;padding:9px 13px;font-size:.7rem;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--border);font-weight:600;white-space:nowrap}
.tbl td{padding:11px 13px;border-bottom:1px solid rgba(255,255,255,.03);color:var(--muted);vertical-align:middle}
.tbl td.name{color:var(--white);font-weight:500}
.tbl tr:last-child td{border:none}
.tbl tr:hover td{background:rgba(255,255,255,.015)}

/* BADGES */
.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:100px;font-size:.71rem;font-weight:600;letter-spacing:.2px;white-space:nowrap}
.bg{background:rgba(46,204,113,.1);color:var(--green)}
.ba{background:rgba(243,156,18,.1);color:var(--amber)}
.br{background:rgba(231,76,60,.1);color:var(--red)}
.bm{background:rgba(122,139,170,.1);color:var(--muted)}
.bt{background:rgba(0,212,170,.1);color:var(--teal)}

/* BUTTONS */
.btn{padding:8px 16px;border-radius:8px;font-family:var(--font-body);font-weight:600;font-size:.84rem;cursor:pointer;border:none;display:inline-flex;align-items:center;gap:6px;transition:all .15s;text-decoration:none;white-space:nowrap}
.btn-teal{background:var(--teal);color:var(--ink)}.btn-teal:hover{background:var(--teal2)}
.btn-amber{background:var(--amber);color:#fff}.btn-amber:hover{opacity:.9}
.btn-outline{background:transparent;border:1.5px solid var(--border);color:var(--muted)}.btn-outline:hover{border-color:var(--teal);color:var(--teal)}
.btn-red{background:rgba(231,76,60,.12);color:var(--red);border:1px solid rgba(231,76,60,.2)}.btn-red:hover{background:var(--red);color:#fff}
.btn-green{background:rgba(46,204,113,.12);color:var(--green);border:1px solid rgba(46,204,113,.2)}.btn-green:hover{background:var(--green);color:#fff}
.btn-sm{padding:5px 11px;font-size:.78rem}

/* FORMS */
.fg{margin-bottom:14px}
.fg label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:5px;font-weight:500}
.fg input,.fg select,.fg textarea{width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-family:var(--font-body);font-size:.88rem;outline:none;transition:border-color .2s}
.fg input:focus,.fg select:focus{border-color:var(--amber)}
.fg select option{background:var(--navy)}
.fg2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(5px)}
.modal-overlay.open{display:flex}
.modal{background:var(--navy);border:1px solid var(--border);border-radius:16px;padding:30px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;animation:mup .2s ease}
@keyframes mup{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal h2{font-family:var(--font-head);font-size:1.15rem;font-weight:700;margin-bottom:6px}
.modal .modal-sub{color:var(--muted);font-size:.85rem;margin-bottom:22px;font-weight:300}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}

/* ISP DETAIL SIDE PANEL */
.side-panel{position:fixed;top:0;right:-520px;width:500px;height:100vh;background:var(--navy);border-left:1px solid var(--border);z-index:300;overflow-y:auto;transition:right .3s ease;box-shadow:-20px 0 60px rgba(0,0,0,.5)}
.side-panel.open{right:0}
.sp-head{padding:20px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--navy);z-index:1}
.sp-close{background:none;border:none;color:var(--muted);font-size:1.3rem;cursor:pointer;padding:4px}
.sp-close:hover{color:var(--white)}
.sp-body{padding:22px}
.sp-section{margin-bottom:22px}
.sp-section h4{font-family:var(--font-head);font-size:.82rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:12px}
.sp-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:.85rem}
.sp-row:last-child{border:none}
.sp-row .sp-key{color:var(--muted);font-weight:300}
.sp-row .sp-val{color:var(--white);font-weight:500;text-align:right}

/* TOASTS */
.toast-container{position:fixed;bottom:22px;right:22px;z-index:999;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 16px;font-size:.86rem;display:flex;align-items:center;gap:10px;box-shadow:0 8px 32px rgba(0,0,0,.5);animation:tslide .3s ease;min-width:250px}
.toast.success{border-color:rgba(0,212,170,.3)}.toast.error{border-color:rgba(231,76,60,.3)}
@keyframes tslide{from{transform:translateX(40px);opacity:0}to{transform:translateX(0);opacity:1}}

/* SEARCH / FILTER BAR */
.filter-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.filter-bar input,.filter-bar select{background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:8px 12px;color:var(--white);font-family:var(--font-body);font-size:.84rem;outline:none;transition:border-color .2s}
.filter-bar input:focus,.filter-bar select:focus{border-color:var(--amber)}
.filter-bar select option{background:var(--navy)}

/* LOADING */
.loading{display:flex;align-items:center;justify-content:center;padding:40px;color:var(--muted);gap:12px;font-size:.88rem}
.spinner{width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--amber);border-radius:50%;animation:spin 1s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}

/* PLAN SPLIT DONUT */
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut-legend{flex:1}
.legend-item{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:.84rem;color:var(--muted)}
.legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}

/* ─── HAMBURGER ─── */
.hamburger-btn{display:none;background:none;border:none;color:var(--white);font-size:1.3rem;cursor:pointer;padding:4px 8px;line-height:1}
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:149}
.sidebar-overlay.open{display:block}

/* ─── RESPONSIVE ─── */
@media(max-width:1100px){:root{--sidebar:200px}.content{padding:18px}}
@media(max-width:1000px){.grid-2,.grid-3,.grid-2-1{grid-template-columns:1fr}}
@media(max-width:900px){
  :root{--sidebar:260px}
  .sidebar{position:fixed;left:-280px;top:0;height:100vh;z-index:150;transition:left .28s cubic-bezier(.4,0,.2,1);box-shadow:4px 0 28px rgba(0,0,0,.5)}
  .sidebar.open{left:0}
  .hamburger-btn{display:block}
  .main{width:100%}
  .stats-grid{grid-template-columns:1fr 1fr}
  .topbar{padding:12px 16px}
  .content{padding:16px}
  .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .modal{max-width:calc(100vw - 32px);margin:16px}
}
@media(max-width:600px){
  .stats-grid{grid-template-columns:1fr 1fr}
  .topbar-title{font-size:.9rem}
  .topbar-right{gap:8px}
  .content{padding:12px}
  .card{padding:14px}
  .tbl th,.tbl td{padding:8px 10px;font-size:.78rem}
  .filter-bar{flex-wrap:wrap;gap:8px}
  .donut-wrap{flex-direction:column}
}
@media(max-width:420px){
  .stats-grid{grid-template-columns:1fr}
  .content{padding:10px}
  .topbar{padding:10px 12px}
}
</style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sb-logo">
    <div class="sb-logo-top">RumaLink Enterprise</div>
    <div class="sb-logo-badge">⚡ Admin Console</div>
  </div>
  <div class="sb-admin">
    <div class="sb-admin-name" id="sb-admin-name">Admin</div>
    <div class="sb-admin-role">Super Administrator</div>
  </div>
  <nav class="sb-nav">
    <div class="nav-group">Overview</div>
    <div class="nav-item active" data-page="dashboard"><span class="icon">📊</span> Dashboard</div>

    <div class="nav-group">ISP Management</div>
    <div class="nav-item" data-page="isps"><span class="icon">🏢</span> All ISPs</div>
    <div class="nav-item" data-page="isp-pending"><span class="icon">⏳</span> Pending Review</div>
    <div class="nav-item" data-page="isp-suspended"><span class="icon">🚫</span> Suspended</div>

    <div class="nav-group">Revenue</div>
    <div class="nav-item" data-page="commissions"><span class="icon">💰</span> Commissions</div>
    <div class="nav-item" data-page="platform-invoices"><span class="icon">🧾</span> Platform Invoices</div>
    <div class="nav-item" data-page="billing"><span class="icon">💳</span> Charge ISPs</div>
    <div class="nav-item" data-page="payouts"><span class="icon">💸</span> Payouts</div>

    <div class="nav-group">Monitoring</div>
    <div class="nav-item" data-page="sessions"><span class="icon">📡</span> Live Sessions</div>
    <div class="nav-item" data-page="devices"><span class="icon">🖥️</span> All Devices</div>

    <div class="nav-group">Platform</div>
    <div class="nav-item" data-page="notifications"><span class="icon">🔔</span> Notifications</div>
    <div class="nav-item" data-page="support"><span class="icon">🎧</span> Support Tickets</div>
    <div class="nav-item" data-page="settings"><span class="icon">⚙️</span> Settings</div>
  </nav>
  <div class="sb-bottom">
    <div class="sb-stats">
      <div class="sb-stat-label">Total Commission</div>
      <div class="sb-stat-val" id="sb-commission">KES —</div>
    </div>
    <button class="btn-logout" onclick="logout()">🚪 Sign Out</button>
  </div>
</aside>

<!-- MAIN -->
<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:10px">
      <button class="hamburger-btn" onclick="toggleSidebar()" aria-label="Open menu">☰</button>
      <div class="topbar-title" id="page-title">Dashboard</div>
    </div>
    <div class="topbar-right">
      <button class="notif-btn" onclick="showPage('notifications')" title="Notifications">🔔<span class="notif-dot" id="notif-dot" style="display:none"></span></button>
      <div class="admin-av" id="admin-av">A</div>
    </div>
  </div>

  <div class="content">

    <!-- ══ DASHBOARD ══ -->
    <div class="page active" id="page-dashboard">
      <div class="stats-grid">
        <div class="stat-card"><div class="sc-label">Total ISPs <span class="sc-icon">🏢</span></div><div class="sc-val teal" id="ds-total-isps">—</div><div class="sc-sub"><span id="ds-new-isps">—</span> new this month</div></div>
        <div class="stat-card"><div class="sc-label">Active ISPs <span class="sc-icon">✅</span></div><div class="sc-val green" id="ds-active-isps">—</div><div class="sc-sub">Generating revenue</div></div>
        <div class="stat-card"><div class="sc-label">Total Commission <span class="sc-icon">💰</span></div><div class="sc-val amber" id="ds-total-comm">—</div><div class="sc-sub">All time</div></div>
        <div class="stat-card"><div class="sc-label">This Month <span class="sc-icon">📅</span></div><div class="sc-val teal" id="ds-month-comm">—</div><div class="sc-sub">Commission earned</div></div>
        <div class="stat-card"><div class="sc-label">Total Processed <span class="sc-icon">💳</span></div><div class="sc-val" id="ds-processed">—</div><div class="sc-sub">Platform lifetime</div></div>
        <div class="stat-card"><div class="sc-label">Live Sessions <span class="sc-icon">📡</span></div><div class="sc-val teal" id="ds-sessions">—</div><div class="sc-sub" id="ds-sessions-sub">—</div></div>
        <div class="stat-card"><div class="sc-label">Pending Review <span class="sc-icon">⏳</span></div><div class="sc-val amber" id="ds-pending">—</div><div class="sc-sub">Need attention</div></div>
        <div class="stat-card"><div class="sc-label">Today Transactions <span class="sc-icon">🔄</span></div><div class="sc-val" id="ds-today-tx">—</div><div class="sc-sub">Across all ISPs</div></div>
      </div>

      <div class="grid-2-1">
        <div class="panel">
          <div class="panel-head"><h3>Platform Revenue (30 days)</h3><span class="badge bt" id="chart-total-badge">—</span></div>
          <div class="panel-body"><canvas id="admin-revenue-chart" height="180"></canvas></div>
        </div>
        <div class="panel">
          <div class="panel-head"><h3>ISP Plans Split</h3></div>
          <div class="panel-body">
            <div class="donut-wrap">
              <canvas id="plans-donut" width="120" height="120" style="flex-shrink:0"></canvas>
              <div class="donut-legend">
                <div class="legend-item"><div class="legend-dot" style="background:#00d4aa"></div><div><div style="color:var(--white);font-weight:500">Hotspot</div><div id="hotspot-count" style="font-size:.8rem">— ISPs</div></div></div>
                <div class="legend-item"><div class="legend-dot" style="background:#f39c12"></div><div><div style="color:var(--white);font-weight:500">PPPoE</div><div id="pppoe-count" style="font-size:.8rem">— ISPs</div></div></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid-2">
        <div class="panel">
          <div class="panel-head"><h3>Recent ISP Signups</h3><button class="btn btn-outline btn-sm" onclick="showPage('isps')">View All</button></div>
          <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th>Joined</th><th></th></tr></thead><tbody id="dash-recent-isps"></tbody></table></div>
        </div>
        <div class="panel">
          <div class="panel-head"><h3>Recent Commissions</h3><button class="btn btn-outline btn-sm" onclick="showPage('commissions')">View All</button></div>
          <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>Amount</th><th>Rate</th><th>Date</th></tr></thead><tbody id="dash-recent-comm"></tbody></table></div>
        </div>
      </div>
    </div>

    <!-- ══ ALL ISPs ══ -->
    <div class="page" id="page-isps">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px">
        <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700">All ISPs</h2>
        <div class="filter-bar">
          <input type="text" id="isp-search" placeholder="Search name, email…" style="width:220px" oninput="loadISPs()"/>
          <select id="isp-status-filter" onchange="loadISPs()"><option value="">All Status</option><option value="active">Active</option><option value="pending">Pending</option><option value="suspended">Suspended</option><option value="cancelled">Cancelled</option></select>
          <select id="isp-plan-filter" onchange="loadISPs()"><option value="">All Plans</option><option value="hotspot">Hotspot</option><option value="pppoe">PPPoE</option></select>
          <button class="btn btn-outline btn-sm" onclick="loadISPs()">🔄 Refresh</button>
        </div>
      </div>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl">
          <thead><tr><th>Company</th><th>Owner</th><th>Email</th><th>Plan</th><th>Status</th><th>Devices</th><th>Revenue</th><th>Commission</th><th>Joined</th><th>Actions</th></tr></thead>
          <tbody id="isps-tbody"><tr><td colspan="10"><div class="loading"><div class="spinner"></div>Loading ISPs…</div></td></tr></tbody>
        </table></div>
        <div style="padding:12px 18px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border)">
          <span class="sc-sub" id="isp-count-label">—</span>
          <div style="display:flex;gap:8px">
            <button class="btn btn-outline btn-sm" onclick="ispPage--;loadISPs()">← Prev</button>
            <button class="btn btn-outline btn-sm" onclick="ispPage++;loadISPs()">Next →</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ PENDING ISPs ══ -->
    <div class="page" id="page-isp-pending">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:18px">Pending ISPs</h2>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Company</th><th>Owner</th><th>Email</th><th>Phone</th><th>Plan</th><th>Location</th><th>Registered</th><th>Actions</th></tr></thead><tbody id="pending-tbody"></tbody></table></div>
      </div>
    </div>

    <!-- ══ SUSPENDED ISPs ══ -->
    <div class="page" id="page-isp-suspended">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:18px">Suspended ISPs</h2>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Company</th><th>Plan</th><th>Email</th><th>Actions</th></tr></thead><tbody id="suspended-tbody"></tbody></table></div>
      </div>
    </div>

    <!-- ══ COMMISSIONS ══ -->
    <div class="page" id="page-commissions">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px">
        <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700">Commissions</h2>
        <div class="filter-bar">
          <select id="comm-month" onchange="loadCommissions()">
            <option value="">All Months</option>
            <option value="1">January</option><option value="2">February</option><option value="3">March</option><option value="4">April</option><option value="5">May</option><option value="6">June</option><option value="7">July</option><option value="8">August</option><option value="9">September</option><option value="10">October</option><option value="11">November</option><option value="12">December</option>
          </select>
          <select id="comm-year" onchange="loadCommissions()"><option value="">All Years</option><option value="2024">2024</option><option value="2025">2025</option></select>
        </div>
      </div>
      <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:18px">
        <div class="stat-card"><div class="sc-label">Total Commission</div><div class="sc-val amber" id="comm-total">—</div></div>
        <div class="stat-card"><div class="sc-label">Settled</div><div class="sc-val green" id="comm-settled">—</div></div>
        <div class="stat-card"><div class="sc-label">Pending</div><div class="sc-val amber" id="comm-pending-val">—</div></div>
      </div>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>Commission</th><th>Rate</th><th>Payment</th><th>Method</th><th>Settled</th><th>Date</th></tr></thead><tbody id="comm-tbody"></tbody></table></div>
      </div>
    </div>

    <!-- ══ PLATFORM INVOICES ══ -->
    <div class="page" id="page-platform-invoices">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:18px">Platform Invoices (PPPoE)</h2>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>Period</th><th>Users</th><th>Amount</th><th>Due</th><th>Status</th></tr></thead><tbody id="platform-inv-tbody"></tbody></table></div>
      </div>
    </div>

    <!-- ══ PAYOUTS ══ -->
    <div class="page" id="page-payouts">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:18px">Payouts</h2>
      <div class="panel">
        <div class="panel-body">
          <p style="color:var(--muted);font-size:.9rem">ISP wallet withdrawal requests and payout management will appear here. This section is used to manage when ISPs request withdrawal of their earned balance minus commissions.</p>
          <div style="margin-top:20px;padding:24px;background:rgba(0,212,170,.04);border:1px solid var(--border);border-radius:10px;text-align:center;color:var(--muted)">No pending payout requests.</div>
        </div>
      </div>
    </div>

    <!-- ══ LIVE SESSIONS ══ -->
    <div class="page" id="page-sessions">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
        <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700">Live Sessions</h2>
        <button class="btn btn-outline btn-sm" onclick="loadSessions()">🔄 Refresh</button>
      </div>
      <div class="grid-2">
        <div class="panel">
          <div class="panel-head"><h3>Hotspot Sessions</h3><span class="badge bg" id="hs-count">0</span></div>
          <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>MAC</th><th>IP</th><th>Voucher</th><th>Started</th></tr></thead><tbody id="hs-sessions-tbody"></tbody></table></div>
        </div>
        <div class="panel">
          <div class="panel-head"><h3>PPPoE Sessions</h3><span class="badge bg" id="pppoe-count-badge">0</span></div>
          <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>Username</th><th>IP</th><th>↓ DL</th><th>Started</th></tr></thead><tbody id="pppoe-sessions-tbody"></tbody></table></div>
        </div>
      </div>
    </div>

    <!-- ══ ALL DEVICES ══ -->
    <div class="page" id="page-devices">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:18px">All MikroTik Devices</h2>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>Name</th><th>Identity</th><th>IP</th><th>Status</th><th>Provisioned</th><th>Last Seen</th></tr></thead><tbody id="all-devices-tbody"></tbody></table></div>
      </div>
    </div>

    <!-- ══ NOTIFICATIONS ══ -->
    <div class="page" id="page-notifications">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
        <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700">Platform Notifications</h2>
        <button class="btn btn-outline btn-sm" onclick="loadAdminNotifications()">🔄 Refresh</button>
      </div>
      <div id="admin-notif-list"></div>
    </div>

    <!-- ══ SUPPORT ══ -->
    <div class="page" id="page-support">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:18px">Support Tickets</h2>
      <div class="panel">
        <div class="tbl-wrap"><table class="tbl"><thead><tr><th>ISP</th><th>Subject</th><th>Priority</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody id="admin-tickets-tbody"></tbody></table></div>
      </div>
    </div>

    <!-- ══ SETTINGS ══ -->

    <!-- ══ BILLING PAGE ══ -->
    <div class="page" id="page-billing">
      <div class="grid-2-1">
        <div>
          <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:4px">Charge ISPs — M-Pesa STK Push</h2>
          <p style="color:var(--muted);font-size:.82rem;margin-bottom:20px">Send payment requests directly to ISP phones for platform fees, PPPoE billing, or outstanding invoices.</p>

          <!-- Quick charge form -->
          <div class="card" style="margin-bottom:20px">
            <div style="font-size:.88rem;font-weight:600;margin-bottom:14px;color:var(--white)">⚡ Quick Charge</div>
            <div class="grid-2" style="gap:12px;margin-bottom:12px">
              <div>
                <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Select ISP</label>
                <select id="bill-isp-sel" style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none">
                  <option value="">Loading ISPs…</option>
                </select>
              </div>
              <div>
                <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Amount (KES)</label>
                <input type="number" id="bill-amount" placeholder="e.g. 3200" min="1"
                  style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none"/>
              </div>
            </div>
            <div class="grid-2" style="gap:12px;margin-bottom:12px">
              <div>
                <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Phone to Charge</label>
                <input type="tel" id="bill-phone" placeholder="0712345678" inputmode="tel"
                  style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none"/>
              </div>
              <div>
                <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Charge Type</label>
                <select id="bill-type" style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none">
                  <option value="pppoe_monthly">PPPoE Monthly Fee</option>
                  <option value="platform_fee">Platform Fee</option>
                  <option value="hotspot_commission">Hotspot Commission</option>
                  <option value="setup_fee">One-time Setup Fee</option>
                  <option value="custom">Custom Invoice</option>
                </select>
              </div>
            </div>
            <div style="margin-bottom:14px">
              <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Description / Invoice Note</label>
              <input type="text" id="bill-desc" placeholder="e.g. PPPoE billing for May 2026 — 100 users × KES 32"
                style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none"/>
            </div>
            <button class="btn btn-amber" style="width:100%;padding:12px;font-size:.9rem;font-weight:600" onclick="sendISPCharge()">
              📱 Send M-Pesa STK Push to ISP
            </button>
            <div id="bill-msg" style="display:none;margin-top:12px;padding:10px 12px;border-radius:8px;font-size:.84rem"></div>
          </div>

          <!-- Auto-bill PPPoE ISPs -->
          <div class="card" style="margin-bottom:20px">
            <div style="font-size:.88rem;font-weight:600;margin-bottom:4px;color:var(--white)">🔄 Auto-Bill PPPoE ISPs</div>
            <div style="font-size:.8rem;color:var(--muted);margin-bottom:14px">Generate and send monthly invoices for all active PPPoE ISPs based on their current subscriber count.</div>
            <div class="grid-2" style="gap:12px;margin-bottom:14px">
              <div>
                <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Month</label>
                <select id="autobill-month" style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none">
                  <option value="1">January</option><option value="2">February</option><option value="3">March</option>
                  <option value="4">April</option><option value="5">May</option><option value="6">June</option>
                  <option value="7">July</option><option value="8">August</option><option value="9">September</option>
                  <option value="10">October</option><option value="11">November</option><option value="12">December</option>
                </select>
              </div>
              <div>
                <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:5px">Year</label>
                <input type="number" id="autobill-year" value="2026" min="2024" max="2030"
                  style="width:100%;background:var(--mid);border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--white);font-size:.88rem;outline:none"/>
              </div>
            </div>
            <button class="btn btn-amber" style="padding:10px 20px;font-size:.86rem" onclick="autoBillPPPoE()">
              🧾 Generate & Send All PPPoE Invoices
            </button>
            <div id="autobill-msg" style="display:none;margin-top:10px;padding:10px;border-radius:8px;font-size:.82rem"></div>
          </div>
        </div>

        <!-- Right: Charge history -->
        <div>
          <div class="card">
            <div style="font-size:.88rem;font-weight:600;margin-bottom:14px;color:var(--white)">Recent Charges</div>
            <div class="tbl-wrap">
              <table class="tbl" style="font-size:.78rem">
                <thead><tr><th>ISP</th><th>Amount</th><th>Type</th><th>Status</th><th>Date</th></tr></thead>
                <tbody id="charge-history-tbody">
                  <tr><td colspan="5" style="text-align:center;color:var(--muted);padding:20px">Loading…</td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <div class="card" style="margin-top:16px">
            <div style="font-size:.88rem;font-weight:600;margin-bottom:12px;color:var(--white)">📊 Outstanding Invoices</div>
            <div id="outstanding-list" style="font-size:.82rem;color:var(--muted)">Loading…</div>
          </div>
        </div>
      </div>
    </div>

    <div class="page" id="page-settings">
      <h2 style="font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:20px">Platform Settings</h2>
      <div class="grid-2">
        <div class="panel">
          <div class="panel-head"><h3>Platform Commission Defaults</h3></div>
          <div class="panel-body">
            <div class="fg"><label>Default Hotspot Commission (%)</label><input type="number" id="set-hotspot-rate" value="3" step="0.1" min="0" max="100"/></div>
            <div class="fg"><label>PPPoE Rate per User (KES)</label><input type="number" id="set-pppoe-rate" value="32.25"/></div>
            <button class="btn btn-amber" onclick="saveSettings()">💾 Save Settings</button>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head"><h3>Admin Account</h3></div>
          <div class="panel-body">
            <div class="fg"><label>Admin Name</label><input type="text" id="set-admin-name"/></div>
            <div class="fg"><label>Email</label><input type="email" id="set-admin-email" readonly style="color:var(--muted)"/></div>
            <div class="fg"><label>New Password</label><input type="password" id="set-admin-pw" placeholder="Leave blank to keep current"/></div>
            <button class="btn btn-amber btn-sm" onclick="saveAdminProfile()">Update Profile</button>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /content -->
</div><!-- /main -->

<!-- ISP DETAIL SIDE PANEL -->
<div class="side-panel" id="isp-detail-panel">
  <div class="sp-head">
    <div>
      <div style="font-family:var(--font-head);font-size:1rem;font-weight:700" id="sp-isp-name">ISP Details</div>
      <div style="font-size:.78rem;color:var(--muted)" id="sp-isp-email">—</div>
    </div>
    <button class="sp-close" onclick="closeISPPanel()">✕</button>
  </div>
  <div class="sp-body">
    <div class="sp-section">
      <h4>Account Info</h4>
      <div class="sp-row"><span class="sp-key">Plan</span><span class="sp-val" id="sp-plan">—</span></div>
      <div class="sp-row"><span class="sp-key">Status</span><span class="sp-val" id="sp-status">—</span></div>
      <div class="sp-row"><span class="sp-key">Owner</span><span class="sp-val" id="sp-owner">—</span></div>
      <div class="sp-row"><span class="sp-key">Phone</span><span class="sp-val" id="sp-phone">—</span></div>
      <div class="sp-row"><span class="sp-key">Location</span><span class="sp-val" id="sp-location">—</span></div>
      <div class="sp-row"><span class="sp-key">Registered</span><span class="sp-val" id="sp-joined">—</span></div>
      <div class="sp-row"><span class="sp-key">Last Login</span><span class="sp-val" id="sp-last-login">—</span></div>
    </div>
    <div class="sp-section">
      <h4>Revenue & Billing</h4>
      <div class="sp-row"><span class="sp-key">Total Revenue</span><span class="sp-val teal" id="sp-revenue" style="color:var(--teal)">—</span></div>
      <div class="sp-row"><span class="sp-key">Commission Paid</span><span class="sp-val" id="sp-commission">—</span></div>
      <div class="sp-row"><span class="sp-key">Wallet Balance</span><span class="sp-val" id="sp-wallet">—</span></div>
    </div>
    <div class="sp-section">
      <h4>Infrastructure</h4>
      <div class="sp-row"><span class="sp-key">Devices</span><span class="sp-val" id="sp-devices">—</span></div>
      <div class="sp-row"><span class="sp-key">PPPoE Users</span><span class="sp-val" id="sp-pppoe-users">—</span></div>
      <div class="sp-row"><span class="sp-key">API Key</span><span class="sp-val" style="font-size:.75rem;font-family:monospace;word-break:break-all" id="sp-apikey">—</span></div>
    </div>
    <div class="sp-section">
      <h4>Actions</h4>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        <button class="btn btn-green btn-sm" id="sp-activate-btn" onclick="updateISPStatus(currentISPId,'active')">✅ Activate</button>
        <button class="btn btn-red btn-sm" id="sp-suspend-btn" onclick="updateISPStatus(currentISPId,'suspended')">🚫 Suspend</button>
        <button class="btn btn-outline btn-sm" onclick="updateISPStatus(currentISPId,'cancelled')">❌ Cancel</button>
      </div>
    </div>
    <div class="sp-section">
      <h4>Recent Payments</h4>
      <div class="tbl-wrap"><table class="tbl" style="font-size:.8rem"><thead><tr><th>Amount</th><th>Method</th><th>Status</th><th>Date</th></tr></thead><tbody id="sp-payments-tbody"></tbody></table></div>
    </div>
  </div>
</div>
<div id="sp-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:299" onclick="closeISPPanel()"></div>

<!-- Modals -->
<div class="modal-overlay" id="modal-note">
  <div class="modal">
    <h2>Send Notification to ISP</h2>
    <div class="modal-sub">This will appear in the ISP's notification panel.</div>
    <div class="fg"><label>Type</label><select id="note-type"><option value="info">ℹ️ Info</option><option value="success">✅ Success</option><option value="warning">⚠️ Warning</option><option value="error">❌ Alert</option></select></div>
    <div class="fg"><label>Title</label><input type="text" id="note-title" placeholder="e.g. Action Required"/></div>
    <div class="fg"><label>Message</label><textarea id="note-msg" rows="3" style="resize:vertical"></textarea></div>
    <div class="modal-actions"><button class="btn btn-outline" onclick="closeModal('modal-note')">Cancel</button><button class="btn btn-amber" onclick="sendNotification()">Send Notification</button></div>
  </div>
</div>

<div class="toast-container" id="toasts"></div>

<script>
const API = 'https://rumalinkenterprise.online/api';
let token = localStorage.getItem('rl_admin_token');
let admin = JSON.parse(localStorage.getItem('rl_admin') || '{}');
let ispPage = 1, currentISPId = null;
let revenueChart = null, donutChart = null;

if (!token) window.location.href = '/admin/login.html';

document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('sb-admin-name').textContent = admin.name || 'Admin';
  document.getElementById('admin-av').textContent = (admin.name||'A')[0].toUpperCase();
  document.querySelectorAll('.nav-item[data-page]').forEach(el => el.addEventListener('click', () => showPage(el.dataset.page)));
  loadDashboard();
});

function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const pg = document.getElementById('page-' + id);
  if (pg) pg.classList.add('active');
  const nv = document.querySelector(`.nav-item[data-page="${id}"]`);
  if (nv) nv.classList.add('active');
  const titles = {dashboard:'Dashboard',isps:'All ISPs','isp-pending':'Pending ISPs','isp-suspended':'Suspended ISPs',commissions:'Commissions','platform-invoices':'Platform Invoices',billing:'Charge ISPs',payouts:'Payouts',sessions:'Live Sessions',devices:'All Devices',notifications:'Notifications',support:'Support Tickets',settings:'Settings'};
  document.getElementById('page-title').textContent = titles[id] || id;
  const loaders = {isps:loadISPs,'isp-pending':loadPendingISPs,'isp-suspended':loadSuspendedISPs,commissions:loadCommissions,'platform-invoices':loadPlatformInvoices,billing:loadBilling,sessions:loadSessions,devices:loadAllDevices,notifications:loadAdminNotifications,support:loadAdminTickets,settings:loadAdminSettings};
  if (loaders[id]) loaders[id]();
}

async function apiFetch(path, opts = {}) {
  const res = await fetch(API + path, { ...opts, headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token, ...(opts.headers || {}) } });
  if (res.status === 401) { logout(); return; }
  const json = await res.json();
  if (!res.ok) throw new Error(json.error || 'API error');
  return json;
}

function logout() { localStorage.clear(); window.location.href = '/admin/login.html'; }

function toast(msg, type = 'success') {
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<span>${type === 'success' ? '✅' : '❌'}</span><span>${msg}</span>`;
  document.getElementById('toasts').appendChild(t);
  setTimeout(() => t.remove(), 4000);
}

function closeModal(id) { document.getElementById(id).classList.remove('open'); }
function openModal(id) { document.getElementById(id).classList.add('open'); }
document.querySelectorAll('.modal-overlay').forEach(o => o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); }));

const kes = v => `KES ${parseFloat(v || 0).toLocaleString('en-KE', { minimumFractionDigits: 2 })}`;
const dt = v => v ? new Date(v).toLocaleDateString('en-KE') : '—';
const dts = v => v ? new Date(v).toLocaleString('en-KE', { hour: '2-digit', minute: '2-digit', month: 'short', day: 'numeric' }) : '—';
const bytes = b => b > 1073741824 ? (b / 1073741824).toFixed(1) + ' GB' : b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : (b / 1024).toFixed(0) + ' KB';

// ── DASHBOARD ──
async function loadDashboard() {
  try {
    const d = await apiFetch('/admin/stats');
    const i = d.isps, r = d.revenue, s = d.sessions, dv = d.devices;
    document.getElementById('ds-total-isps').textContent = i.total || 0;
    document.getElementById('ds-new-isps').textContent = i.new_this_month || 0;
    document.getElementById('ds-active-isps').textContent = i.active || 0;
    document.getElementById('ds-total-comm').textContent = kes(r.total_commission);
    document.getElementById('ds-month-comm').textContent = kes(r.this_month_commission);
    document.getElementById('sb-commission').textContent = kes(r.total_commission);
    document.getElementById('ds-processed').textContent = kes(r.total_processed);
    document.getElementById('ds-sessions').textContent = (parseInt(s.active_hotspot) + parseInt(s.active_pppoe)) || 0;
    document.getElementById('ds-sessions-sub').textContent = `${s.active_hotspot || 0} hotspot · ${s.active_pppoe || 0} pppoe`;
    document.getElementById('ds-pending').textContent = i.pending || 0;
    document.getElementById('ds-today-tx').textContent = r.today_transactions || 0;

    // Donut chart
    const hc = parseInt(i.hotspot_isps) || 0, pc = parseInt(i.pppoe_isps) || 0;
    document.getElementById('hotspot-count').textContent = `${hc} ISPs`;
    document.getElementById('pppoe-count').textContent = `${pc} ISPs`;
    if (donutChart) donutChart.destroy();
    donutChart = new Chart(document.getElementById('plans-donut'), {
      type: 'doughnut',
      data: { labels: ['Hotspot', 'PPPoE'], datasets: [{ data: [hc || 1, pc || 0], backgroundColor: ['#00d4aa', '#f39c12'], borderWidth: 0, hoverOffset: 4 }] },
      options: { responsive: false, plugins: { legend: { display: false } }, cutout: '72%' }
    });
  } catch (e) { toast('Failed to load dashboard', 'error'); }

  // Revenue chart
  try {
    const d = await apiFetch('/admin/revenue-chart?period=30');
    const data = d.data || [];
    const labels = data.map(x => new Date(x.date).toLocaleDateString('en-KE', { month: 'short', day: 'numeric' }));
    const rev = data.map(x => parseFloat(x.total_revenue || 0));
    const comm = data.map(x => parseFloat(x.commission || 0));
    const total = rev.reduce((a, b) => a + b, 0);
    document.getElementById('chart-total-badge').textContent = kes(total);
    if (revenueChart) revenueChart.destroy();
    revenueChart = new Chart(document.getElementById('admin-revenue-chart'), {
      type: 'bar',
      data: {
        labels,
        datasets: [
          { label: 'Gross Revenue', data: rev, backgroundColor: 'rgba(0,212,170,.15)', borderColor: '#00d4aa', borderWidth: 1.5, borderRadius: 4 },
          { label: 'Commission', data: comm, backgroundColor: 'rgba(243,156,18,.2)', borderColor: '#f39c12', borderWidth: 1.5, borderRadius: 4 }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#7a8baa', font: { size: 11 } } } }, scales: { x: { grid: { color: 'rgba(255,255,255,.04)' }, ticks: { color: '#7a8baa', font: { size: 10 } } }, y: { grid: { color: 'rgba(255,255,255,.04)' }, ticks: { color: '#7a8baa', font: { size: 10 }, callback: v => 'KES ' + (v / 1000).toFixed(0) + 'k' } } } }
    });
  } catch (e) {}

  // Recent ISPs
  try {
    const d = await apiFetch('/admin/isps?limit=6');
    document.getElementById('dash-recent-isps').innerHTML = (d.isps || []).map(i => `
      <tr>
        <td class="name">${i.company_name}</td>
        <td><span class="badge ${i.plan_type === 'hotspot' ? 'bt' : 'ba'}">${i.plan_type}</span></td>
        <td><span class="badge ${i.status === 'active' ? 'bg' : i.status === 'pending' ? 'ba' : 'br'}">${i.status}</span></td>
        <td>${dt(i.created_at)}</td>
        <td><button class="btn btn-outline btn-sm" onclick="openISPPanel('${i.id}')">View</button></td>
      </tr>`).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:20px">No ISPs yet</td></tr>';
  } catch (e) {}

  // Recent commissions
  try {
    const d = await apiFetch('/admin/commissions');
    document.getElementById('dash-recent-comm').innerHTML = (d.commissions || []).slice(0, 6).map(c => `
      <tr>
        <td class="name">${c.company_name}</td>
        <td style="color:var(--amber);font-weight:600">${kes(c.amount)}</td>
        <td><span class="badge bm">${(parseFloat(c.rate) * 100).toFixed(1)}%</span></td>
        <td>${dt(c.created_at)}</td>
      </tr>`).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px">No commissions yet</td></tr>';
  } catch (e) {}
}

// ── ALL ISPs ──
async function loadISPs() {
  const search = document.getElementById('isp-search')?.value || '';
  const status = document.getElementById('isp-status-filter')?.value || '';
  const plan = document.getElementById('isp-plan-filter')?.value || '';
  const tbody = document.getElementById('isps-tbody');
  tbody.innerHTML = '<tr><td colspan="10"><div class="loading"><div class="spinner"></div>Loading…</div></td></tr>';
  try {
    const d = await apiFetch(`/admin/isps?page=${ispPage}&limit=20${search ? '&search=' + encodeURIComponent(search) : ''}${status ? '&status=' + status : ''}${plan ? '&plan_type=' + plan : ''}`);
    document.getElementById('isp-count-label').textContent = `${d.pagination?.total || 0} ISPs total`;
    tbody.innerHTML = (d.isps || []).map(i => `
      <tr>
        <td class="name" style="cursor:pointer" onclick="openISPPanel('${i.id}')">${i.company_name}</td>
        <td style="color:var(--muted);font-size:.82rem">${i.owner_name}</td>
        <td style="color:var(--muted);font-size:.82rem">${i.email}</td>
        <td><span class="badge ${i.plan_type === 'hotspot' ? 'bt' : 'ba'}">${i.plan_type}</span></td>
        <td><span class="badge ${i.status === 'active' ? 'bg' : i.status === 'pending' ? 'ba' : 'br'}">${i.status}</span></td>
        <td>${i.device_count || 0}</td>
        <td style="color:var(--teal);font-weight:500">${kes(i.total_commission)}</td>
        <td style="color:var(--amber)">${kes(i.total_commission)}</td>
        <td>${dt(i.created_at)}</td>
        <td style="white-space:nowrap">
          <button class="btn btn-outline btn-sm" onclick="openISPPanel('${i.id}')">Details</button>
          <button class="btn btn-sm ${i.status === 'active' ? 'btn-red' : 'btn-green'}" onclick="updateISPStatus('${i.id}','${i.status === 'active' ? 'suspended' : 'active'}')">
            ${i.status === 'active' ? 'Suspend' : 'Activate'}
          </button>
        </td>
      </tr>`).join('') || '<tr><td colspan="10" style="text-align:center;color:var(--muted);padding:24px">No ISPs found</td></tr>';
  } catch (e) { toast('Failed to load ISPs', 'error'); }
}

async function loadPendingISPs() {
  try {
    const d = await apiFetch('/admin/isps?status=pending&limit=50');
    document.getElementById('pending-tbody').innerHTML = (d.isps || []).map(i => `
      <tr>
        <td class="name">${i.company_name}</td>
        <td>${i.owner_name}</td>
        <td>${i.email}</td>
        <td>${i.phone}</td>
        <td><span class="badge ${i.plan_type === 'hotspot' ? 'bt' : 'ba'}">${i.plan_type}</span></td>
        <td>${[i.county, i.town].filter(Boolean).join(', ') || '—'}</td>
        <td>${dt(i.created_at)}</td>
        <td><button class="btn btn-green btn-sm" onclick="updateISPStatus('${i.id}','active')">✅ Activate</button></td>
      </tr>`).join('') || '<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:24px">No pending ISPs 🎉</td></tr>';
  } catch (e) {}
}

async function loadSuspendedISPs() {
  try {
    const d = await apiFetch('/admin/isps?status=suspended&limit=50');
    document.getElementById('suspended-tbody').innerHTML = (d.isps || []).map(i => `
      <tr>
        <td class="name">${i.company_name}</td>
        <td><span class="badge ${i.plan_type === 'hotspot' ? 'bt' : 'ba'}">${i.plan_type}</span></td>
        <td>${i.email}</td>
        <td><button class="btn btn-green btn-sm" onclick="updateISPStatus('${i.id}','active')">Reactivate</button></td>
      </tr>`).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:24px">No suspended ISPs</td></tr>';
