  document.getElementById('set-admin-name').value = admin.name || '';
  document.getElementById('set-admin-email').value = admin.email || '';
}

function saveSettings() { toast('Settings saved!'); }
function saveAdminProfile() { toast('Profile updated!'); }

// ── NOTIFY ISP ──
let notifyISPId = null;
function openNotifyModal(id) { notifyISPId = id; openModal('modal-note'); }
async function sendNotification() {
  if (!notifyISPId) return;
  try {
    // This would call a dedicated admin notification endpoint
    toast('Notification sent to ISP');
    closeModal('modal-note');
  } catch (e) { toast(e.message, 'error'); }
}

// Auto-refresh dashboard every 30s
setInterval(() => {
  const active = document.querySelector('.page.active');
  if (active?.id === 'page-dashboard') loadDashboard();
  if (active?.id === 'page-sessions') loadSessions();
}, 30000);

// ── SIDEBAR TOGGLE ────────────────────────────────────────────
function toggleSidebar(){
  const sb = document.querySelector('.sidebar');
  const ov = document.getElementById('sidebar-overlay');
  const open = sb.classList.toggle('open');
  ov.classList.toggle('open', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', () => {
    if(window.innerWidth <= 900){
      document.querySelector('.sidebar').classList.remove('open');
      document.getElementById('sidebar-overlay').classList.remove('open');
      document.body.style.overflow = '';
    }
  });
});

// ── BILLING PAGE ──────────────────────────────────────────────
async function loadBilling() {
  await Promise.all([loadISPsForBilling(), loadChargeHistory(), loadOutstanding()]);
  // Set current month/year
  const now = new Date();
  document.getElementById('autobill-month').value = now.getMonth() + 1;
  document.getElementById('autobill-year').value = now.getFullYear();
}

async function loadISPsForBilling() {
  try {
    const d = await apiFetch('/admin/isps?limit=200&status=active');
    const sel = document.getElementById('bill-isp-sel');
    sel.innerHTML = '<option value="">— Select ISP —</option>' +
      (d.isps || []).map(i =>
        `<option value="${i.id}" data-phone="${i.phone}" data-name="${i.company_name}" data-pppoe="${i.active_pppoe_users||0}">
          ${i.company_name} (${i.plan_type}) — ${i.phone}
        </option>`
      ).join('');
    // Auto-fill phone when ISP selected
    sel.onchange = function(){
      const opt = sel.options[sel.selectedIndex];
      if(opt && opt.dataset.phone) {
        document.getElementById('bill-phone').value = opt.dataset.phone;
        // Auto-calculate PPPoE amount
        if(document.getElementById('bill-type').value === 'pppoe_monthly' && opt.dataset.pppoe > 0){
          document.getElementById('bill-amount').value = parseInt(opt.dataset.pppoe) * 32;
          document.getElementById('bill-desc').value = `PPPoE monthly fee — ${opt.dataset.pppoe} subscribers × KES 32`;
        }
      }
    };
    document.getElementById('bill-type').onchange = function(){
      const opt = sel.options[sel.selectedIndex];
      if(!opt || !opt.dataset.pppoe) return;
      if(this.value === 'pppoe_monthly' && opt.dataset.pppoe > 0){
        document.getElementById('bill-amount').value = parseInt(opt.dataset.pppoe) * 32;
        document.getElementById('bill-desc').value = `PPPoE monthly fee — ${opt.dataset.pppoe} subscribers × KES 32`;
      }
    };
  } catch(e) { console.error(e); }
}

async function sendISPCharge() {
  const ispId = document.getElementById('bill-isp-sel').value;
  const amount = parseFloat(document.getElementById('bill-amount').value);
  const phone = document.getElementById('bill-phone').value.trim();
  const type = document.getElementById('bill-type').value;
  const desc = document.getElementById('bill-desc').value.trim();
  const msgEl = document.getElementById('bill-msg');

  if(!ispId){ showMsg2(msgEl,'Select an ISP','error'); return; }
  if(!amount || amount < 1){ showMsg2(msgEl,'Enter a valid amount','error'); return; }
  if(!phone){ showMsg2(msgEl,'Enter a phone number','error'); return; }

  const btn = event.target;
  btn.disabled = true; btn.textContent = '⏳ Sending STK Push…';

  try {
    const res = await apiFetch('/admin/billing/charge', { method:'POST',
      body: JSON.stringify({ isp_id: ispId, amount, phone, charge_type: type, description: desc || `Platform charge — ${type}` })
    });
    showMsg2(msgEl, `✅ STK Push sent to ${phone}! Payment ID: ${res.payment_id||''}. ISP will receive M-Pesa prompt.`, 'success');
    loadChargeHistory();
  } catch(e) {
    showMsg2(msgEl, '❌ ' + e.message, 'error');
  }
  btn.disabled = false; btn.textContent = '📱 Send M-Pesa STK Push to ISP';
}

async function autoBillPPPoE() {
  const month = parseInt(document.getElementById('autobill-month').value);
  const year = parseInt(document.getElementById('autobill-year').value);
  const msgEl = document.getElementById('autobill-msg');
  const btn = event.target;
  btn.disabled = true; btn.textContent = '⏳ Generating invoices…';
  try {
    const res = await apiFetch('/admin/billing/auto-bill-pppoe', { method:'POST',
      body: JSON.stringify({ month, year })
    });
    showMsg2(msgEl, `✅ ${res.message || 'Invoices generated'} — ${res.count||0} ISPs billed.`, 'success');
    loadChargeHistory();
    loadOutstanding();
  } catch(e) {
    showMsg2(msgEl, '❌ ' + e.message, 'error');
  }
  btn.disabled = false; btn.textContent = '🧾 Generate & Send All PPPoE Invoices';
}

async function loadChargeHistory() {
  try {
    const d = await apiFetch('/admin/billing/charges?limit=30');
    const tbody = document.getElementById('charge-history-tbody');
    tbody.innerHTML = (d.charges||[]).map(ch => `
      <tr>
        <td class="name">${ch.company_name||'—'}</td>
        <td style="color:var(--amber);font-weight:600">${kes(ch.amount)}</td>
        <td style="color:var(--muted);font-size:.74rem">${(ch.charge_type||ch.description||'').replace(/_/g,' ')}</td>
        <td><span class="badge ${ch.status==='paid'?'bg':ch.status==='pending'?'ba':'br'}">${ch.status}</span></td>
        <td style="color:var(--muted)">${dt(ch.created_at)}</td>
      </tr>`).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:20px">No charges yet</td></tr>';
  } catch(e) {}
}

async function loadOutstanding() {
  try {
    const d = await apiFetch('/admin/billing/outstanding');
    const el = document.getElementById('outstanding-list');
    if(!d.outstanding?.length){ el.innerHTML = '<p style="color:var(--muted)">No outstanding invoices 🎉</p>'; return; }
    el.innerHTML = d.outstanding.map(o => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--border)">
        <div>
          <div style="color:var(--white);font-size:.84rem">${o.company_name}</div>
          <div style="color:var(--muted);font-size:.74rem">${o.plan_type} · ${o.overdue_days||0}d overdue</div>
        </div>
        <div style="text-align:right">
          <div style="color:var(--amber);font-weight:600;font-size:.86rem">${kes(o.outstanding_amount)}</div>
          <button onclick="quickCharge('${o.isp_id}','${o.phone}',${o.outstanding_amount})" 
            style="font-size:.7rem;color:var(--teal);background:none;border:none;cursor:pointer;padding:0;font-family:inherit">Charge now →</button>
        </div>
      </div>`).join('');
  } catch(e) {}
}

function quickCharge(ispId, phone, amount) {
  document.getElementById('bill-isp-sel').value = ispId;
  document.getElementById('bill-phone').value = phone;
  document.getElementById('bill-amount').value = amount;
  showPage('billing');
}

function showMsg2(el, msg, type) {
  el.textContent = msg;
  el.style.display = 'block';
  el.style.background = type==='success' ? 'rgba(0,212,170,.1)' : type==='error' ? 'rgba(231,76,60,.1)' : 'rgba(243,156,18,.1)';
  el.style.color = type==='success' ? 'var(--teal)' : type==='error' ? 'var(--red)' : 'var(--amber)';
  el.style.border = '1px solid ' + (type==='success' ? 'rgba(0,212,170,.25)' : type==='error' ? 'rgba(231,76,60,.25)' : 'rgba(243,156,18,.25)');
}
</script>
<div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>

<!-- Payment spinner widget -->
<div id="rml-spinner-include"></div>
<script>
fetch('/captive/payment-spinner.html').then(r => r.text()).then(html => {
  document.getElementById('rml-spinner-include').innerHTML = html;
  document.querySelectorAll('#rml-spinner-include script').forEach(s => {
    var n = document.createElement('script');
    n.textContent = s.textContent;
    document.body.appendChild(n);
  });
});
// Hook billing charge to show spinner
(function(){
  var origFetch = window.fetch;
  window.fetch = function(url, opts) {
    var prom = origFetch.apply(this, arguments);
    if (typeof url === 'string' && url.indexOf('/billing/charge') > -1 && opts && opts.method === 'POST') {
      prom.then(r => r.clone().json()).then(data => {
        if (data && data.payment_id && typeof rumalinkShowPaymentSpinner === 'function') {
          var body = {};
          try { body = JSON.parse(opts.body || '{}'); } catch(e){}
          rumalinkShowPaymentSpinner({
            phone: body.phone,
            amount: body.amount,
            paymentId: data.payment_id,
            statusUrl: '/api/admin/billing/status/' + data.payment_id,
            onSuccess: function() { if (typeof loadChargeHistory==='function') loadChargeHistory(); }
          });
        }
      }).catch(()=>{});
    }
    return prom;
  };
})();
</script>
</body>
</html>
