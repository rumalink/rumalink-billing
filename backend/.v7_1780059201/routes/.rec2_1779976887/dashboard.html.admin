// ── SESSIONS ──
async function loadSessions() {
  try {
    const d = await apiFetch('/admin/sessions');
    document.getElementById('hs-count').textContent = d.hotspot?.length || 0;
    document.getElementById('pppoe-count-badge').textContent = d.pppoe?.length || 0;
    document.getElementById('hs-sessions-tbody').innerHTML = (d.hotspot || []).map(s => `
      <tr><td class="name">${s.company_name}</td><td style="font-family:monospace;font-size:.8rem">${s.mac_address || '—'}</td><td>${s.ip_address || '—'}</td><td style="font-family:monospace">${s.voucher_code || '—'}</td><td>${dts(s.started_at)}</td></tr>`).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:20px">No active hotspot sessions</td></tr>';
    document.getElementById('pppoe-sessions-tbody').innerHTML = (d.pppoe || []).map(s => `
      <tr><td class="name">${s.company_name}</td><td style="font-family:monospace">${s.username}</td><td>${s.framed_ip || '—'}</td><td>${bytes(s.bytes_downloaded)}</td><td>${dts(s.started_at)}</td></tr>`).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:20px">No active PPPoE sessions</td></tr>';
  } catch (e) {}
}

// ── ALL DEVICES ──
async function loadAllDevices() {
  try {
    const isps = await apiFetch('/admin/isps?limit=200');
    const rows = [];
    for (const isp of isps.isps || []) {
      // We'll just show ISP list with device count for now (full device listing would need a new admin endpoint)
      if (parseInt(isp.device_count) > 0) {
        rows.push(`<tr><td class="name">${isp.company_name}</td><td colspan="6" style="color:var(--muted)">${isp.device_count} device(s) — click to view details</td></tr>`);
      }
    }
    document.getElementById('all-devices-tbody').innerHTML = rows.join('') || '<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:24px">No devices provisioned yet</td></tr>';
  } catch (e) {}
}

// ── NOTIFICATIONS ──
async function loadAdminNotifications() {
  try {
    const d = await apiFetch('/admin/notifications');
    const list = document.getElementById('admin-notif-list');
    document.getElementById('notif-dot').style.display = d.notifications?.some(n => !n.is_read) ? '' : 'none';
    list.innerHTML = (d.notifications || []).map(n => `
      <div style="background:var(--card);border:1px solid ${n.is_read ? 'var(--border)' : 'rgba(243,156,18,.2)'};border-radius:10px;padding:15px 18px;margin-bottom:10px;display:flex;align-items:flex-start;gap:12px">
        <span style="font-size:1.1rem">${n.type === 'success' ? '✅' : n.type === 'warning' ? '⚠️' : n.type === 'error' ? '❌' : 'ℹ️'}</span>
        <div style="flex:1">
          <div style="font-weight:500;font-size:.88rem;${n.is_read ? 'color:var(--muted)' : ''}">${n.title}</div>
          <div style="color:var(--muted);font-size:.82rem;margin-top:4px;font-weight:300">${n.message}</div>
          <div style="font-size:.72rem;color:var(--border);margin-top:5px">${dts(n.created_at)}</div>
        </div>
      </div>`).join('') || '<div style="text-align:center;color:var(--muted);padding:40px">No notifications</div>';
  } catch (e) {}
}

